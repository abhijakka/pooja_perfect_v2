# ── Database ──────────────────────────────────────────────
# PostgreSQL connection string (psycopg driver)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

# SQLite is used automatically when APP_ENV=test or when the pytest suite
# sets APP_ENV to test. Keep a separate SQL URL for production and another
# for test-only local runs.
TEST_DATABASE_URL=sqlite://
APP_ENV=development

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET_KEY=replace-with-a-random-access-secret-at-least-32-chars
JWT_REFRESH_SECRET_KEY=replace-with-a-random-refresh-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── CORS ────────────────────────────────────────────────────
# Comma-separated origins allowed to call this API from a browser. Add your own
# LAN IP (e.g. http://192.168.1.50:3000) to sign in from a phone, and the matching
# host to NEXT_PUBLIC_ALLOWED_DEV_ORIGINS in frontend/.env.local. No trailing
# slash, and "*" is rejected because auth cookies are sent with credentials.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.34:3000

# ── Google OAuth ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ── Cloudinary ──────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=dkct2mnru
CLOUDINARY_API_KEY=262822241168473
CLOUDINARY_API_SECRET=H43ctVRVAUPP8mbeuyxsmHi6sB8


