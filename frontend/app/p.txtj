:root {
	--blush: #f7d5df;
	--blush-light: #fff7f8;
	--rose: #d5537d;
	--rose-dark: #8f3658;
	--deep: #4a2734;
	--muted: #756b70;
	--gold: #c8943d;
	--green: #4c8b65;
	--border: #eadde2;
	--shadow: 0 14px 38px rgba(74, 39, 52, .1);
	--shadow-soft: 0 8px 24px rgba(74, 39, 52, .07);
}

* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
html { scroll-behavior: smooth; background: #fffdfb; -webkit-tap-highlight-color: transparent; }
body {
	margin: 0;
	color: #2e282c;
	background: radial-gradient(circle at 0 0, rgba(246, 207, 220, .24), transparent 23%), radial-gradient(circle at 100% 12%, rgba(243, 226, 191, .16), transparent 19%), #fffdfb;
	font-family: Georgia, serif;
	-webkit-font-smoothing: antialiased;
	overflow-x: hidden;
	-webkit-tap-highlight-color: transparent;
}
button, input, select { font: inherit; }
button { border: 0; cursor: pointer; -webkit-tap-highlight-color: transparent; }
a { color: inherit; text-decoration: none; -webkit-tap-highlight-color: transparent; }

/* ── Premium interaction system: kill default blue, keep elegant warm focus ── */
*::selection { background: #f7d5df; color: var(--deep); }
*::-moz-selection { background: #f7d5df; color: var(--deep); }
a, button, input, select, textarea, [role="button"], [tabindex] { -webkit-tap-highlight-color: transparent; }
*:focus { outline: none; }
/* pointer focus (mouse/touch) — no blue ring, no ugly outline */
:focus:not(:focus-visible) { outline: none !important; box-shadow: none !important; }
/* keyboard-only premium warm ring — always visible for keyboard users */
:focus-visible { outline: 2px solid rgba(213, 83, 125, .55) !important; outline-offset: 2px !important; }
/* inputs/selects: warm brand border on ANY focus (mouse or keyboard), never blue */
input:focus, select:focus, textarea:focus { border-color: #df99b1 !important; box-shadow: 0 0 0 4px rgba(213, 83, 125, .10) !important; outline: none !important; }
/* subtle press feedback instead of blue flash */
button, a { transition: transform .14s ease, filter .14s ease, box-shadow .14s ease, background-color .14s ease, border-color .14s ease; }
button:active:not(:disabled), a:active, [role="button"]:active { transform: scale(.97); filter: brightness(.98); }
@media (prefers-reduced-motion: reduce) {
	button:active, a:active { transform: none; filter: none; }
}
.icon { width: 1em; height: 1em; display: block; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
.search-suggestions { position: absolute; top: calc(100% + 9px); left: 0; right: 0; z-index: 9000; overflow: hidden; background: #fff; border: 1px solid var(--border); border-radius: 16px; box-shadow: 0 18px 48px rgba(74,39,52,.16); }
.search-suggestions__head { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 10px 13px; background: #fffafb; border-bottom: 1px solid var(--border); font: 9px Arial, sans-serif; }
.search-suggestion { width: 100%; display: flex; align-items: center; gap: 10px; padding: 9px 11px; background: #fff; border-bottom: 1px solid #f3eaed; text-align: left; }
.search-suggestion:last-child { border-bottom: 0; }
.search-suggestion:hover { background: #fff4f7; }
.search-suggestion-image { width: 49px; height: 49px; flex: 0 0 49px; overflow: hidden; background: linear-gradient(145deg,#fff3f6,#f5ded8); border-radius: 11px; }
.search-suggestion-image img { width: 100%; height: 100%; display: block; object-fit: cover; }
.search-suggestion-info { min-width: 0; flex: 1; }
.search-suggestion-name { display: block; overflow: hidden; color: var(--deep); font: 800 10px/1.3 Arial, sans-serif; white-space: nowrap; text-overflow: ellipsis; }
.search-suggestion-meta { display: flex; align-items: center; gap: 6px; margin-top: 4px; overflow: hidden; color: var(--muted); font: 7.5px Arial, sans-serif; white-space: nowrap; }
.search-suggestion-price { color: var(--rose-dark); }
.search-view-button { flex: 0 0 auto; padding: 7px 10px; color: var(--rose-dark); background: #fff3f6; border: 1px solid #edd6df; border-radius: 9px; font: 900 7.5px Arial, sans-serif; }

@keyframes pp-logo { from { opacity: 0; transform: translateY(15px) scale(.95); } to { opacity: 1; transform: translateY(0) scale(1); } }
@keyframes pp-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
@keyframes pp-text { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
@keyframes pp-progress { 0% { transform: translateX(-130%); } 50% { transform: translateX(120%); } 100% { transform: translateX(300%); } }
.pp-loader { position: fixed; inset: 0; z-index: 99999; display: flex; align-items: center; justify-content: center; background: radial-gradient(circle at 50% 40%, #fff 0, #fff7f9 40%, #f7d5df 100%); }
.pp-loader-content { width: 90%; max-width: 360px; text-align: center; }
.pp-loader-logo { color: var(--deep); font-size: 43px; font-weight: 700; letter-spacing: -1.5px; animation: pp-logo .8s ease both; }
.pp-loader-logo span { color: var(--rose); }
.pp-loader-symbol { position: relative; width: 82px; height: 82px; display: flex; align-items: center; justify-content: center; margin: 28px auto 0; color: var(--gold); background: radial-gradient(circle, #fff 0, #fff5f7 50%, #f7d5df 100%); border-radius: 50%; box-shadow: 0 12px 35px rgba(74,39,52,.12); animation: pp-float 2s ease-in-out infinite; }
.pp-loader-ring { position: absolute; width: 104px; height: 104px; border: 2px solid transparent; border-top-color: var(--rose); border-right-color: var(--gold); border-radius: 50%; animation: spin 1s linear infinite; }
.pp-loader-symbol > span { position: relative; z-index: 1; font: 38px Arial, sans-serif; }
.pp-loader-text { margin-top: 28px; color: #6a3a4d; font: 700 11px Arial, sans-serif; letter-spacing: 1.4px; text-transform: uppercase; animation: pp-text .8s .2s ease both; }
.pp-loader-track { width: 155px; height: 3px; overflow: hidden; margin: 16px auto 0; background: rgba(213,83,125,.14); border-radius: 999px; }
.pp-loader-track span { display: block; width: 45%; height: 100%; background: linear-gradient(90deg, var(--gold), var(--rose), var(--gold)); border-radius: 999px; animation: pp-progress 1.2s ease-in-out infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

.top-bar { padding: 9px 15px; color: #fff; background: linear-gradient(90deg, #432430, #5a3043 45%, #432430); text-align: center; font: 600 12px Arial, sans-serif; }
.navbar { position: sticky; top: 0; z-index: 1000; min-height: 74px; display: flex; align-items: center; gap: 22px; padding: 12px clamp(20px, 4vw, 30px) 12px 25px; background: rgba(255, 255, 255, .94); border-bottom: 1px solid var(--border); box-shadow: 0 4px 24px rgba(72, 39, 53, .035); backdrop-filter: blur(15px); }
.logo { white-space: nowrap; color: var(--deep); font-size: 27px; font-weight: 700; }
.logo span { color: var(--rose); }
.search-box { position: relative; flex: 1; max-width: 680px; margin: auto; }
.search-box input { width: 100%; height: 46px; padding: 0 52px 0 18px; color: #2e282c; background: #fffafc; border: 1px solid var(--border); border-radius: 25px; outline: 0; }
.search-box input:focus { border-color: #df99b1; box-shadow: 0 0 0 4px rgba(214, 83, 125, .08); }
.search-button { position: absolute; top: 5px; right: 5px; width: 36px; height: 36px; display: grid; place-items: center; color: var(--deep); background: linear-gradient(145deg, #f7d5df, #efbdcb); border-radius: 50%; }
.nav-actions { display: flex; gap: 7px; }
.icon-button { position: relative; width: 42px; height: 42px; display: grid; place-items: center; color: #5a3042; background: #fff7f9; border: 1px solid rgba(234, 223, 227, .82); border-radius: 50%; box-shadow: var(--shadow-soft); }
.icon-button:hover { background: var(--blush); transform: translateY(-1px); }
.badge, .mobile-bottom-nav-badge { position: absolute; min-width: 17px; height: 17px; display: grid; place-items: center; padding: 0 4px; color: #fff; background: var(--rose); border-radius: 20px; font: 700 9px Arial, sans-serif; }
.badge { top: -2px; right: -1px; }
.category-nav { position: sticky; top: 74px; z-index: 999; display: flex; gap: 0; padding: 0 48px 0 10px; overflow-x: auto; white-space: nowrap; background: rgba(255, 255, 255, .96); border-bottom: 1px solid var(--border); scrollbar-width: none; }
.category-nav::-webkit-scrollbar { display: none; }
.category-nav a { position: relative; flex: 0 0 auto; min-height: 48px; display: inline-flex; align-items: center; padding: 0 18px; color: #5e5258; font: 500 14px Arial, sans-serif; }
.category-nav a:hover { color: var(--rose-dark); }
.category-nav a::after { content: ""; position: absolute; right: 18px; bottom: 4px; left: 18px; height: 2px; background: var(--rose); transform: scaleX(0); transition: transform .2s ease; }
.category-nav a:hover::after { transform: scaleX(1); }

.hero, .section { width: min(1400px, calc(100% - 44px)); margin: 24px auto 58px; }
.hero-card { min-height: 440px; display: grid; grid-template-columns: 1.05fr .95fr; overflow: hidden; background: linear-gradient(125deg, #fff5f7, #f8dae2 52%, #f4e5d1); border: 1px solid rgba(255, 255, 255, .8); border-radius: 32px; box-shadow: 0 24px 70px rgba(72, 39, 53, .13); perspective: 1200px; transform-style: preserve-3d; }
.hero-content { align-self: center; padding: 70px clamp(30px, 6vw, 90px); }
.eyebrow, .subscription-eyebrow { color: #c94770; font: 800 12px Arial, sans-serif; letter-spacing: 2px; text-transform: uppercase; }
.hero h1 { max-width: 650px; margin: 14px 0; color: var(--deep); font-size: clamp(40px, 5vw, 72px); line-height: 1.02; }
.hero p { max-width: 540px; color: #665a60; font: 15px/1.7 Arial, sans-serif; }
.primary-button { margin-top: 22px; padding: 14px 24px; color: #fff; background: linear-gradient(135deg, #492633, #62394b); border-radius: 28px; box-shadow: 0 10px 24px rgba(72, 39, 53, .16); }
.hero-art { min-height: 440px; display: grid; place-items: center; overflow: hidden; background: radial-gradient(circle at 50% 38%, rgba(255,255,255,.82) 0 21%, transparent 43%), linear-gradient(145deg, #f5dfe4, #f3e2c3); }
.hero-product-photo { width: min(88%, 580px); height: 380px; display: block; object-fit: cover; border-radius: 26px; box-shadow: 0 22px 42px rgba(77, 41, 56, .16); transform: perspective(1000px) rotateY(-6deg) rotateX(4deg) translateZ(0); transition: transform .55s cubic-bezier(.25,.46,.45,.94), box-shadow .4s ease; transform-style: preserve-3d; }
.hero-card:hover .hero-product-photo { transform: perspective(1000px) rotateY(-3deg) rotateX(2deg) translateZ(28px); box-shadow: 0 30px 60px rgba(77, 41, 56, .22), 0 8px 18px rgba(77, 41, 56, .12); }
.section-header { display: flex; justify-content: space-between; align-items: end; margin-bottom: 22px; }
.section-title { color: var(--deep); font-size: 30px; }
.section-link { color: var(--rose); font: 700 13px Arial, sans-serif; }
.category-grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 13px; }
.category-card, .product-card, .trust-card, .plan { position: relative; overflow: hidden; background: linear-gradient(180deg, #fff, #fffafa); border: 1px solid var(--border); box-shadow: var(--shadow-soft); transform-style: preserve-3d; transition: transform .3s cubic-bezier(.25,.46,.45,.94), box-shadow .3s ease; }
.category-card { padding: 22px 10px; text-align: center; border-radius: 20px; }
.category-card:hover, .plan:hover { transform: perspective(900px) rotateX(3deg) rotateY(-4deg) translateY(-7px) scale(1.02); box-shadow: 0 22px 45px rgba(74, 39, 52, .16), 0 6px 14px rgba(74, 39, 52, .08); }
.category-card:hover .category-icon { transform: translateZ(26px) rotateY(10deg) scale(1.06); }
.trust-card:hover { transform: perspective(900px) rotateX(-4deg) translateY(-6px); box-shadow: 0 20px 42px rgba(74, 39, 52, .14); }
.trust-card:hover .trust-icon { transform: translateZ(22px) scale(1.12); display: inline-block; }
.category-icon { width: 60px; height: 60px; display: grid; place-items: center; margin: auto; color: var(--gold); background: linear-gradient(145deg, #fff1f4, #faead9); border-radius: 19px; }
.category-icon .icon { width: 30px; height: 30px; }
.category-card strong { display: block; margin-top: 12px; font: 650 13px Arial, sans-serif; }
.category-card small { display: block; margin-top: 4px; color: var(--muted); font: 11px Arial, sans-serif; }
.toolbar { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 18px; }
.filter-btn { padding: 9px 14px; color: var(--deep); background: #fff; border: 1px solid var(--border); border-radius: 20px; font: 12px Arial, sans-serif; }
.filter-btn.active, .filter-btn:hover { background: #fae5eb; border-color: #efc4d2; }
.product-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 17px; }
.product-card { padding: 10px; border-radius: 23px; transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)); transition: transform .25s cubic-bezier(.25,.46,.45,.94), box-shadow .25s ease; }
.product-image { position: relative; height: 235px; overflow: hidden; display: grid; place-items: center; background: linear-gradient(145deg, #fff1f4, #f3e4cf); border-radius: 18px; }
.product-photo { width: 100%; height: 100%; object-fit: cover; transition: transform .45s ease; }
.product-card:hover .product-photo { transform: scale(1.045); }
/* Single wishlist heart — shared by card (.wishlist-button) and PDP (.gallery-wishlist). Sizes/positions only differ below. */
.wishlist-button, .gallery-wishlist { position: absolute; z-index: 2; display: grid; place-items: center; color: var(--rose); background: rgba(255,255,255,.97); border: 1px solid var(--border); border-radius: 50%; box-shadow: 0 6px 14px rgba(72,39,53,.09); }
.wishlist-button { top: 12px; right: 12px; width: 36px; height: 36px; }
.gallery-wishlist { top: 18px; right: 18px; width: 44px; height: 44px; }
.wishlist-button.active, .gallery-wishlist.active { background: #fff0f4; color: var(--rose-dark); }
.wishlist-button.active .icon, .gallery-wishlist.active .icon { fill: currentColor; }
.product-view-button { position: absolute; right: 10px; bottom: 10px; left: 10px; padding: 8px; color: var(--deep); background: rgba(255,255,255,.9); border-radius: 9px; text-align: center; opacity: 0; font: 700 10px Arial, sans-serif; transition: opacity .2s ease; }
.product-card:hover .product-view-button { opacity: 1; }
.product-info { padding: 4px 5px 2px; font-family: Arial, sans-serif; }
.product-title { margin: 10px 0 0; color: var(--deep); font-size: 15px; }
.rating { margin-top: 7px; color: #bd873f; font-size: 11px; letter-spacing: 1px; }
.rating span { color: var(--muted); letter-spacing: 0; }
.price { margin-top: 8px; color: var(--deep); font-size: 17px; font-weight: 800; }
.old-price { margin-left: 5px; color: #a69a9f; font-size: 11px; font-weight: 400; }
.add-cart, .checkout { width: 100%; margin-top: 11px; padding: 11px; color: #fff; background: linear-gradient(145deg, #4a2734, #6a3a4d); border-radius: 13px; font-weight: 700; }

.subscription { width: min(1400px, calc(100% - 44px)); margin: 70px auto; padding: 65px clamp(15px, 4vw, 50px) 70px; overflow: hidden; background: linear-gradient(135deg, #fff0f4, #f8dbe4 48%, #fff9f1); border: 1px solid rgba(255,255,255,.8); border-radius: 36px; box-shadow: 0 24px 70px rgba(74,39,52,.12); }
.subscription h2 { margin: 9px 0 0; color: var(--deep); font-size: clamp(32px, 4vw, 48px); }
.subscription h2 span { color: var(--rose); }
.subscription-intro { max-width: 680px; margin-top: 10px; color: var(--muted); font: 13px/1.7 Arial, sans-serif; }
.pack-box { margin-bottom: 25px; padding: 18px; background: rgba(255,255,255,.76); border: 1px solid rgba(255,255,255,.94); border-radius: 20px; }
.pack-title, .paygo-title { margin-bottom: 13px; color: var(--deep); font: 900 11px Arial, sans-serif; }
.pack-grid, .plans { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; }
.pack-item { display: flex; align-items: center; gap: 9px; min-height: 64px; padding: 9px; background: rgba(255,255,255,.93); border: 1px solid var(--border); border-radius: 13px; font-family: Arial, sans-serif; }
.pack-emoji { width: 36px; height: 36px; display: grid; place-items: center; flex-shrink: 0; background: #fff; border-radius: 10px; }
.pack-item strong, .pack-item small { display: block; }.pack-item strong { font-size: 10px; }.pack-item small { margin-top: 3px; color: var(--muted); font-size: 9px; }
.plan { min-height: 385px; display: flex; flex-direction: column; padding: 21px 18px 18px; border-radius: 22px; font-family: Arial, sans-serif; transition: transform .22s ease, box-shadow .22s ease; }
.plan.featured { border: 2px solid var(--rose); background: linear-gradient(180deg,#fff0f4,#fff 68%); }
.popular { position: absolute; top: -12px; left: 50%; padding: 6px 12px; color: #fff; background: linear-gradient(135deg,var(--rose),var(--rose-dark)); border-radius: 30px; transform: translateX(-50%); white-space: nowrap; font-size: 8px; font-weight: 900; }
.plan-top, .selected-plan, .delivery-time-head, .selected-products-head, .total-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.plan-icon, .modal-icon { width: 43px; height: 43px; display: grid; place-items: center; color: var(--gold); background: linear-gradient(145deg,#fff1f4,#f2e0c5); border-radius: 13px; }
.plan h3 { margin: 16px 0 0; color: var(--deep); font-size: 17px; }.plan-desc { min-height: 58px; margin-top: 7px; color: var(--muted); font-size: 10px; line-height: 1.65; }.included { margin-top: 14px; padding: 9px 10px; color: var(--deep); background: #fff4f3; border-radius: 11px; font-size: 9px; font-weight: 800; }.included span { color: #4f8d68; }.features { margin: 11px 0; padding: 0; list-style: none; color: #75686f; font-size: 9px; line-height: 1.8; }.features li::before { content: "✓"; display: inline-grid; width: 14px; height: 14px; place-items: center; margin-right: 6px; color: var(--rose); background: #fbe8ee; border-radius: 50%; }.plan-button { width: 100%; min-height: 43px; margin-top: auto; color: var(--deep); background: #fff; border: 1px solid #e6dce0; border-radius: 11px; font-size: 10px; font-weight: 900; }.plan-button.primary { color: #fff; background: linear-gradient(135deg,#482634,#62394b); }.subscription-note { margin: 20px 0 0; color: #998d93; text-align: center; font: 9px Arial, sans-serif; }
.offer-banner { display: grid; grid-template-columns: 1fr auto; gap: 20px; align-items: center; padding: 28px 32px; color: #fff; background: linear-gradient(135deg,#472531,#62394b); border-radius: 24px; }.offer-banner h2 { margin: 0; font-size: 28px; }.offer-banner p { margin: 7px 0 0; color: #ead9df; font: 13px Arial, sans-serif; }.offer-code { padding: 10px 15px; border: 1px dashed #db9eb3; border-radius: 12px; font: 12px Arial, sans-serif; }
.trust-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 15px; }.trust-card { padding: 21px; border-radius: 19px; }.trust-icon { color: var(--gold); }.trust-card strong, .trust-card span { display: block; font-family: Arial, sans-serif; }.trust-card strong { margin-top: 9px; color: var(--deep); font-size: 14px; }.trust-card span { margin-top: 4px; color: var(--muted); font-size: 12px; line-height: 1.5; }
.footer { margin-top: 75px; padding: 50px clamp(20px, 4vw, 30px) 30px 25px; color: #f9edf1; background: linear-gradient(145deg,#3f222f,#573044); }.footer-grid { max-width: 1400px; margin: auto; display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px; }.footer h3 { margin: 0 0 14px; }.footer p, .footer a { display: block; margin: 0 0 7px; color: #d9c8cf; font: 12px/1.7 Arial, sans-serif; }.copyright { max-width: 1400px; margin: 35px auto 0; padding-top: 18px; border-top: 1px solid rgba(255,255,255,.1); color: #bfaeb5; font: 11px Arial, sans-serif; }
.toast { position: fixed; left: 50%; bottom: 90px; z-index: 8000; padding: 12px 19px; color: #fff; background: linear-gradient(135deg,#482634,#62394b); border-radius: 30px; transform: translate(-50%,20px); opacity: 0; pointer-events: none; transition: .25s; font: 13px Arial, sans-serif; }.toast.show { transform: translate(-50%,0); opacity: 1; }
.cart-overlay { position: fixed; inset: 0; z-index: 3000; background: rgba(40,20,30,.3); }.cart { position: fixed; top: 0; right: 0; z-index: 3001; width: min(410px, 94vw); height: 100vh; padding: 22px; background: #fff; box-shadow: -20px 0 60px rgba(51,27,38,.15); }.cart-head { display: flex; align-items: center; justify-content: space-between; padding-bottom: 18px; border-bottom: 1px solid var(--border); }.cart-head h2 { color: var(--deep); }.close-cart, .modal-close, .remove { width: 35px; height: 35px; color: var(--deep); background: var(--blush-light); border-radius: 50%; }.cart-items { padding: 20px 0; }.empty { padding: 70px 15px; color: var(--muted); text-align: center; font: 14px Arial, sans-serif; }.cart-item { position: relative; margin-bottom: 10px; padding: 14px; background: #fffafa; border: 1px solid var(--border); border-radius: 15px; font-family: Arial, sans-serif; }.cart-item strong { display: block; padding-right: 25px; color: var(--deep); font-size: 12px; }.cart-item-price { margin-top: 5px; color: var(--rose-dark); font-size: 13px; font-weight: 900; }.remove { position: absolute; top: 8px; right: 8px; width: 27px; height: 27px; color: #aa7a89; background: #fff; }
.modal-overlay { position: fixed; inset: 0; z-index: 5000; display: flex; align-items: center; justify-content: center; padding: 18px; background: rgba(49,27,37,.46); }.modal { position: relative; width: min(720px, 100%); max-height: 94vh; overflow-y: auto; padding: 30px; background: linear-gradient(145deg,#fffafb,#fff2f5); border-radius: 28px; box-shadow: 0 30px 90px rgba(45,24,34,.25); }.modal-close { position: absolute; top: 15px; right: 15px; }.modal-label { display: block; margin-top: 15px; color: var(--rose); font: 900 9px Arial, sans-serif; letter-spacing: 2px; }.modal h2 { margin: 6px 0 0; color: var(--deep); font-size: 29px; }.modal-subtitle, .paygo-help { color: var(--muted); font: 12px/1.6 Arial, sans-serif; }.paygo-box, .selected-products-section, .selected-plan, .delivery-time-section { margin-top: 20px; padding: 15px; background: rgba(255,255,255,.84); border: 1px solid rgba(213,83,125,.13); border-radius: 17px; }.paygo-search { display: flex; align-items: center; height: 46px; padding: 0 10px; gap: 8px; background: #fff; border: 1px solid var(--border); border-radius: 13px; }.paygo-search input { flex: 1; border: 0; outline: 0; }.paygo-search button { color: var(--rose); background: #fff0f4; border-radius: 50%; }.paygo-product-results, .paygo-plans { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 8px; margin-top: 10px; }.paygo-product-card, .selected-paygo-item { display: flex; align-items: center; gap: 9px; padding: 8px; background: #fff; border: 1px solid var(--border); border-radius: 14px; font: 10px Arial, sans-serif; }.paygo-product-card img, .paygo-product-image { width: 58px; height: 58px; flex-shrink: 0; object-fit: cover; border-radius: 11px; }.paygo-product-info { min-width: 0; flex: 1; }.paygo-product-info strong, .paygo-product-info small, .paygo-product-info b { display: block; margin-top: 3px; }.paygo-product-info strong { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: var(--deep); }.paygo-product-info small { color: var(--muted); font-size: 8px; }.paygo-product-info b { color: var(--rose-dark); }.paygo-add { width: 30px; height: 30px; color: #fff; background: var(--deep); border-radius: 9px; }.selected-paygo-products { display: grid; gap: 7px; }.selected-paygo-info { min-width: 0; flex: 1; }.selected-paygo-info strong, .selected-paygo-info small { display: block; }.selected-paygo-info small { margin-top: 3px; color: var(--rose-dark); }.quantity-control { display: flex; align-items: center; gap: 4px; }.quantity-control button { width: 24px; height: 24px; color: var(--rose); background: #fff0f4; border-radius: 7px; }.no-products { padding: 18px 8px; color: var(--muted); text-align: center; font: 9px Arial, sans-serif; }.clear-products { padding: 6px 9px; color: var(--rose); background: #fff; border-radius: 9px; font-size: 8px; }.paygo-plan-title { margin-top: 20px; }.paygo-option { padding: 12px; color: var(--deep); background: #fff; border: 1px solid var(--border); border-radius: 13px; text-align: left; }.paygo-option.active { border: 2px solid var(--rose); background: #fff0f4; }.paygo-option strong, .paygo-option small { display: block; }.paygo-option small { margin-top: 4px; color: var(--muted); font-size: 8px; }.selected-plan { margin-top: 20px; }.selected-plan small { color: #9b8d93; font-size: 8px; }.selected-plan strong { display: block; margin-top: 4px; color: var(--deep); font-size: 13px; }.selected-plan b { color: var(--rose-dark); font-size: 20px; }.date-section { margin-top: 20px; font: 11px Arial, sans-serif; }.date-fields { display: grid; gap: 9px; margin-top: 9px; }.date-input, .weekday-select { width: 100%; height: 38px; padding: 0 10px; background: #fff; border: 1px solid var(--border); border-radius: 10px; }.date-preview, .selected-delivery-time { min-height: 42px; display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin-top: 10px; padding: 9px 11px; color: #9b8d93; background: #fff8f4; border-radius: 12px; font-size: 9px; }.date-chip { padding: 5px 8px; color: var(--rose-dark); background: #fbe6ec; border-radius: 8px; }.delivery-time-help { color: var(--muted); font: 9px/1.5 Arial, sans-serif; }.delivery-time-required { padding: 4px 7px; color: var(--rose); background: #fff0f4; border-radius: 20px; font: 900 7px Arial, sans-serif; }.delivery-time-options { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 8px; }.delivery-time-option { display: grid; grid-template-columns: 35px minmax(0,1fr); grid-template-rows: auto auto; gap: 2px 8px; min-height: 58px; padding: 9px; color: var(--deep); background: #fff; border: 1px solid var(--border); border-radius: 13px; text-align: left; }.delivery-time-option.active { border: 2px solid var(--rose); background: #fff0f4; }.delivery-time-icon { grid-row: 1 / 3; width: 35px; height: 35px; display: grid; place-items: center; background: #fff7f9; border-radius: 10px; }.delivery-time-option strong, .delivery-time-option small { grid-column: 2; }.delivery-time-option small { color: var(--muted); font-size: 8px; }.confirm { min-height: 48px; margin-top: 15px; }.confirm:disabled { opacity: .45; cursor: not-allowed; }
.mobile-bottom-nav { display: none; }
.plans { padding-top: 14px; }
.plan { overflow: visible; }
.popular { z-index: 2; top: -8px; padding: 5px 10px; font-size: 7px; }
.footer{margin-bottom: 0px;}

.error-page { min-height: 650px; display: flex; align-items: center; justify-content: center; padding: 60px 20px 80px; }
.error-container { position: relative; width: min(920px, 100%); text-align: center; }
.blob { position: absolute; z-index: 0; border-radius: 50%; pointer-events: none; filter: blur(1px); }
.blob-one { top: 20px; left: -30px; width: 180px; height: 180px; background: rgba(248,220,228,.55); }
.blob-two { right: 0; bottom: 30px; width: 130px; height: 130px; background: rgba(239,195,208,.45); }
.error-art { position: relative; z-index: 1; width: 170px; height: 170px; display: grid; place-items: center; margin: 0 auto 25px; color: var(--gold); background: linear-gradient(145deg, #fff3f6, #f6dce3); border: 1px solid rgba(184,92,120,.12); border-radius: 50%; box-shadow: 0 20px 55px rgba(90,48,68,.10); animation: pp-float 4s ease-in-out infinite; }
.error-art::before { content: ""; position: absolute; inset: 12px; border: 1px dashed rgba(184,92,120,.25); border-radius: 50%; }
.error-art .icon { width: 72px; height: 72px; stroke-width: 1.3; }
.error-number { position: relative; z-index: 1; color: var(--deep); font: 800 clamp(90px, 16vw, 170px)/.8 Georgia, serif; letter-spacing: -8px; text-shadow: 8px 8px 0 rgba(248,220,228,.75); }
.error-number span { color: var(--rose); }
.error-content { position: relative; z-index: 1; margin-top: 30px; }
.eyebrow { color: var(--rose); font: 800 11px Arial, sans-serif; letter-spacing: 2.5px; text-transform: uppercase; }
.error-content h1 { margin-top: 9px; color: var(--deep); font: 700 clamp(28px, 4vw, 43px) Georgia, serif; }
.error-content p { max-width: 540px; margin: 12px auto 0; color: var(--muted); font: 14px/1.8 Arial, sans-serif; }
.error-actions { display: flex; align-items: center; justify-content: center; gap: 10px; flex-wrap: wrap; margin-top: 27px; }
.primary-btn, .secondary-btn { min-width: 165px; min-height: 46px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 0 20px; border-radius: 13px; font: 800 12px Arial, sans-serif; }
.primary-btn { color: #fff; background: var(--deep); box-shadow: 0 8px 20px rgba(77,41,56,.14); }
.primary-btn:hover { background: var(--rose-dark); transform: translateY(-2px); box-shadow: 0 12px 28px rgba(77,41,56,.20); }
.secondary-btn { color: var(--deep); background: #fff; border: 1px solid var(--border); }
.secondary-btn:hover { background: var(--blush-light); border-color: #efc3d0; transform: translateY(-2px); }
.timeout-page { min-height: 650px; display: flex; align-items: center; justify-content: center; padding: 55px 20px 75px; }
.timeout-container { position: relative; width: min(900px, 100%); text-align: center; }
.timeout-container .blob-one { top: 0; left: -30px; width: 190px; height: 190px; background: rgba(248,220,228,.55); }
.timeout-container .blob-two { right: -10px; bottom: 20px; width: 150px; height: 150px; background: rgba(239,195,208,.38); }
.server-art { position: relative; z-index: 1; width: 160px; height: 160px; display: grid; place-items: center; margin: 0 auto 28px; background: linear-gradient(145deg, #fff2f5, #f5dbe3); border: 1px solid rgba(184,92,120,.12); border-radius: 50%; box-shadow: 0 20px 60px rgba(90,48,68,.11); animation: pp-float 4s ease-in-out infinite; }
.server-art::before { content: ""; position: absolute; inset: 12px; border: 1px dashed rgba(184,92,120,.25); border-radius: 50%; }
.server-box { position: relative; width: 72px; height: 58px; background: #fff; border: 2px solid var(--deep); border-radius: 8px; box-shadow: 0 8px 18px rgba(77,41,56,.08); }
.server-box::before, .server-box::after { content: ""; position: absolute; left: 12px; right: 12px; height: 2px; background: var(--border); border-radius: 5px; }
.server-box::before { top: 18px; }
.server-box::after { bottom: 18px; }
.server-light { position: absolute; top: 8px; left: 12px; width: 6px; height: 6px; background: var(--rose); border-radius: 50%; box-shadow: 15px 0 0 var(--green); }
.server-base { position: absolute; bottom: 35px; width: 90px; height: 7px; background: var(--deep); border-radius: 10px; }
.timeout-container .status-pill { position: relative; z-index: 1; width: max-content; display: flex; align-items: center; gap: 7px; margin: 0 auto 14px; padding: 7px 12px; color: var(--muted); background: #fff; border: 1px solid var(--border); border-radius: 30px; box-shadow: 0 5px 18px rgba(90,48,68,.05); font: 750 10px Arial, sans-serif; }
.timeout-container .status-dot { width: 7px; height: 7px; background: #d49a48; border-radius: 50%; box-shadow: 0 0 0 4px rgba(212,154,72,.12); animation: timeout-pulse 1.8s infinite; }
.timeout-container > .eyebrow { position: relative; z-index: 1; color: var(--rose); font: 800 11px Arial, sans-serif; letter-spacing: 2.5px; text-transform: uppercase; }
.timeout-container h1 { position: relative; z-index: 1; margin-top: 8px; color: var(--deep); font: 700 clamp(34px, 5vw, 54px) Georgia, serif; }
.timeout-container .description { position: relative; z-index: 1; max-width: 570px; margin: 14px auto 0; color: var(--muted); font: 14px/1.8 Arial, sans-serif; }
.retry-box { position: relative; z-index: 1; width: min(600px, 100%); display: flex; align-items: center; justify-content: space-between; gap: 20px; margin: 28px auto 0; padding: 18px; text-align: left; background: #fff; border: 1px solid var(--border); border-radius: 18px; box-shadow: 0 10px 30px rgba(90,48,68,.06); }
.retry-message strong, .retry-message span { display: block; }
.retry-message strong { color: var(--deep); font: 700 12px Arial, sans-serif; }
.retry-message span { margin-top: 4px; color: var(--muted); font: 10px Arial, sans-serif; }
.retry-btn { min-width: 120px; height: 42px; display: flex; align-items: center; justify-content: center; gap: 8px; color: #fff; background: var(--deep); border-radius: 11px; font: 800 11px Arial, sans-serif; }
.retry-btn:hover { background: var(--rose-dark); transform: translateY(-2px); }
.retry-btn:disabled { cursor: wait; opacity: .75; }
.retry-btn .icon { width: 15px; height: 15px; }
.retry-btn:disabled .icon { animation: timeout-spin .8s linear infinite; }
.timeout-container .actions { position: relative; z-index: 1; display: flex; justify-content: center; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
.timeout-container .primary-btn, .timeout-container .secondary-btn { min-width: 160px; min-height: 45px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 0 18px; border-radius: 12px; font: 800 11px Arial, sans-serif; }
.timeout-container .primary-btn { color: #fff; background: var(--deep); box-shadow: 0 8px 20px rgba(77,41,56,.14); }
.timeout-container .primary-btn:hover { background: var(--rose-dark); transform: translateY(-2px); }
.timeout-container .secondary-btn { color: var(--deep); background: #fff; border: 1px solid var(--border); }
.timeout-container .secondary-btn:hover { background: var(--blush-light); border-color: #efc3d0; transform: translateY(-2px); }
.timeout-container .primary-btn .icon, .timeout-container .secondary-btn .icon { width: 16px; height: 16px; }
.help-text { position: relative; z-index: 1; margin-top: 30px; color: #988a91; font: 10px Arial, sans-serif; }
.help-text a { color: var(--rose); font-weight: 700; }
.help-text a:hover { color: var(--rose-dark); }
@keyframes timeout-spin { to { transform: rotate(360deg); } }
@keyframes timeout-pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: .45; transform: scale(.8); } }
@media (max-width: 600px) { .timeout-page { min-height: 590px; padding: 40px 15px 55px; }.server-art { width: 135px; height: 135px; }.timeout-container .retry-box { flex-direction: column; align-items: stretch; text-align: center; }.retry-btn { width: 100%; }.timeout-container .actions { flex-direction: column; align-items: center; }.timeout-container .primary-btn, .timeout-container .secondary-btn { width: min(300px, 100%); }.timeout-container .blob-one { left: -45px; width: 110px; height: 110px; }.timeout-container .blob-two { right: -25px; width: 90px; height: 90px; } }
.primary-btn .icon, .secondary-btn .icon { width: 16px; height: 16px; }
.quick-links { position: relative; z-index: 1; max-width: 700px; margin: 45px auto 0; padding-top: 25px; border-top: 1px solid var(--border); }
.quick-links-title { color: var(--muted); font: 700 11px Arial, sans-serif; }
.links { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
.links a { padding: 9px 14px; color: var(--deep); background: #fff; border: 1px solid var(--border); border-radius: 20px; font: 650 11px Arial, sans-serif; }
.links a:hover { color: var(--rose); background: var(--blush-light); border-color: #efc3d0; }

@media (min-width: 1600px) {
	body { font-size: 14px; }
	.navbar { min-height: 64px; gap: 16px; padding: 12px 34px 12px 0; }
	.logo { font-size: 24px; }
	.search-box input { height: 40px; }
	.search-button { top: 4px; width: 32px; height: 32px; }
	.icon-button { width: 38px; height: 38px; }
	.category-nav { top: 64px; padding: 0 28px 0 0; }
	.category-nav a { min-height: 42px; padding-inline: 14px; font-size: 13px; }
	.hero, .section, .product-page, .cart-page, .products-page, .cart-exact-page, .wishlist-exact-page, .checkout-exact-page, .confirmation-exact-page, .my-orders-page, .my-account-page, .track-order-page { width: min(1180px, calc(100% - 56px)); max-width: 1180px; }
	.hero, .section { margin-bottom: 44px; }
	.hero-card { min-height: 360px; border-radius: 24px; }
	.hero-content { padding: 44px 54px; }
	.hero h1 { font-size: clamp(38px, 4vw, 58px); }
	.hero-art { min-height: 360px; }
	.hero-product-photo { height: 300px; }
	.section-header { margin-bottom: 16px; }
	.section-title { font-size: 26px; }
	.category-grid, .product-grid, .trust-grid { gap: 12px; }
	.product-grid { grid-template-columns: repeat(5, minmax(0, 1fr)); }
	.product-image { height: 205px; }
	.subscription { width: min(1180px, calc(100% - 56px)); margin-block: 52px; padding-block: 46px 52px; border-radius: 28px; }
	.pack-grid, .plans { gap: 10px; }
	.plan { min-height: 340px; padding: 17px 15px 15px; }
	.footer-grid, .copyright { max-width: 1180px; }
	.login-wrapper, .signup-wrapper { max-width: 820px; }
	.otp-card, .two-factor-card { padding-block: 34px; }
	.footer { margin-top: 56px; padding: 38px 34px 38px 0; }
}

@media (min-width: 3000px) {
	body { font-size: 13px; }
	.navbar { padding: 12px 48px 12px 0; }
	.category-nav { padding: 0 42px 0 0; }
	.hero, .section, .subscription, .product-page, .cart-page, .products-page, .cart-exact-page, .wishlist-exact-page, .checkout-exact-page, .confirmation-exact-page, .my-orders-page, .my-account-page, .track-order-page { width: min(1040px, calc(100% - 80px)); max-width: 1040px; }
	.hero-card { min-height: 320px; }
	.hero-content { padding: 36px 44px; }
	.hero h1 { font-size: 48px; }
	.hero-art { min-height: 320px; }
	.hero-product-photo { height: 260px; }
	.product-image { height: 180px; }
	.subscription { margin-block: 44px; padding-block: 38px 44px; }
	.plan { min-height: 315px; }
	.footer-grid, .copyright { max-width: 1040px; }
	.login-wrapper, .signup-wrapper { max-width: 760px; }
	.otp-card, .two-factor-card { padding-block: 28px; }
	.footer { margin-top: 44px; padding: 38px 48px 38px 0; }
}

@media (max-width: 950px) { .navbar { flex-wrap: wrap; gap: 10px; }.search-box { order: 3; flex-basis: 100%; max-width: none; }.hero-card { grid-template-columns: 1fr; }.hero-art { min-height: 230px; }.hero-product-photo { width: 84%; height: 260px; }.category-grid { grid-template-columns: repeat(3, minmax(0,1fr)); }.product-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }.trust-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }.footer-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }.plans, .pack-grid { grid-template-columns: repeat(3, minmax(0,1fr)); } }
@media (max-width: 600px) { .error-page { min-height: 590px; padding: 45px 16px 55px; }.error-art { width: 135px; height: 135px; }.error-art .icon { width: 58px; height: 58px; }.error-number { font-size: 100px; letter-spacing: -6px; }.error-content { margin-top: 24px; }.error-content h1 { font-size: 29px; }.error-content p { font-size: 13px; }.error-actions { flex-direction: column; }.primary-btn, .secondary-btn { width: min(300px, 100%); }.blob-one { left: -45px; width: 110px; height: 110px; }.blob-two { right: -25px; width: 90px; height: 90px; } }
@media (max-width: 700px) { body { padding-bottom:0px; }.hero, .section { width: calc(100% - 20px); margin-top: 34px; margin-bottom: 34px; }.navbar { padding: 9px 12px; }.logo { font-size: 21px; }.icon-button { width: 38px; height: 38px; }.category-nav { top: 102px; padding: 0 36px; }.category-nav a { min-height: 43px; padding: 0 13px; font-size: 10px; }.hero-card { border-radius: 22px; }.hero-content { padding: 32px 20px; }.hero h1 { font-size: clamp(32px, 10vw, 42px); }.hero p { font-size: 12px; }.hero-art { min-height: 155px; }.hero-product-photo { width: 84%; height: 155px; }.section-title { font-size: 23px; }.category-card { padding: 13px 4px; border-radius: 14px; }.category-icon { width: 44px; height: 44px; border-radius: 12px; }.category-card strong { font-size: 9px; }.category-card small { font-size: 7px; }.product-grid { gap: 8px; }.product-card { padding: 7px; border-radius: 17px; }.product-image { height: 155px; border-radius: 13px; }.product-title { font-size: 11px; }.price { font-size: 14px; }.add-cart { padding: 9px 7px; font-size: 8px; }.subscription { width: calc(100% - 20px); margin: 34px 10px; padding: 34px 12px 38px; border-radius: 25px; }.subscription h2 { font-size: clamp(28px, 8vw, 38px); }.pack-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }.plans { grid-template-columns: 1fr; }.plan { min-height: 0; }.offer-banner { grid-template-columns: 1fr; padding: 20px; }.trust-grid { gap: 8px; }.trust-card { padding: 15px; }.footer { padding: 40px 20px 80px; }.mobile-bottom-nav { position: fixed; left: 8px; right: 8px; bottom: 8px; z-index: 9999; height: 62px; display: grid; grid-template-columns: repeat(5, minmax(0,1fr)); gap: 2px; padding: 5px; background: rgba(255,255,255,.98); border: 1px solid rgba(213,83,125,.17); border-radius: 23px; box-shadow: 0 10px 28px rgba(72,39,53,.15); }.mobile-bottom-nav-item { min-width: 0; min-height: 50px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; color: #796e73; border-radius: 16px; font: 800 7.5px Arial, sans-serif; }.mobile-bottom-nav-item.active { color: var(--deep); background: var(--blush); }.mobile-bottom-nav-icon-wrap { position: relative; width: 23px; height: 23px; display: grid; place-items: center; }.mobile-bottom-nav-badge { top: -3px; right: -5px; min-width: 15px; height: 15px; border: 2px solid var(--blush-light); font-size: 7px; }.modal-overlay { padding: 10px; }.modal { max-height: calc(100dvh - 20px); padding: 20px 14px; }.paygo-product-results, .delivery-time-options { grid-template-columns: 1fr; }.paygo-plans { grid-template-columns: 1fr; } }
@media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; } }

#subscriptionModal #confirmSubscription.confirm {
	display: block;
	width: 100%;
	min-height: 48px;
	margin-top: 15px;
	padding: 13px;
	margin-bottom:50px;
	color: #fff;
	background: linear-gradient(135deg, #482634, #62394b) !important;
	border: 0;
	border-radius: 14px;
	box-shadow: 0 8px 20px rgba(74, 39, 52, .14);
	font: 900 11px Arial, sans-serif;
	opacity: 1;
}

#subscriptionModal #confirmSubscription.confirm:disabled {
	color: #fff;
	background: linear-gradient(135deg, #482634, #62394b) !important;
	opacity: .45;
	cursor: not-allowed;
}

#subscriptionModal .modal-close {
	position: absolute;
	top: 15px;
	right: 15px;
	z-index: 10;
	width: 36px;
	height: 36px;
	display: grid;
	place-items: center;
	padding: 0;
	color: var(--deep);
	background: #fff !important;
	border: 1px solid var(--border);
	border-radius: 50%;
	box-shadow: 0 6px 14px rgba(72, 39, 53, .1);
	font: 400 22px/1 Arial, sans-serif;
	cursor: pointer;
}

#subscriptionModal .modal-close:hover {
	color: var(--rose-dark);
	background: #fff0f4 !important;
}

.product-page { width: min(1400px, calc(100% - 44px)); margin: auto; padding: 20px 0 70px; }
.product-main { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(420px, .95fr); gap: 55px; align-items: start; }
.gallery { position: sticky; top: 105px; }.gallery-layout { display: grid; grid-template-columns: 82px minmax(0, 1fr); gap: 14px; }.thumbnails { display: flex; flex-direction: column; gap: 10px; }.thumbnail { width: 76px; height: 76px; display: grid; place-items: center; color: var(--gold); background: linear-gradient(145deg, #fff4f7, #f4ddd7); border: 1px solid var(--border); border-radius: 15px; }.thumbnail:hover, .thumbnail.active { border-color: var(--rose); box-shadow: 0 0 0 2px rgba(184, 92, 120, .12); }.thumbnail .icon { width: 40px; height: 40px; }
.main-image { position: relative; max-height: auto; display: grid; place-items: center; overflow: hidden; background: radial-gradient(circle at 50% 45%, rgba(255,255,255,.85), transparent 35%), linear-gradient(145deg, #fff1f5, #f4d9d4); border-radius: 28px; }.detail-product-photo { width: 100%; height: 100%; object-fit: cover; filter: drop-shadow(0 22px 25px rgba(77,41,56,.14)); transition: transform .25s ease; }.main-image:hover .detail-product-photo { transform: scale(1.04); }.zoom-label { position: absolute; right: 18px; bottom: 18px; display: inline-flex; align-items: center; gap: 5px; padding: 8px 8px; color: var(--muted); background: rgba(255,255,255,.8); border-radius: 20px; font: 11px Arial, sans-serif; }.zoom-label .icon { width: 13px; height: 13px; }/* .gallery-wishlist styling now lives in the single shared wishlist block above */
.product-detail-info { padding-top: 4px; }.product-brand { color: var(--rose); font: 800 13px Arial, sans-serif; letter-spacing: 1.8px; text-transform: uppercase; }.product-detail-info .product-title { margin-top: 10px; color: var(--deep); font: 700 clamp(28px, 3.5vw, 44px)/1.12 Georgia, serif; }.product-subtitle { margin-top: 10px; color: var(--muted); font: 14px/1.6 Arial, sans-serif; }.rating-row { display: flex; align-items: center; gap: 12px; margin-top: 16px; flex-wrap: wrap; }.rating-pill { display: inline-flex; align-items: center; gap: 5px; padding: 6px 10px; color: #936725; background: #fff0d7; border-radius: 8px; font: 800 13px Arial, sans-serif; }.review-link { color: var(--rose); font: 13px Arial, sans-serif; }.divider { height: 1px; margin: 20px 0; background: var(--border); }.price-block { padding: 17px 0; }.current-price { color: var(--deep); font: 800 34px Arial, sans-serif; }.tax-note { margin-top: 5px; color: var(--muted); font: 12px Arial, sans-serif; }.product-detail-info .mrp { color: #999; font-size: 15px; }.product-detail-info .discount { color: #4c8b65; font-size: 14px; font-weight: 800; }
.offer-title { margin-bottom: 10px; color: var(--deep); font: 800 15px Arial, sans-serif; }.offer-list { display: grid; gap: 9px; }.offer-card { display: flex; align-items: flex-start; gap: 10px; padding: 12px 14px; background: #fff7f9; border: 1px solid #f1dce3; border-radius: 13px; }.offer-icon { width: 27px; height: 27px; flex: none; display: grid; place-items: center; color: var(--rose); background: var(--blush); border-radius: 50%; }.offer-icon .icon { width: 14px; height: 14px; }.offer-card strong, .offer-card span { display: block; }.offer-card strong { color: var(--deep); font: 700 13px Arial, sans-serif; }.offer-card span { margin-top: 3px; color: var(--muted); font: 12px/1.4 Arial, sans-serif; }
.delivery-box { padding: 17px; background: #fff; border: 1px solid var(--border); border-radius: 16px; }.delivery-head { display: flex; align-items: center; gap: 8px; color: var(--deep); font: 800 14px Arial, sans-serif; }.delivery-head .icon { width: 19px; height: 19px; color: var(--gold); }.pincode-row { display: flex; gap: 8px; margin-top: 12px; }.pincode-row input { flex: 1; height: 42px; padding: 0 12px; border: 1px solid var(--border); border-radius: 10px; outline: 0; font-size: 13px; }.check-btn { padding: 0 17px; color: #fff; background: var(--deep); border-radius: 10px; font-size: 13px; font-weight: 700; }.delivery-result { min-height: 16px; margin-top: 9px; color: #4c8b65; font: 12px Arial, sans-serif; }.delivery-error { color: var(--rose); }
.buy-row { display: grid; grid-template-columns: 120px 1fr 1fr; gap: 10px; margin-top: 18px; }.quantity { height: 50px; display: flex; align-items: center; justify-content: space-between; background: #fff; border: 1px solid var(--border); border-radius: 13px; }.quantity button { width: 38px; height: 100%; color: var(--deep); background: none; font-size: 19px; }.quantity span { font: 800 15px Arial, sans-serif; }.cart-button, .buy-button { height: 50px; border-radius: 13px; font: 800 14px Arial, sans-serif; }.cart-button { color: #fff; background: linear-gradient(145deg, #4a2734, #6a3a4d); }.buy-button { color: #fff; background: linear-gradient(135deg, #d5537d, #a8335c); box-shadow: 0 8px 18px rgba(77,41,56,.14); }.product-trust { display: grid; grid-template-columns: repeat(3, 1fr); gap: 9px; margin-top: 18px; }.product-trust-card { min-height: 80px; display: flex; align-items: center; gap: 9px; padding: 12px; background: var(--blush-light); border-radius: 14px; }.product-trust-card .icon { width: 21px; height: 21px; flex: none; color: var(--gold); }.product-trust-card strong, .product-trust-card span { display: block; }.product-trust-card strong { color: var(--deep); font: 700 12px Arial, sans-serif; }.product-trust-card span { margin-top: 3px; color: var(--muted); font: 10px/1.4 Arial, sans-serif; }
.details-section, .reviews-section, .related { margin-top: 55px; padding-top: 35px; border-top: 1px solid var(--border); }.details-grid { display: grid; grid-template-columns: 1.3fr .7fr; gap: 55px; }.details-title { margin-bottom: 17px; color: var(--deep); font: 700 30px Georgia, serif; }.details-copy { color: #665b61; font: 15px/1.85 Arial, sans-serif; }.highlights { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-top: 22px; }.highlight { padding: 15px; background: #fff; border: 1px solid var(--border); border-radius: 14px; }.highlight strong, .highlight span { display: block; }.highlight strong { color: var(--deep); font: 700 13px Arial, sans-serif; }.highlight span { margin-top: 5px; color: var(--muted); font: 12px/1.5 Arial, sans-serif; }.spec-box { overflow: hidden; background: #fff; border: 1px solid var(--border); border-radius: 18px; }.spec-row { display: grid; grid-template-columns: 1fr 1fr; border-bottom: 1px solid var(--border); }.spec-row:last-child { border-bottom: 0; }.spec-row div { padding: 13px 15px; font: 13px Arial, sans-serif; }.spec-row div:first-child { color: var(--muted); background: #fff8fa; }.spec-row div:last-child { color: var(--deep); font-weight: 650; }
.reviews-summary { display: grid; grid-template-columns: 180px 1fr; gap: 30px; align-items: center; margin-top: 20px; padding: 25px; background: #fff4f7; border-radius: 20px; }.average-rating { text-align: center; }.average-rating strong { display: block; color: var(--deep); font: 800 52px Arial, sans-serif; }.average-rating .stars, .review-stars { color: #b47c30; letter-spacing: 2px; font-size: 14px; }.average-rating span { display: block; margin-top: 5px; color: var(--muted); font: 12px Arial, sans-serif; }.rating-bars { display: grid; gap: 8px; }.rating-bar { display: grid; grid-template-columns: 35px 1fr 40px; align-items: center; gap: 8px; color: var(--muted); font: 11px Arial, sans-serif; }.bar { height: 6px; overflow: hidden; background: #eadfe3; border-radius: 20px; }.bar-fill { height: 100%; background: var(--gold); border-radius: 20px; }.review-list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 20px; }.review-card { padding: 20px; background: #fff; border: 1px solid var(--border); border-radius: 18px; }.reviewer { display: flex; align-items: center; gap: 10px; }.avatar { width: 37px; height: 37px; display: grid; place-items: center; color: var(--rose-dark); background: var(--blush); border-radius: 50%; font: 800 12px Arial, sans-serif; }.reviewer strong, .reviewer .verified { display: block; }.reviewer strong { color: var(--deep); font: 700 13px Arial, sans-serif; }.verified { margin-top: 2px; color: #4c8b65; font: 10px Arial, sans-serif; }.review-stars { margin-top: 12px; font-size: 12px; }.review-card p { margin-top: 10px; color: #6b6066; font: 13px/1.65 Arial, sans-serif; }
.related-product-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 15px; margin-top: 20px; }.related-product-grid .product-card { padding: 9px; background: #fff; border: 1px solid var(--border); border-radius: 19px; }.related-product-grid .product-image { height: 190px; }.related-product-grid .product-info { padding: 4px 4px 2px; }.related-product-grid .product-name { min-height: 36px; margin: 5px 0 0; color: var(--deep); font: 650 15px/1.35 Arial, sans-serif; }.related-product-grid .product-price { display: flex; align-items: baseline; gap: 6px; margin-top: 7px; }.related-product-grid .current { color: var(--deep); font: 800 17px Arial, sans-serif; }
@media (max-width: 1000px) { .product-main { grid-template-columns: 1fr; gap: 30px; }.gallery { position: relative; top: auto; }.main-image { min-height: 480px; }.details-grid { grid-template-columns: 1fr; }.review-list { grid-template-columns: repeat(2, 1fr); }.related-product-grid { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 650px) { .product-page { padding: 15px 0 50px; }.gallery-layout { grid-template-columns: 58px minmax(0, 1fr); }.thumbnails { gap: 7px; }.thumbnail { width: 54px; height: 54px; border-radius: 11px; }.thumbnail .icon { width: 28px; height: 28px; }.main-image { min-height: 380px; border-radius: 21px; }.product-detail-info .product-title { font-size: 31px; }.current-price { font-size: 27px; }.buy-row { grid-template-columns: 105px 1fr; }.buy-button, .cart-button { grid-column: 2; }.product-trust, .highlights, .reviews-summary { grid-template-columns: 1fr; }.review-list { grid-template-columns: 1fr; }.related-product-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }.related-product-grid .product-image { height: 150px; }.related-product-grid .product-name { font-size: 13px; }.related-product-grid .current { font-size: 15px; } }
@media (max-width: 400px) { .gallery-layout { grid-template-columns: 1fr; }.thumbnails { order: 2; flex-direction: row; overflow-x: auto; }.thumbnail { flex: none; }.main-image { order: 1; }.buy-row { grid-template-columns: 1fr 1fr; }.quantity { grid-column: 1 / -1; }.buy-button, .cart-button { grid-column: auto; } }

.cart-page { width: min(1400px, calc(100% - 44px)); margin: auto; padding: 20px 0 70px; }.cart-page-heading { display: flex; align-items: end; justify-content: space-between; gap: 20px; padding: 20px 0 30px; }.cart-page-heading h1 { margin-top: 7px; color: var(--deep); font: 700 clamp(32px, 4vw, 50px) Georgia, serif; }.cart-page-heading p { margin-top: 8px; color: var(--muted); font: 13px Arial, sans-serif; }.continue-shopping, .cart-primary-link { display: inline-flex; align-items: center; justify-content: center; min-height: 42px; padding: 0 16px; color: #fff; background: var(--deep); border-radius: 11px; font: 700 12px Arial, sans-serif; }.cart-layout { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(300px, .6fr); gap: 25px; align-items: start; }.cart-list, .cart-summary { padding: 22px; background: #fff; border: 1px solid var(--border); border-radius: 20px; }.cart-section-heading { display: flex; align-items: center; justify-content: space-between; padding-bottom: 15px; border-bottom: 1px solid var(--border); }.cart-section-heading h2, .cart-summary h2 { color: var(--deep); font: 700 20px Georgia, serif; }.cart-section-heading span { color: var(--muted); font: 11px Arial, sans-serif; }.cart-page-item { display: grid; grid-template-columns: 92px minmax(0, 1fr) auto auto; gap: 16px; align-items: center; padding: 18px 0; border-bottom: 1px solid var(--border); }.cart-page-item:last-child { border-bottom: 0; padding-bottom: 0; }.cart-page-item img { width: 92px; height: 92px; object-fit: cover; background: #fff3f5; border-radius: 13px; }.cart-page-item-info { min-width: 0; }.cart-page-item-info h3 { color: var(--deep); font: 700 14px/1.35 Arial, sans-serif; }.cart-page-item-info span { display: block; margin-top: 6px; color: var(--muted); font: 11px Arial, sans-serif; }.cart-page-item-info strong { display: block; margin-top: 12px; color: var(--deep); font: 800 15px Arial, sans-serif; }.cart-page-quantity { display: flex; align-items: center; height: 38px; border: 1px solid var(--border); border-radius: 10px; }.cart-page-quantity button { width: 32px; height: 100%; color: var(--deep); background: none; font-size: 17px; }.cart-page-quantity span { min-width: 25px; text-align: center; font: 700 12px Arial, sans-serif; }.cart-page-remove { color: var(--rose); background: none; font: 700 11px Arial, sans-serif; }.cart-summary { position: sticky; top: 105px; }.summary-row, .summary-total { display: flex; justify-content: space-between; gap: 12px; color: var(--muted); font: 12px Arial, sans-serif; }.summary-row { padding: 14px 0 0; }.summary-row strong { color: var(--deep); font-weight: 700; text-align: right; }.summary-total { margin-top: 18px; padding-top: 18px; color: var(--deep); border-top: 1px solid var(--border); font-size: 15px; font-weight: 800; }.cart-summary > .checkout { display: flex; align-items: center; justify-content: center; min-height: 46px; margin-top: 18px; }.cart-delivery-box { margin-top: 25px; padding-top: 20px; border-top: 1px solid var(--border); }.cart-delivery-box > strong { color: var(--deep); font: 700 12px Arial, sans-serif; }.cart-empty-state { padding: 75px 20px; text-align: center; background: #fff; border: 1px solid var(--border); border-radius: 20px; }.cart-empty-mark { width: 60px; height: 60px; display: grid; place-items: center; margin: auto; color: var(--rose); background: var(--blush-light); border-radius: 50%; font-size: 28px; }.cart-empty-state h2 { margin-top: 18px; color: var(--deep); font: 700 24px Georgia, serif; }.cart-empty-state p { margin: 8px 0 20px; color: var(--muted); font: 13px Arial, sans-serif; }
@media (max-width: 800px) { .cart-page-heading { align-items: flex-start; flex-direction: column; }.cart-layout { grid-template-columns: 1fr; }.cart-summary { position: static; }.cart-page-item { grid-template-columns: 72px minmax(0, 1fr) auto; gap: 12px; }.cart-page-item img { width: 72px; height: 72px; }.cart-page-remove { grid-column: 2 / -1; justify-self: start; }.cart-page-quantity { grid-column: 3; grid-row: 1; } }
@media (max-width: 480px) { .cart-page { padding: 15px 0 50px; }.cart-list, .cart-summary { padding: 16px; border-radius: 16px; }.cart-page-item { grid-template-columns: 60px minmax(0, 1fr); }.cart-page-item img { width: 60px; height: 60px; }.cart-page-quantity { grid-column: 2; grid-row: auto; justify-self: start; }.cart-page-remove { grid-column: 2; }.continue-shopping { width: 100%; } }

.weekday-select {
	appearance: none;
	-webkit-appearance: none;
	min-height: 42px;
	padding: 0 38px 0 13px !important;
	color: var(--deep) !important;
	background-color: #fff !important;
	background-image: linear-gradient(45deg, transparent 50%, var(--rose) 50%), linear-gradient(135deg, var(--rose) 50%, transparent 50%);
	background-position: calc(100% - 17px) 18px, calc(100% - 12px) 18px;
	background-repeat: no-repeat;
	background-size: 5px 5px, 5px 5px;
	border: 1px solid var(--border) !important;
	border-radius: 11px !important;
	font: 700 12px Arial, sans-serif;
	cursor: pointer;
}

.weekday-select:hover {
	border-color: #d99aac !important;
}

.weekday-select:focus {
	border-color: var(--rose) !important;
	box-shadow: 0 0 0 3px rgba(213, 83, 125, .1);
	outline: 0;
}

/* Cart page — dimensions matched 1:1 to .products-page (source of truth). */
.cart-exact-page { width: min(1400px, calc(100% - 44px)); margin: 0 auto; padding: 20px 0 70px; }
.cart-exact-page .breadcrumb { max-width: none; margin: 0 0 20px; padding: 0; font-size: 14px; }
.cart-exact-page .cart-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 22px; }
.cart-exact-page .cart-title { margin-top: 0px; color: var(--deep); font: 700 clamp(32px, 4vw, 50px) Georgia, serif; }
.cart-exact-page .cart-subtitle { margin-top: 8px; color: var(--muted); font: 13px Arial, sans-serif; }
.cart-exact-page .continue-shopping { display: inline-flex; align-items: center; gap: 6px; min-height: 42px; padding: 0 16px; color: #fff; background: var(--deep); border-radius: 11px; font: 700 12px Arial, sans-serif; }
.cart-exact-page .continue-shopping .icon { width: 16px; height: 16px; }
.delivery-progress { margin-bottom: 20px; padding: 13px 15px; background: #fff; border: 1px solid var(--border); border-radius: 12px; box-shadow: var(--shadow-soft); }
.delivery-progress-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 8px; font: 8px Arial, sans-serif; }.delivery-progress-top strong { color: var(--green); }.delivery-progress-top span { color: var(--muted); }.progress-track { height: 5px; overflow: hidden; background: #eee4e7; border-radius: 10px; }.progress-fill { height: 100%; background: linear-gradient(90deg, var(--rose), #e9a0b5); border-radius: 10px; transition: width .4s; }
.cart-exact-page .cart-grid { display: grid; grid-template-columns: minmax(0, 1fr) 350px; gap: 20px; align-items: start; }.cart-exact-page .cart-card, .cart-exact-page .summary { overflow: hidden; padding: 0; background: #fff; border: 1px solid var(--border); border-radius: 18px; box-shadow: var(--shadow-soft); }.cart-exact-page .cart-card-header { display: flex; align-items: center; justify-content: space-between; padding: 17px 19px; border-bottom: 1px solid var(--border); }.cart-exact-page .cart-card-header h2, .cart-exact-page .summary h2 { color: var(--deep); font: 700 14px Arial, sans-serif; }.cart-exact-page .select-all { color: var(--rose); background: none; font: 800 8px Arial, sans-serif; }
.cart-exact-page .cart-items { padding: 0 19px; }.cart-exact-page .cart-item { display: grid; grid-template-columns: 100px minmax(0, 1fr) auto; gap: 15px; align-items: center; padding: 17px 0; border-bottom: 1px solid var(--border); }.cart-exact-page .cart-item:last-child { border-bottom: 0; }.cart-exact-page .product-image { position: relative; width: 100px; height: 100px; overflow: hidden; display: grid; place-items: center; padding: 0; background: linear-gradient(145deg, #fff0f3, #f5dfd9); border-radius: 13px; }.cart-exact-page .product-image img { width: 100%; height: 100%; object-fit: cover; }.discount-badge { position: absolute; top: 7px; left: 7px; z-index: 1; padding: 4px 6px; color: #fff; background: var(--rose); border-radius: 6px; font: 800 7px Arial, sans-serif; }.cart-exact-page .product-info { min-width: 0; }.cart-exact-page .product-category { color: var(--rose); font: 800 8px Arial, sans-serif; letter-spacing: .5px; text-transform: uppercase; }.cart-exact-page .product-name { margin-top: 5px; color: var(--deep); font: 800 12px/1.4 Arial, sans-serif; }.cart-exact-page .product-description { margin-top: 4px; color: var(--muted); font: 8px/1.5 Arial, sans-serif; }.product-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 7px; margin-top: 8px; }.meta-pill { padding: 4px 6px; color: var(--muted); background: var(--blush-light); border-radius: 5px; font: 700 7px Arial, sans-serif; }.price-row { display: flex; align-items: center; flex-wrap: wrap; gap: 7px; margin-top: 8px; }.cart-exact-page .current-price { color: var(--deep); font: 900 13px Arial, sans-serif; }.old-price { color: #aaa; font: 9px Arial, sans-serif; text-decoration: line-through; }.save-price { color: var(--green); font: 800 8px Arial, sans-serif; }.item-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 7px; margin-top: 11px; }.item-action { display: inline-flex; align-items: center; gap: 4px; padding: 7px 9px; color: var(--deep); background: var(--blush-light); border-radius: 7px; font: 800 7px Arial, sans-serif; }.item-action .icon { width: 11px; height: 11px; }.item-action.delete { color: #b9505c; background: #fff0f2; }
.cart-exact-page .item-right { display: flex; flex-direction: column; align-items: flex-end; gap: 14px; }.cart-exact-page .quantity { height: 32px; display: flex; align-items: center; overflow: hidden; background: #fff; border: 1px solid var(--border); border-radius: 8px; }.cart-exact-page .quantity button { width: 31px; height: 31px; display: grid; place-items: center; color: var(--deep); background: var(--blush-light); }.cart-exact-page .quantity button .icon { width: 13px; height: 13px; }.cart-exact-page .quantity span { min-width: 32px; color: var(--deep); text-align: center; font: 900 9px Arial, sans-serif; }.cart-exact-page .item-total { color: var(--deep); font: 900 13px Arial, sans-serif; white-space: nowrap; }
.cart-exact-page .summary { position: sticky; top: 96px; padding: 20px; overflow: visible; }.cart-exact-page .summary h2 { padding-bottom: 14px; border-bottom: 1px solid var(--border); font-size: 15px; }.coupon { margin: 16px 0; padding: 12px; background: var(--blush-light); border-radius: 11px; }.coupon-title { display: flex; align-items: center; gap: 6px; color: var(--deep); font: 800 9px Arial, sans-serif; }.coupon-title .icon { width: 13px; height: 13px; color: var(--rose); }.coupon-row { display: flex; gap: 6px; margin-top: 8px; }.coupon-row input { min-width: 0; flex: 1; height: 34px; padding: 0 9px; background: #fff; border: 1px solid var(--border); border-radius: 7px; outline: 0; font-size: 9px; }.coupon-button { height: 34px; padding: 0 11px; color: #fff; background: var(--deep); border-radius: 7px; font-size: 8px; font-weight: 800; }.coupon-message { min-height: 11px; margin-top: 6px; color: var(--green); font: 700 8px Arial, sans-serif; }.coupon-error { color: #b9505c; }.summary-rows { padding-bottom: 12px; border-bottom: 1px solid var(--border); }.cart-exact-page .summary-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 7px 0; color: var(--muted); font: 9px Arial, sans-serif; }.cart-exact-page .summary-row strong { color: var(--deep); }.cart-exact-page .summary-row.discount strong { color: var(--green); }.cart-exact-page .summary-row.delivery strong { color: var(--green); }.cart-exact-page .total-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 15px; padding: 15px 0; border: 0; }.cart-exact-page .total-row span { color: var(--deep); font: 800 11px Arial, sans-serif; }.cart-exact-page .total-row strong { color: var(--deep); font: 900 21px Arial, sans-serif; }.checkout-button { width: 100%; min-height: 46px; display: flex; align-items: center; justify-content: center; gap: 8px; color: #fff; background: var(--deep); border-radius: 10px; box-shadow: 0 8px 20px rgba(77,41,56,.14); font: 900 10px Arial, sans-serif; }.checkout-button .icon { width: 15px; height: 15px; }.secure-note { display: flex; align-items: center; justify-content: center; gap: 6px; margin-top: 11px; color: var(--muted); text-align: center; font: 7px Arial, sans-serif; }.secure-note .icon { width: 12px; height: 12px; color: var(--green); }.payment-methods { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 5px; margin-top: 11px; }.payment { padding: 4px 6px; color: var(--muted); background: #fff; border: 1px solid var(--border); border-radius: 5px; font: 800 6px Arial, sans-serif; }.benefits { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 13px; padding-top: 13px; border-top: 1px solid var(--border); }.benefit { text-align: center; }.benefit-icon { width: 29px; height: 29px; display: grid; place-items: center; margin: auto; color: var(--rose); background: var(--blush-light); border-radius: 8px; }.benefit-icon .icon { width: 14px; height: 14px; }.benefit span { display: block; margin-top: 5px; color: var(--muted); font: 6px/1.3 Arial, sans-serif; }
.cart-exact-page .empty-cart { display: block; padding: 65px 25px; text-align: center; }.cart-exact-page .empty-icon { width: 75px; height: 75px; display: grid; place-items: center; margin: 0 auto 15px; color: var(--rose); background: var(--blush-light); border-radius: 50%; }.cart-exact-page .empty-icon .icon { width: 34px; height: 34px; }.cart-exact-page .empty-cart h2 { color: var(--deep); font: 700 21px Georgia, serif; }.cart-exact-page .empty-cart p { max-width: 350px; margin: 7px auto 17px; color: var(--muted); font: 9px/1.6 Arial, sans-serif; }.shop-button { display: inline-flex; align-items: center; justify-content: center; padding: 10px 17px; color: #fff; background: var(--deep); border-radius: 9px; font: 800 9px Arial, sans-serif; }
.recommendations { margin-top: 25px; }.recommendations h2 { margin-bottom: 12px; color: var(--deep); font: 700 20px Georgia, serif; }.recommend-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }.recommend-card { overflow: hidden; background: #fff; border: 1px solid var(--border); border-radius: 14px; transition: .2s; }.recommend-card:hover { transform: translateY(-2px); box-shadow: var(--shadow); }.recommend-image { height: 125px; display: grid; place-items: center; overflow: hidden; background: linear-gradient(145deg, #fff0f3, #f5dfd9); }.recommend-image img { width: 100%; height: 100%; object-fit: cover; }.recommend-info { padding: 11px; }.recommend-info small { color: var(--rose); font: 800 7px Arial, sans-serif; }.recommend-info strong { display: block; margin-top: 4px; color: var(--deep); font: 900 9px/1.4 Arial, sans-serif; }.recommend-price { margin-top: 6px; color: var(--deep); font: 900 10px Arial, sans-serif; }
@media (max-width: 1000px) { .cart-exact-page .cart-grid { grid-template-columns: minmax(0, 1fr) 310px; }.recommend-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
@media (max-width: 800px) { .cart-exact-page .cart-grid { grid-template-columns: 1fr; }.cart-exact-page .summary { position: static; }.recommend-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
@media (max-width: 650px) { .cart-exact-page { padding: 22px 0 100px; }.cart-exact-page .cart-header { align-items: flex-start; flex-direction: column; }.cart-exact-page .cart-title { font-size: 25px; }.cart-exact-page .cart-item { grid-template-columns: 82px minmax(0, 1fr); gap: 12px; align-items: start; }.cart-exact-page .product-image { width: 82px; height: 82px; }.cart-exact-page .item-right { grid-column: 2; flex-direction: row; align-items: center; justify-content: space-between; width: 100%; }.cart-exact-page .cart-items { padding: 0 13px; }.cart-exact-page .cart-card-header { padding: 15px 13px; }.recommend-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }.recommend-image { height: 110px; } }
@media (max-width: 420px) { .cart-exact-page .cart-item { grid-template-columns: 70px minmax(0, 1fr); }.cart-exact-page .product-image { width: 70px; height: 70px; }.cart-exact-page .product-name { font-size: 10px; }.cart-exact-page .current-price { font-size: 11px; }.cart-exact-page .item-action { padding: 6px 7px; }.benefits { gap: 4px; } }

.weekday-picker {
	position: relative;
	width: 100%;
}

/* Wishlist page — follows the cart page type scale and spacing. */
.wishlist-exact-page { width: min(1400px, calc(100% - 44px)); margin: 0 auto; padding: 20px 0 70px; }
.wishlist-exact-page .breadcrumb { max-width: none; margin: 0 0 20px; padding: 0; font-size: 14px; }
.wishlist-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 24px; }
.wishlist-title { margin-top: 0px; color: var(--deep); font: 700 clamp(32px, 4vw, 50px) Georgia, serif; }
.wishlist-subtitle { margin-top: 8px; color: var(--muted); font: 13px Arial, sans-serif; }
.wishlist-exact-page .continue-shopping { display: inline-flex; align-items: center; gap: 6px; min-height: 42px; padding: 0 16px; color: #fff; background: var(--deep); border-radius: 11px; font: 700 12px Arial, sans-serif; }
.wishlist-exact-page .continue-shopping .icon { width: 16px; height: 16px; }
.wishlist-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; color: var(--deep); font: 700 13px Arial, sans-serif; }
.wishlist-toolbar span { color: var(--rose); }
.wishlist-clear { padding: 7px 10px; color: var(--rose); background: transparent; font: 700 12px Arial, sans-serif; }
.wishlist-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 17px; }
.wishlist-card { overflow: hidden; background: linear-gradient(180deg, #fff, #fffafa); border: 1px solid var(--border); border-radius: 18px; box-shadow: var(--shadow-soft); transition: transform .25s ease, box-shadow .25s ease; }
.wishlist-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
.wishlist-image { position: relative; display: block; aspect-ratio: 1 / 1; overflow: hidden; background: linear-gradient(145deg, #fff0f3, #f5dfd9); }
.wishlist-image img { width: 100%; height: 100%; display: block; object-fit: cover; transition: transform .3s ease; }
.wishlist-card:hover .wishlist-image img { transform: scale(1.045); }
.wishlist-card-info { padding: 14px; }
.wishlist-card-info .product-category { color: var(--rose); font: 700 11px Arial, sans-serif; letter-spacing: .7px; text-transform: uppercase; }
.wishlist-card-info h2 { min-height: 36px; margin-top: 6px; color: var(--deep); font: 650 15px/1.35 Arial, sans-serif; }
.wishlist-rating { margin-top: 8px; color: var(--muted); font: 12px Arial, sans-serif; }
.wishlist-rating span { color: var(--gold); }
.wishlist-price { display: flex; align-items: center; flex-wrap: wrap; gap: 7px; margin-top: 11px; }
.wishlist-price strong { color: var(--deep); font: 800 17px Arial, sans-serif; }
.wishlist-price del { color: #aaa; font: 11px Arial, sans-serif; }
.wishlist-price span { color: var(--green); font: 800 12px Arial, sans-serif; }
.wishlist-actions { display: flex; align-items: center; gap: 7px; margin-top: 14px; }
.wishlist-cart-button { min-height: 38px; display: inline-flex; align-items: center; justify-content: center; gap: 6px; flex: 1; color: #fff; background: var(--deep); border-radius: 11px; font: 700 12px Arial, sans-serif; }
.wishlist-cart-button .icon { width: 16px; height: 16px; }
.wishlist-remove { width: 38px; height: 38px; display: grid; place-items: center; color: var(--rose-dark); background: var(--blush-light); border: 1px solid var(--border); border-radius: 11px; }
.wishlist-remove .icon { width: 15px; height: 15px; }
.wishlist-empty { padding: 70px 25px; text-align: center; background: #fff; border: 1px solid var(--border); border-radius: 21px; box-shadow: var(--shadow-soft); }
.wishlist-empty-icon { width: 80px; height: 80px; display: grid; place-items: center; margin: 0 auto 16px; color: var(--rose); background: var(--blush-light); border-radius: 50%; }
.wishlist-empty-icon .icon { width: 38px; height: 38px; }
.wishlist-empty h2 { color: var(--deep); font: 700 26px Georgia, serif; }
.wishlist-empty p { max-width: 380px; margin: 10px auto 20px; color: var(--muted); font: 13px/1.7 Arial, sans-serif; }
.wishlist-empty .primary-button { display: inline-flex; align-items: center; gap: 7px; margin-top: 0; font: 700 13px Arial, sans-serif; }
.wishlist-empty .primary-button .icon { width: 16px; height: 16px; }
@media (max-width: 1000px) { .wishlist-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
@media (max-width: 700px) { .wishlist-exact-page { padding: 22px 0 100px; }.wishlist-header { align-items: flex-start; flex-direction: column; }.wishlist-title { font-size: 27px; }.wishlist-exact-page .continue-shopping { width: 100%; justify-content: center; }.wishlist-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }.wishlist-card-info { padding: 12px; }.wishlist-card-info h2 { font-size: 13px; }.wishlist-price strong { font-size: 15px; } }
@media (max-width: 420px) { .wishlist-grid { grid-template-columns: 1fr; }.wishlist-card { display: grid; grid-template-columns: 110px minmax(0, 1fr); }.wishlist-image { aspect-ratio: auto; min-height: 100%; }.wishlist-card-info h2 { min-height: auto; }.wishlist-empty { padding: 55px 18px; } }

.weekday-select {
	position: relative;
	width: 100%;
	min-height: 42px;
	padding: 0 38px 0 13px !important;
	color: var(--deep) !important;
	background-color: #fff !important;
	background-image: linear-gradient(45deg, transparent 50%, var(--rose) 50%), linear-gradient(135deg, var(--rose) 50%, transparent 50%);
	background-position: calc(100% - 17px) 18px, calc(100% - 12px) 18px;
	background-repeat: no-repeat;
	background-size: 5px 5px, 5px 5px;
	border: 1px solid var(--border) !important;
	border-radius: 11px !important;
	font: 700 12px Arial, sans-serif;
	text-align: left;
	cursor: pointer;
}

.weekday-select.open {
	border-color: var(--rose) !important;
	border-radius: 11px 11px 0 0 !important;
	box-shadow: 0 0 0 3px rgba(213, 83, 125, .1);
}

.weekday-options {
	position: absolute;
	top: 100%;
	right: 0;
	left: 0;
	z-index: 20;
	overflow: hidden;
	padding: 4px;
	background: #fff;
	border: 1px solid var(--rose);
	border-top: 0;
	border-radius: 0 0 11px 11px;
	box-shadow: 0 12px 24px rgba(74, 39, 52, .15);
}

.weekday-option {
	width: 100%;
	min-height: 34px;
	padding: 8px 10px;
	color: var(--deep);
	background: #fff;
	border-radius: 7px;
	text-align: left;
	font: 600 11px Arial, sans-serif;
}

.weekday-option:hover,
.weekday-option.selected {
	color: var(--rose-dark);
	background: #fff0f4;
}

.weekday-select option {
	padding: 10px;
	color: var(--deep);
	background: #fff;
}

.date-picker { position: relative; width: 100%; }
.date-picker-trigger { width: 100%; min-height: 42px; padding: 0 13px; color: var(--deep); background: #fff; border: 1px solid var(--border); border-radius: 11px; text-align: left; font: 700 12px Arial, sans-serif; }
.date-picker-trigger::after { content: ""; float: right; width: 7px; height: 7px; margin-top: 3px; border-right: 2px solid var(--rose); border-bottom: 2px solid var(--rose); transform: rotate(45deg); }
.date-picker-trigger.open { border-color: var(--rose); border-radius: 11px 11px 0 0; box-shadow: 0 0 0 3px rgba(213,83,125,.1); }
.date-picker-popover { position: absolute; top: 100%; left: 0; right: 0; z-index: 30; padding: 12px; background: #fff; border: 1px solid var(--rose); border-top: 0; border-radius: 0 0 13px 13px; box-shadow: 0 14px 28px rgba(74,39,52,.16); }
.date-picker-header { display: flex; align-items: center; justify-content: space-between; color: var(--deep); font: 700 12px Arial, sans-serif; }
.date-picker-header > div { display: flex; gap: 5px; }
.date-picker-header button, .date-picker-footer button { min-width: 30px; min-height: 28px; color: var(--rose); background: #fff4f7; border-radius: 7px; font: 700 11px Arial, sans-serif; }
.date-picker-weekdays, .date-picker-days { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 4px; margin-top: 12px; text-align: center; }
.date-picker-weekdays { color: var(--muted); font: 700 9px Arial, sans-serif; }
.date-picker-day, .date-picker-empty { min-height: 30px; }
.date-picker-day { color: var(--deep); background: #fff; border-radius: 7px; font: 600 10px Arial, sans-serif; }
.date-picker-day:hover:not(:disabled), .date-picker-day.selected { color: #fff; background: var(--rose); }
.date-picker-day:disabled { color: #c8bec2; background: #fffafa; cursor: not-allowed; }
.date-picker-footer { display: flex; justify-content: space-between; margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--border); }

/* Final mobile cascade: keep the compact layout stable after all legacy overrides. */
@media (max-width: 700px) {
	body { padding-bottom: 0px !important; }
	.navbar { min-height: 0 !important; display: flex !important; flex-wrap: wrap !important; align-items: center !important; gap: 8px !important; padding: 9px 12px !important; }
	.navbar > .logo { flex: 0 0 auto !important; }
	.navbar > .search-box { order: 3 !important; flex: 0 0 100% !important; width: 100% !important; margin: 0 !important; }
	.navbar > .nav-actions { flex: 0 0 auto !important; margin-left: auto !important; }
	.category-nav { top: 102px !important; min-height: 43px !important; padding: 0 36px !important; gap: 0 !important; }
	.category-nav a { min-height: 43px !important; padding: 0 13px !important; font-size: 10px !important; }
	.hero, .section { width: calc(100% - 20px) !important; max-width: calc(100% - 20px) !important; padding: 0 !important; margin: 34px 10px !important; }
	.product-page, .cart-page, .cart-exact-page, .products-page, .wishlist-exact-page, .checkout-exact-page, .confirmation-exact-page, .my-orders-page, .my-account-page, .track-order-page, .breadcrumb { width: calc(100% - 20px) !important; max-width: calc(100% - 20px) !important; }
	.hero-card { grid-template-columns: 1fr !important; border-radius: 22px !important; }
	.hero-content { padding: 32px 20px !important; }
	.hero-art { min-height: 155px !important; }
	.hero-product-photo { width: 84% !important; height: 155px !important; }
	.category-grid, .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; gap: 8px !important; }
	.category-grid { grid-template-columns: repeat(3, minmax(0, 1fr)) !important; }
	.product-image { height: 155px !important; }
	.subscription { width: calc(100% - 20px) !important; max-width: calc(100% - 20px) !important; margin: 34px 10px !important; padding: 34px 12px 38px !important; }
	.pack-grid { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }
	.plans { grid-template-columns: 1fr !important; }
	.modal-overlay { padding: 10px !important; }
	.modal { width: 100% !important; max-width: 100% !important; max-height: calc(100dvh - 20px) !important; padding: 20px 14px !important; }
	.mobile-bottom-nav { left: 8px !important; right: 8px !important; bottom: 8px !important; width: auto !important; height: 62px !important; min-height: 62px !important; max-height: 62px !important; padding: 5px !important; display: grid !important; grid-template-columns: repeat(5, minmax(0, 1fr)) !important; }
	.mobile-bottom-nav-item { min-height: 50px !important; max-height: 50px !important; padding: 4px 2px !important; }
	.footer { padding-bottom: 80px !important; }
}

@media (max-width: 390px) {
	body { padding-bottom: 0px !important; }
	.mobile-bottom-nav { left: 5px !important; right: 5px !important; bottom: 5px !important; height: 60px !important; min-height: 60px !important; max-height: 60px !important; }
	.mobile-bottom-nav-item { min-height: 48px !important; max-height: 48px !important; }
}

@media (max-width: 700px) {
	body { padding-bottom: 0px !important; }
	.mobile-bottom-nav {
		display: grid !important;
		align-items: stretch !important;
		overflow: visible !important;
	}

	.mobile-bottom-nav-item {
		display: flex !important;
		flex-direction: column !important;
		align-items: center !important;
		justify-content: center !important;
		gap: 5px !important;
		height: 50px !important;
		min-height: 50px !important;
		max-height: 50px !important;
		line-height: 1 !important;
		text-align: center !important;
	}

	.mobile-bottom-nav-icon-wrap {
		width: 24px !important;
		height: 24px !important;
		min-width: 24px !important;
		min-height: 24px !important;
		display: flex !important;
		align-items: center !important;
		justify-content: center !important;
		flex: 0 0 24px !important;
	}

	.mobile-bottom-nav-icon-wrap .icon {
		width: 20px !important;
		height: 20px !important;
		min-width: 20px !important;
		min-height: 20px !important;
	}

	.mobile-bottom-nav-label {
		display: block !important;
		width: 100% !important;
		height: 10px !important;
		overflow: hidden !important;
		color: currentColor !important;
		font: 800 9px/10px Arial, sans-serif !important;
		text-align: center !important;
		white-space: nowrap !important;
	}
}

@media (max-width: 390px) {
	.mobile-bottom-nav-item {
		height: 48px !important;
		min-height: 48px !important;
		max-height: 48px !important;
		gap: 3px !important;
	}

	.mobile-bottom-nav-label {
		font-size: 8px !important;
	}
}

.delivery-time-option:disabled {
	opacity: .42 !important;
	color: #b7aeb2 !important;
	background: #fff !important;
	border-color: #eee7e9 !important;
	box-shadow: none !important;
	filter: grayscale(.15) !important;
	transform: none !important;
}

.delivery-time-option:disabled .delivery-time-icon {
	color: #c9c1c4 !important;
	background: #fffafb !important;
}

.delivery-time-option:disabled strong,
.delivery-time-option:disabled small {
	color: #b7aeb2 !important;
}

.delivery-time-option:disabled:hover {
	border-color: #eee7e9 !important;
	transform: none !important;
}

.paygo-product-card.selected {
	border-color: #e3a5b8 !important;
	box-shadow: 0 6px 16px rgba(213, 83, 125, .08) !important;
}

.paygo-add.selected {
	color: #fff !important;
	background: linear-gradient(135deg, #482634, #62394b) !important;
	font-size: 18px;
	font-weight: 900;
}

.delivery-time-option {
	position: relative !important;
}

.delivery-time-check {
	position: absolute !important;
	top: 7px !important;
	right: 7px !important;
	width: 19px !important;
	height: 19px !important;
	display: none !important;
	place-items: center !important;
	border-radius: 50% !important;
	color: #fff !important;
	background: var(--rose) !important;
	font: 900 12px/1 Arial, sans-serif !important;
	z-index: 2 !important;
}

.delivery-time-option.active .delivery-time-check {
	display: grid !important;
}

.delivery-time-option:disabled .delivery-time-check {
	display: none !important;
}

.date-picker-trigger,
.weekday-select {
	position: relative !important;
	padding-right: 42px !important;
}

.date-selection-check {
	position: absolute !important;
	top: 50% !important;
	right: 10px !important;
	width: 19px !important;
	height: 19px !important;
	display: grid !important;
	place-items: center !important;
	border-radius: 50% !important;
	color: #fff !important;
	background: var(--rose) !important;
	font: 900 12px/1 Arial, sans-serif !important;
	transform: translateY(-50%);
}

.paygo-option {
	position: relative !important;
	text-align: left !important;
}

.paygo-check {
	position: absolute !important;
	top: 9px !important;
	right: 9px !important;
	width: 19px !important;
	height: 19px !important;
	display: none !important;
	place-items: center !important;
	border-radius: 50% !important;
	color: #fff !important;
	background: var(--rose) !important;
	font: 900 12px/1 Arial, sans-serif !important;
	z-index: 2 !important;
}

.paygo-option.active .paygo-check {
	display: grid !important;
}

.selected-products-head > strong {
	font-size: 13px !important;
}

.selected-products-head > strong small {
	font-size: 10px !important;
}

.selected-products-head .clear-products {
	font-size: 10px !important;
}

.selected-paygo-info strong {
	font-size: 12px !important;
}

.selected-paygo-info small {
	font-size: 10px !important;
}

.products-page { width: min(1400px, calc(100% - 44px)); margin: auto; padding: 0 0 70px; }
.breadcrumb { width: min(1400px, calc(100% - 44px)); margin: 0 auto 20px; padding: 20px 0 0; color: var(--muted); font: 14px Arial, sans-serif; }
.breadcrumb a { color: var(--rose); }.breadcrumb span { margin: 0 7px; }
.page-heading { display: flex; justify-content: space-between; align-items: end; gap: 20px; padding: 0 0 25px; }
.heading-eyebrow { color: var(--rose); font: 800 11px Arial, sans-serif; letter-spacing: 2px; text-transform: uppercase; }
.page-heading h1 { margin: 7px 0 0; color: var(--deep); font: 700 clamp(32px, 4vw, 50px) Georgia, serif; }
.page-heading p { margin: 8px 0 0; color: var(--muted); font: 13px Arial, sans-serif; }
.shop-layout { display: grid; grid-template-columns: 245px minmax(0, 1fr); gap: 25px; }
.filters { align-self: start; position: sticky; top: 105px; padding: 20px; background: #fff; border: 1px solid var(--border); border-radius: 20px; }
.filter-header, .shop-toolbar, .toolbar-right { display: flex; align-items: center; }.filter-header { justify-content: space-between; padding-bottom: 15px; border-bottom: 1px solid var(--border); }.filter-header strong, .filter-section h3 { color: var(--deep); }.filter-header strong { font: 700 16px Arial, sans-serif; }.clear-filter { color: var(--rose); background: none; font: 12px Arial, sans-serif; }
.filter-section { padding: 18px 0; border-bottom: 1px solid var(--border); }.filter-section:last-child { border-bottom: 0; }.filter-section h3 { margin: 0 0 12px; font: 700 13px Arial, sans-serif; }.filter-option { display: flex; align-items: center; gap: 9px; margin: 9px 0; color: var(--muted); font: 12px Arial, sans-serif; cursor: pointer; }.filter-option input { accent-color: var(--rose); }
.price-inputs { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; }.price-inputs input { width: 100%; height: 35px; padding: 0 9px; border: 1px solid var(--border); border-radius: 8px; outline: 0; font-size: 11px; }.apply-price { width: 100%; height: 35px; margin-top: 8px; color: #fff; background: var(--deep); border-radius: 8px; font-size: 11px; font-weight: 700; }
.shop-toolbar { justify-content: space-between; gap: 12px; margin-bottom: 17px; }.results { color: var(--muted); font: 12px Arial, sans-serif; }.toolbar-right { gap: 8px; }.mobile-filter { display: none; align-items: center; gap: 6px; padding: 9px 13px; color: var(--deep); background: var(--blush-light); border-radius: 20px; font-size: 12px; font-weight: 700; }.mobile-filter .icon { width: 14px; }.sort-select { height: 38px; padding: 0 30px 0 12px; color: var(--deep); background: #fff; border: 1px solid var(--border); border-radius: 10px; outline: 0; font-size: 12px; }
.products-page .product-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 17px; }.products-page .product-card { padding: 9px; background: #fff; border: 1px solid var(--border); border-radius: 21px; transition: transform .25s, box-shadow .25s; }.products-page .product-card:hover { box-shadow: 0 22px 45px rgba(74, 39, 52, .16); }.products-page .product-image { position: relative; height: 235px; overflow: hidden; display: grid; place-items: center; background: linear-gradient(145deg, #fff1f4, #f2e3cf); border-radius: 16px; }.products-page .product-photo { width: 100%; height: 100%; object-fit: cover; }.products-page .product-badge { position: absolute; top: 10px; left: 10px; z-index: 1; padding: 5px 8px; color: #fff; background: var(--rose); border-radius: 8px; font: 800 9px Arial, sans-serif; }.products-page .wishlist-button { top: 10px; right: 10px; }.products-page .product-info { padding: 4px 4px 2px; }.products-page .product-category { margin-top: 8px; color: var(--rose); font: 700 11px Arial, sans-serif; letter-spacing: .7px; text-transform: uppercase; }.products-page .product-title { min-height: 36px; margin: 5px 0 0; color: var(--deep); font: 650 15px/1.35 Arial, sans-serif; }.products-page .price { display: flex; align-items: baseline; gap: 6px; font: 800 17px Arial, sans-serif; }.products-page .discount { color: #4c8b65; font-size: 12px; font-weight: 800; }.card-actions { display: grid; grid-template-columns: 1fr 40px; gap: 7px; margin-top: 10px; }.products-page .quick-view { height: 38px; display: grid; place-items: center; color: #fff; background: var(--deep); border-radius: 10px; }.quick-view .icon { width: 16px; height: 16px; }.empty-products { padding: 65px 15px; color: var(--muted); text-align: center; font: 13px Arial, sans-serif; }
.pagination { display: flex; justify-content: center; align-items: center; gap: 7px; margin-top: 35px; }.page-btn { width: 36px; height: 36px; display: grid; place-items: center; color: var(--deep); background: #fff; border: 1px solid var(--border); border-radius: 10px; font-size: 11px; }.page-btn.active, .page-btn:hover { color: #fff; background: var(--deep); border-color: var(--deep); }
.products-page .trust-banner { margin-top: 60px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; padding: 25px; background: var(--blush-light); border-radius: 23px; }.products-page .trust-item { display: flex; align-items: center; gap: 11px; }.products-page .trust-item .icon { width: 24px; height: 24px; color: var(--gold); }.products-page .trust-item strong, .products-page .trust-item span { display: block; }.products-page .trust-item strong { color: var(--deep); font: 700 12px Arial, sans-serif; }.products-page .trust-item span { margin-top: 3px; color: var(--muted); font: 10px Arial, sans-serif; }
.product-quick-modal { text-align: left; }.product-quick-modal .modal-icon { width: 100%; height: 230px; }.product-quick-modal .modal-icon img { width: 100%; height: 100%; object-fit: contain; border-radius: 13px; }

@media (max-width: 1100px) { .products-page .product-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }.shop-layout { grid-template-columns: 215px minmax(0, 1fr); }.products-page .trust-banner { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 850px) { .shop-layout { grid-template-columns: 1fr; }.filters { display: none; position: fixed; top: 0; left: 0; z-index: 3500; width: min(320px, 90vw); height: 100vh; overflow: auto; border-radius: 0; }.filters.mobile-open { display: block; }.mobile-filter { display: inline-flex; } }
@media (max-width: 600px) { .breadcrumb { padding: 16px 0 0; }.products-page { padding: 0 0 50px; }.page-heading { align-items: flex-start; flex-direction: column; }.shop-toolbar { align-items: flex-start; flex-direction: column; }.toolbar-right { width: 100%; justify-content: space-between; }.sort-select { flex: 1; }.products-page .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }.products-page .product-image { height: 180px; }.products-page .product-title { font-size: 13px; }.products-page .price { font-size: 15px; }.products-page .card-actions { grid-template-columns: 1fr; }.products-page .quick-view { display: none; }.products-page .trust-banner { grid-template-columns: 1fr; } }
/* =====================================================================
   CART ↔ PRODUCT PAGE PARITY LAYER
   The Product Page (.products-page) is the source of truth. These final
   rules lift the cart's cramped scale up to the shared design system.
   Colour/theme tokens are untouched — dimensions and type scale only.
   ===================================================================== */

/* Container + breadcrumb already aligned above (1400px / 20px 22px 70px). */

/* Free-delivery progress strip -> trust-banner rhythm, readable 13px */
.cart-exact-page .delivery-progress { margin-bottom: 25px; padding: 17px 19px; border-radius: 18px; }
.delivery-progress-top { margin-bottom: 10px; font: 600 13px Arial, sans-serif; }
.progress-track { height: 7px; }

/* Two-column body matches Product Page card radius + 17px gap rhythm */
.cart-exact-page .cart-grid { gap: 25px; }
.cart-exact-page .cart-card, .cart-exact-page .summary { border-radius: 21px; }
.cart-exact-page .cart-card-header { padding: 19px 22px; }
.cart-exact-page .cart-card-header h2, .cart-exact-page .summary h2 { font: 700 18px Georgia, serif; }
.cart-exact-page .select-all { font: 700 12px Arial, sans-serif; }

/* Cart line-items -> Product Page card typography scale */
.cart-exact-page .cart-items { padding: 0 22px; }
.cart-exact-page .cart-item { grid-template-columns: 110px minmax(0, 1fr) auto; gap: 17px; padding: 20px 0; }
.cart-exact-page .product-image { width: 110px; height: 110px; border-radius: 16px; }
.discount-badge { top: 8px; left: 8px; padding: 5px 8px; border-radius: 8px; font: 800 9px Arial, sans-serif; }
.cart-exact-page .product-category { font: 700 11px Arial, sans-serif; letter-spacing: .7px; }
.cart-exact-page .product-name { margin-top: 6px; font: 650 15px/1.35 Arial, sans-serif; }
.cart-exact-page .product-description { margin-top: 6px; font: 12px/1.6 Arial, sans-serif; }
.product-meta { gap: 8px; margin-top: 10px; }
.meta-pill { padding: 5px 8px; border-radius: 7px; font: 700 10px Arial, sans-serif; }
.price-row { gap: 8px; margin-top: 10px; }
.cart-exact-page .current-price { font: 800 17px Arial, sans-serif; }
.cart-exact-page .old-price { font: 400 11px Arial, sans-serif; }
.save-price { font: 800 12px Arial, sans-serif; }
.item-actions { gap: 9px; margin-top: 14px; }
.item-action { padding: 9px 13px; border-radius: 11px; font: 700 12px Arial, sans-serif; }
.item-action .icon { width: 15px; height: 15px; }

/* Quantity + line total -> shared .quantity / .price sizing */
.cart-exact-page .quantity { height: 42px; border-radius: 11px; }
.cart-exact-page .quantity button { width: 40px; height: 40px; }
.cart-exact-page .quantity button .icon { width: 16px; height: 16px; }
.cart-exact-page .quantity span { min-width: 40px; font: 800 14px Arial, sans-serif; }
.cart-exact-page .item-right { gap: 16px; }
.cart-exact-page .item-total { font: 800 17px Arial, sans-serif; }

/* Order summary -> filter-card / checkout sizing, sticky like .filters */
.cart-exact-page .summary { top: 105px; padding: 22px; }
.cart-exact-page .summary h2 { padding-bottom: 16px; }
.coupon { margin: 18px 0; padding: 14px; border-radius: 14px; }
.coupon-title { gap: 7px; font: 800 12px Arial, sans-serif; }
.coupon-title .icon { width: 16px; height: 16px; }
.coupon-row { gap: 8px; margin-top: 10px; }
.coupon-row input { height: 42px; padding: 0 12px; border-radius: 10px; font-size: 13px; }
.coupon-button { height: 42px; padding: 0 16px; border-radius: 10px; font-size: 12px; font-weight: 700; }
.coupon-message { min-height: 14px; margin-top: 8px; font: 700 11px Arial, sans-serif; }
.summary-rows { padding-bottom: 14px; }
.cart-exact-page .summary-row { padding: 9px 0; font: 13px Arial, sans-serif; }
.cart-exact-page .total-row { padding: 18px 0; }
.cart-exact-page .total-row span { font: 800 15px Arial, sans-serif; }
.cart-exact-page .total-row strong { font: 800 28px Arial, sans-serif; }
.checkout-button { min-height: 50px; gap: 10px; border-radius: 13px; font: 800 15px Arial, sans-serif; }
.checkout-button .icon { width: 18px; height: 18px; }
.secure-note { margin-top: 14px; font: 12px Arial, sans-serif; gap: 6px; }
.secure-note .icon { width: 14px; height: 14px; }
.payment-methods { margin-top: 16px; gap: 8px; }
.payment { padding: 7px 11px; border-radius: 9px; font: 800 11px Arial, sans-serif; }
.benefits { margin-top: 18px; gap: 10px; }
.benefit { padding: 12px; border-radius: 13px; font: 700 12px Arial, sans-serif; }
.benefit-icon { width: 38px; height: 38px; }
.benefit-icon .icon { width: 19px; height: 19px; }

/* Empty state -> .empty-products rhythm */
.cart-exact-page .empty-cart { padding: 70px 25px; }
.cart-exact-page .empty-icon { width: 84px; height: 84px; margin-bottom: 18px; }
.cart-exact-page .empty-icon .icon { width: 38px; height: 38px; }
.cart-exact-page .empty-cart h2 { font: 700 26px Georgia, serif; }
.cart-exact-page .empty-cart p { max-width: 380px; margin: 10px auto 20px; font: 13px/1.7 Arial, sans-serif; }
.shop-button { padding: 12px 22px; border-radius: 13px; font: 700 13px Arial, sans-serif; }

/* Recommendations -> exact .products-page card grid (4-col, 17px, 235px image) */
.recommendations { margin-top: 60px; }
.recommendations h2 { margin-bottom: 20px; font: 700 30px Georgia, serif; }
.recommend-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 17px; }
.recommend-card { padding: 9px; border-radius: 21px; transition: transform .25s, box-shadow .25s; }
.recommend-card:hover { transform: translateY(-5px); box-shadow: var(--shadow); }
.recommend-image { height: 235px; border-radius: 16px; background: linear-gradient(145deg, #fff1f4, #f2e3cf); }
.recommend-info { padding: 4px 4px 2px; }
.recommend-info small { margin-top: 8px; display: block; color: var(--rose); font: 700 9px Arial, sans-serif; letter-spacing: .7px; text-transform: uppercase; }
.recommend-info strong { margin-top: 5px; color: var(--deep); font: 650 14px/1.35 Arial, sans-serif; }
.recommend-price { margin-top: 8px; font: 800 17px Arial, sans-serif; }

/* Responsive: mirrors Product Page breakpoints, intentional (not shrunk) mobile */
@media (max-width: 1100px) { .recommend-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
@media (max-width: 1000px) { .cart-exact-page .cart-grid { grid-template-columns: minmax(0, 1fr) 330px; } }
@media (max-width: 850px) { .cart-exact-page .cart-grid { grid-template-columns: 1fr; } .cart-exact-page .summary { position: static; top: auto; } .recommend-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
@media (max-width: 600px) {
.cart-exact-page { padding: 15px 0 50px; }
.cart-exact-page .breadcrumb { padding: 0 0 14px; }
.cart-exact-page .cart-header { align-items: flex-start; flex-direction: column; gap: 14px; }
.cart-exact-page .cart-item { grid-template-columns: 88px minmax(0, 1fr); gap: 13px; align-items: start; }
.cart-exact-page .product-image { width: 88px; height: 88px; }
.cart-exact-page .item-right { grid-column: 1 / -1; flex-direction: row; align-items: center; justify-content: space-between; width: 100%; }
.cart-exact-page .cart-items { padding: 0 15px; }
.cart-exact-page .cart-card-header { padding: 17px 15px; }
.recommend-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
.recommend-image { height: 180px; }
.recommend-info strong { font-size: 12px; }
.recommend-price { font-size: 14px; }
}
@media (max-width: 420px) {
.cart-exact-page .cart-item { grid-template-columns: 76px minmax(0, 1fr); }
.cart-exact-page .product-image { width: 76px; height: 76px; }
.cart-exact-page .product-name { font-size: 13px; }
.cart-exact-page .current-price { font-size: 15px; }
}

/* =====================================================================
   3D EFFECTS LAYER
   Perspective transforms, depth shadows, and press feedback layered on
   top of the base design system. All motion collapses gracefully under
   the prefers-reduced-motion rule defined earlier in this file.
   ===================================================================== */

/* Buttons — tactile 3D press */
.primary-button, .add-cart, .checkout, .plan-button, .cart-button, .buy-button, .checkout-button, .shop-button, .continue-shopping, .coupon-button, .check-btn, .apply-price, .search-view-button { transition: transform .18s ease, box-shadow .18s ease, filter .18s ease; }
.primary-button:hover, .cart-button:hover, .checkout-button:hover, .shop-button:hover, .continue-shopping:hover { transform: translateY(-2px); filter: brightness(1.06); }
.primary-button:active, .add-cart:active, .checkout:active, .plan-button:active, .cart-button:active, .buy-button:active, .checkout-button:active, .shop-button:active, .continue-shopping:active, .coupon-button:active, .check-btn:active, .apply-price:active { transform: translateY(1px) scale(.98); box-shadow: 0 3px 8px rgba(74, 39, 52, .18); }
.buy-button:hover { transform: translateY(-2px); box-shadow: 0 14px 28px rgba(77, 41, 56, .24); }

/* Product cards — hover lift + inner depth layers on top of JS tilt */
.product-card:hover { box-shadow: 0 24px 48px rgba(74, 39, 52, .17), 0 8px 16px rgba(74, 39, 52, .08); }
.product-card .product-info { transition: transform .25s ease; }
.product-card:hover .product-info { transform: translateZ(16px); }
.product-card:hover .add-cart { transform: translateZ(20px); }

/* Sheen sweep on card hover — sells the depth */
.product-card::after, .category-card::after, .plan::after, .recommend-card::after { content: ""; position: absolute; top: 0; left: -80%; z-index: 3; width: 55%; height: 100%; background: linear-gradient(105deg, transparent, rgba(255, 255, 255, .35), transparent); transform: skewX(-18deg); pointer-events: none; transition: left .55s ease; }
.product-card:hover::after, .category-card:hover::after, .plan:hover::after, .recommend-card:hover::after { left: 130%; }

/* Recommendations — match the 3D card treatment */
.recommend-card { transform-style: preserve-3d; transition: transform .25s cubic-bezier(.25,.46,.45,.94), box-shadow .25s ease; }
.recommend-card:hover { transform: perspective(800px) rotateX(4deg) rotateY(-4deg) translateY(-6px) scale(1.02); box-shadow: 0 22px 45px rgba(74, 39, 52, .16); }

/* Offer banner — lifts toward the viewer */
.offer-banner { transition: transform .3s ease, box-shadow .3s ease; }
.offer-banner:hover { transform: perspective(1200px) rotateX(2deg) translateY(-4px); box-shadow: 0 26px 52px rgba(71, 37, 49, .28); }

/* Subscription block — slow breathing float for depth */
@keyframes pp-breathe { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
.subscription { transform-style: preserve-3d; animation: pp-breathe 7s ease-in-out infinite; }

/* Hero copy lifts off the card with the photo */
.hero-content { transform: translateZ(30px); transition: transform .4s ease; }
.hero-card:hover .hero-content { transform: translateZ(46px); }
.hero-card { transition: transform .4s ease; }

/* Toolbar pills and nav icons — small 3D nudge */
.filter-btn, .icon-button, .wishlist-button, .plan-button { transition: transform .18s ease, box-shadow .18s ease; }
.filter-btn:hover, .plan-button:hover { transform: translateY(-2px); box-shadow: 0 8px 18px rgba(74, 39, 52, .12); }
.wishlist-button:hover, .gallery-wishlist:hover { transform: translateY(-2px) scale(1.08); box-shadow: 0 10px 22px rgba(72, 39, 53, .16); }
.wishlist-button:active, .gallery-wishlist:active { transform: scale(.9); }
.icon-button:active { transform: translateY(1px) scale(.94); }

/* Category icon already lifts via preserve-3d parent; polish the base */
.category-icon { transition: transform .3s ease; transform-style: preserve-3d; }
.trust-icon { transition: transform .3s ease; }

/* Disable tilt + sheen on touch-friendly small screens */
@media (hover: none) {
	.product-card { transform: none !important; }
	.product-card::after, .category-card::after, .plan::after, .recommend-card::after { display: none; }
	.hero-product-photo { transform: none; }
	.hero-card:hover .hero-product-photo { transform: none; }
	.subscription { animation: none; }
}

/* ========= CHECKOUT PAGE ========= */
.checkout-exact-page { width: min(1400px, calc(100% - 44px)); margin: 0 auto; padding: 20px 0 70px; }
.checkout-exact-page .breadcrumb, .confirmation-exact-page .breadcrumb { max-width: none; margin: 0 0 20px; padding: 0; font-size: 14px; }
.checkout-heading { margin-bottom: 22px; }
.checkout-heading h1 { margin: 0; color: var(--deep); font: 700 clamp(32px, 4vw, 50px) Georgia, serif; }
.checkout-heading p { margin-top: 8px; color: var(--muted); font: 13px Arial, sans-serif; }
.checkout-layout { display: grid; grid-template-columns: minmax(0, 1fr) 390px; gap: 22px; align-items: start; }
.checkout-left { display: flex; flex-direction: column; gap: 18px; }
.checkout-card { padding: 22px; background: #fff; border: 1px solid var(--border); border-radius: 20px; box-shadow: 0 5px 20px rgba(90, 48, 68, .04); }
.card-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 18px; }
.card-heading h2 { display: flex; align-items: center; gap: 10px; color: var(--deep); font: 700 18px Georgia, serif; }
.card-heading small { color: var(--muted); font: 11px Arial, sans-serif; }
.number { width: 28px; height: 28px; display: grid; place-items: center; border-radius: 50%; background: var(--blush); color: var(--deep); font-size: 11px; font-weight: 800; }
.form-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
.form-group { display: flex; flex-direction: column; gap: 6px; }
.form-group.full { grid-column: 1 / -1; }
.form-group label { color: var(--deep); font: 700 11px Arial, sans-serif; }
.form-group label span { color: var(--rose); }
.form-group input, .form-group select, .form-group textarea { width: 100%; min-height: 44px; padding: 0 13px; border: 1px solid var(--border); border-radius: 10px; outline: none; background: #fffafb; color: var(--deep); font: 12px Arial, sans-serif; transition: border-color .2s, box-shadow .2s; }
.form-group textarea { padding-top: 12px; resize: vertical; min-height: 88px; }
.form-group input:focus, .form-group select:focus, .form-group textarea:focus { border-color: var(--rose); box-shadow: 0 0 0 3px rgba(213, 83, 125, .12); }
.address-options { display: grid; grid-template-columns: repeat(2, 1fr); gap: 11px; margin-bottom: 18px; }
.address-option { text-align: left; padding: 14px; border: 1px solid var(--border); border-radius: 14px; cursor: pointer; background: #fff; transition: border-color .2s, background .2s; }
.address-option.active { border-color: var(--rose); background: var(--blush-light); }
.address-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.address-top strong { color: var(--deep); font: 700 12px Arial, sans-serif; }
.address-type { padding: 3px 7px; border-radius: 6px; background: var(--blush); color: var(--rose-dark); font: 800 9px Arial, sans-serif; letter-spacing: .04em; }
.address-option p { margin-top: 8px; color: var(--muted); font: 11px/1.5 Arial, sans-serif; }
.delivery-options { display: grid; gap: 10px; }
.delivery-option { display: flex; align-items: center; gap: 13px; width: 100%; text-align: left; padding: 14px; border: 1px solid var(--border); border-radius: 12px; cursor: pointer; background: #fff; transition: border-color .2s, background .2s; }
.delivery-option:hover { border-color: var(--blush); }
.delivery-option.active { border-color: var(--rose); background: var(--blush-light); }
.delivery-icon { width: 38px; height: 38px; display: grid; place-items: center; flex-shrink: 0; border-radius: 10px; background: var(--blush); color: var(--deep); }
.delivery-icon .icon { width: 18px; height: 18px; }
.delivery-info { flex: 1; min-width: 0; }
.delivery-info strong { display: block; color: var(--deep); font: 700 12px Arial, sans-serif; }
.delivery-info span { display: block; margin-top: 4px; color: var(--muted); font: 10px Arial, sans-serif; }
.delivery-price { flex-shrink: 0; color: var(--deep); font: 800 11px Arial, sans-serif; }
.payment-options { display: grid; gap: 9px; }
.payment-option { display: flex; align-items: center; gap: 12px; width: 100%; text-align: left; padding: 14px; border: 1px solid var(--border); border-radius: 12px; cursor: pointer; background: #fff; transition: border-color .2s, background .2s; }
.payment-option:hover { border-color: var(--blush); }
.payment-option.active { border-color: var(--rose); background: var(--blush-light); }
.payment-icon { width: 38px; height: 38px; display: grid; place-items: center; flex-shrink: 0; border-radius: 9px; background: var(--blush-light); color: var(--deep); }
.payment-icon .icon { width: 18px; height: 18px; }
.payment-info { flex: 1; min-width: 0; }
.payment-info strong { display: block; color: var(--deep); font: 700 12px Arial, sans-serif; }
.payment-info span { display: block; margin-top: 3px; color: var(--muted); font: 10px Arial, sans-serif; }
.payment-check { color: var(--rose); }
.terms { display: flex; align-items: flex-start; gap: 9px; margin-top: 12px; color: var(--muted); font: 11px/1.5 Arial, sans-serif; cursor: pointer; }
.terms input { margin-top: 2px; accent-color: var(--rose); }
.terms a { color: var(--rose); text-decoration: underline; text-underline-offset: 2px; }
.checkout-exact-page .co-summary, .confirmation-exact-page .co-summary { position: sticky; top: 105px; padding: 22px; background: #fff; border: 1px solid var(--border); border-radius: 20px; box-shadow: var(--shadow); }
.checkout-exact-page .co-summary h2, .confirmation-exact-page .co-summary h2 { padding-bottom: 16px; border-bottom: 1px solid var(--border); color: var(--deep); font: 700 18px Georgia, serif; }
.checkout-exact-page .order-items, .confirmation-exact-page .order-items { padding: 14px 0; }
.checkout-exact-page .order-item, .confirmation-exact-page .order-item { display: flex; gap: 11px; align-items: center; margin-bottom: 14px; }
.checkout-exact-page .order-item:last-child, .confirmation-exact-page .order-item:last-child { margin-bottom: 0; }
.checkout-exact-page .order-image, .confirmation-exact-page .order-image { width: 60px; height: 60px; display: grid; place-items: center; flex-shrink: 0; border-radius: 11px; background: linear-gradient(145deg, #fff2f5, #f4ddd7); color: var(--gold); overflow: hidden; }
.checkout-exact-page .order-image img, .confirmation-exact-page .order-image img { width: 100%; height: 100%; object-fit: cover; }
.checkout-exact-page .order-image .icon, .confirmation-exact-page .order-image .icon { width: 26px; height: 26px; }
.checkout-exact-page .order-details, .confirmation-exact-page .order-details { flex: 1; min-width: 0; }
.checkout-exact-page .order-details strong, .confirmation-exact-page .order-details strong { display: block; color: var(--deep); font: 700 11px/1.4 Arial, sans-serif; }
.checkout-exact-page .order-details span, .confirmation-exact-page .order-details span { display: block; margin-top: 4px; color: var(--muted); font: 10px Arial, sans-serif; }
.checkout-exact-page .order-price, .confirmation-exact-page .order-price { flex-shrink: 0; color: var(--deep); font: 800 11px Arial, sans-serif; }
.checkout-exact-page .summary-empty, .confirmation-exact-page .summary-empty { padding: 10px 0; color: var(--muted); font: 11px/1.6 Arial, sans-serif; }
.checkout-exact-page .co-coupon { display: flex; gap: 8px; margin: 6px 0 8px; }
.checkout-exact-page .co-coupon input { flex: 1; height: 42px; padding: 0 12px; border: 1px solid var(--border); border-radius: 10px; outline: none; background: #fffafb; color: var(--deep); font: 11px Arial, sans-serif; }
.checkout-exact-page .co-coupon input:focus { border-color: var(--rose); box-shadow: 0 0 0 3px rgba(213, 83, 125, .1); }
.checkout-exact-page .co-coupon button { padding: 0 16px; border-radius: 10px; background: var(--blush); color: var(--deep); font: 800 11px Arial, sans-serif; white-space: nowrap; transition: background .15s; }
.checkout-exact-page .co-coupon button:hover { background: #f2c8d6; }
.checkout-exact-page .co-coupon-message { color: var(--green); font: 700 11px Arial, sans-serif; }
.checkout-exact-page .co-coupon-message.error { color: #b9505c; }
.checkout-exact-page .price-lines, .confirmation-exact-page .price-lines { padding-top: 16px; border-top: 1px solid var(--border); }
.checkout-exact-page .price-line, .confirmation-exact-page .price-line { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; color: var(--muted); font: 13px Arial, sans-serif; }
.checkout-exact-page .price-line strong, .confirmation-exact-page .price-line strong { color: var(--deep); }
.checkout-exact-page .price-line.discount, .confirmation-exact-page .price-line.discount { color: var(--green); }
.checkout-exact-page .price-line.discount strong, .confirmation-exact-page .price-line.discount strong { color: var(--green); }
.checkout-exact-page .price-line.total, .confirmation-exact-page .price-line.total { margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--border); color: var(--deep); font: 800 28px Arial, sans-serif; }
.checkout-exact-page .place-order { width: 100%; margin-top: 16px; padding: 15px; border-radius: 12px; background: var(--deep); color: #fff; font: 800 15px Arial, sans-serif; transition: background .2s, transform .15s; }
.checkout-exact-page .place-order:hover:not(:disabled) { background: var(--rose-dark); transform: translateY(-1px); }
.checkout-exact-page .place-order:disabled { opacity: .45; cursor: not-allowed; transform: none; }
.checkout-exact-page .summary-trust, .confirmation-exact-page .summary-trust { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 14px; }
.checkout-exact-page .summary-trust-item, .confirmation-exact-page .summary-trust-item { padding: 10px 6px; border-radius: 10px; background: var(--blush-light); text-align: center; }
.checkout-exact-page .summary-trust-item .icon, .confirmation-exact-page .summary-trust-item .icon { width: 17px; height: 17px; margin: auto; color: var(--gold); }
.checkout-exact-page .summary-trust-item span, .confirmation-exact-page .summary-trust-item span { display: block; margin-top: 6px; color: var(--muted); font: 600 9px Arial, sans-serif; }
.success-overlay { position: fixed; inset: 0; z-index: 4000; display: grid; place-items: center; padding: 20px; background: rgba(40, 20, 30, .42); opacity: 0; pointer-events: none; transition: opacity .25s; }
.success-overlay.show { opacity: 1; pointer-events: auto; }
.success-box { width: min(460px, 100%); padding: 32px; background: #fff; border-radius: 24px; text-align: center; box-shadow: 0 25px 70px rgba(0, 0, 0, .18); }
.success-icon { width: 64px; height: 64px; display: grid; place-items: center; margin: 0 auto 16px; border-radius: 50%; background: var(--blush); color: var(--green); }
.success-icon .icon { width: 28px; height: 28px; }
.success-box h2 { color: var(--deep); font: 700 26px Georgia, serif; }
.success-box p { margin-top: 10px; color: var(--muted); font-size: 12px; line-height: 1.6; }
.success-box button { width: 100%; margin-top: 20px; padding: 13px; border-radius: 11px; background: var(--deep); color: #fff; font-size: 11px; font-weight: 800; transition: background .2s; }
.success-box button:hover { background: var(--rose-dark); }
@media (max-width: 900px) { .checkout-layout, .confirmation-grid { grid-template-columns: 1fr; } .checkout-exact-page .co-summary, .confirmation-exact-page .co-summary { position: static; } }
@media (max-width: 600px) { .checkout-exact-page, .confirmation-exact-page { padding: 16px 0 48px; } .checkout-card, .confirmation-card { padding: 16px; border-radius: 16px; } .form-grid { grid-template-columns: 1fr; } .address-options { grid-template-columns: 1fr; } .confirmation-hero { padding: 28px 16px; } }

/* ========= ORDER CONFIRMATION ========= */
@keyframes successPop { 0% { transform: scale(.5); opacity: 0; } 70% { transform: scale(1.08); } 100% { transform: scale(1); opacity: 1; } }

.confirmation-exact-page { width: min(1400px, calc(100% - 44px)); margin: 0 auto; padding: 20px 0 70px; }
.confirmation-loading { display: grid; place-items: center; gap: 12px; padding: 80px 20px; color: var(--muted); font: 600 13px Arial, sans-serif; }
.confirmation-spinner { width: 26px; height: 26px; border: 3px solid var(--border); border-top-color: var(--rose); border-radius: 50%; animation: spin .8s linear infinite; }

/* SUCCESS HERO */
.cn-success { position: relative; overflow: hidden; padding: 48px 30px 42px; border: 1px solid var(--border); border-radius: 28px; background: #fff; text-align: center; box-shadow: var(--shadow); }
.cn-success::before { content: ""; position: absolute; width: 250px; height: 250px; left: -100px; top: -120px; border-radius: 50%; background: rgba(247, 213, 223, .35); }
.cn-success::after { content: ""; position: absolute; width: 200px; height: 200px; right: -90px; bottom: -100px; border-radius: 50%; background: rgba(247, 213, 223, .25); }
.cn-success-icon { position: relative; z-index: 2; width: 82px; height: 82px; display: grid; place-items: center; margin: 0 auto 20px; border-radius: 50%; background: var(--blush); color: var(--green); animation: successPop .6s ease both; }
.cn-success-icon .icon { width: 37px; height: 37px; stroke-width: 2.2; }
.cn-success small { position: relative; z-index: 2; color: var(--rose); font: 800 10px Arial, sans-serif; letter-spacing: 2px; text-transform: uppercase; }
.cn-success h1 { position: relative; z-index: 2; margin-top: 9px; color: var(--deep); font: 700 clamp(31px, 5vw, 46px) Georgia, serif; }
.cn-success > p { position: relative; z-index: 2; max-width: 570px; margin: 10px auto 0; color: var(--muted); font: 13px/1.7 Arial, sans-serif; }
.cn-order-id { position: relative; z-index: 2; display: inline-flex; align-items: center; gap: 7px; margin-top: 19px; padding: 9px 14px; border-radius: 30px; background: var(--blush-light); color: var(--deep); font: 800 11px Arial, sans-serif; }
.cn-order-id span { color: var(--rose); }
.cn-hero-buttons { position: relative; z-index: 2; display: flex; justify-content: center; gap: 9px; flex-wrap: wrap; margin-top: 23px; }
.cn-btn { min-width: 150px; padding: 12px 18px; border-radius: 11px; font: 800 11px Arial, sans-serif; transition: .2s; cursor: pointer; border: 0; }
.cn-btn-primary { background: var(--deep); color: #fff; }
.cn-btn-primary:hover { background: var(--rose-dark); transform: translateY(-2px); }
.cn-btn-secondary { background: var(--blush-light); color: var(--deep); }
.cn-btn-secondary:hover { background: var(--blush); }

/* CONTENT GRID */
.cn-grid { display: grid; grid-template-columns: minmax(0, 1fr) 350px; gap: 22px; margin-top: 22px; align-items: start; }

/* CARD */
.cn-card { padding: 21px; background: #fff; border: 1px solid var(--border); border-radius: 20px; box-shadow: var(--shadow-soft); }
.cn-card + .cn-card { margin-top: 20px; }
.cn-card-title { display: flex; justify-content: space-between; align-items: center; padding-bottom: 15px; border-bottom: 1px solid var(--border); }
.cn-card-title h2 { color: var(--deep); font: 700 16px Georgia, serif; }
.cn-card-title span { color: var(--muted); font: 9px Arial, sans-serif; }

/* PRODUCTS */
.cn-product { display: flex; align-items: center; gap: 12px; padding: 15px 0; border-bottom: 1px solid var(--border); }
.cn-product:last-of-type { border-bottom: 0; }
.cn-product-img { width: 66px; height: 66px; flex-shrink: 0; display: grid; place-items: center; border-radius: 12px; background: linear-gradient(145deg, #fff2f5, #f4ddd7); color: var(--gold); }
.cn-product-img .icon { width: 31px; height: 31px; }
.cn-product-img img { width: 100%; height: 100%; object-fit: cover; border-radius: 12px; }
.cn-product-info { flex: 1; min-width: 0; }
.cn-product-info strong { display: block; color: var(--deep); font: 800 12px/1.4 Arial, sans-serif; }
.cn-product-info span { display: block; margin-top: 4px; color: var(--muted); font: 9px Arial, sans-serif; }
.cn-product-price { color: var(--deep); font: 800 12px Arial, sans-serif; flex-shrink: 0; }

/* DELIVERY STATUS BOX */
.cn-status { margin-top: 20px; padding: 16px; border-radius: 14px; background: var(--blush-light); }
.cn-status-top { display: flex; align-items: center; justify-content: space-between; }
.cn-status-label { display: flex; align-items: center; gap: 8px; color: var(--deep); font: 800 11px Arial, sans-serif; }
.cn-status-label .icon { width: 18px; height: 18px; color: var(--green); }
.cn-status-date { color: var(--rose); font: 800 10px Arial, sans-serif; }
.cn-status > p { margin-top: 7px; color: var(--muted); font: 9px/1.5 Arial, sans-serif; }

/* TIMELINE */
.cn-timeline { margin-top: 20px; padding-top: 4px; }
.cn-tl-item { position: relative; display: flex; gap: 12px; min-height: 58px; }
.cn-tl-item:not(:last-child)::before { content: ""; position: absolute; left: 10px; top: 22px; width: 1px; height: 44px; background: var(--border); }
.cn-tl-dot { position: relative; z-index: 2; width: 21px; height: 21px; flex-shrink: 0; display: grid; place-items: center; border-radius: 50%; background: var(--blush); color: var(--rose); }
.cn-tl-dot .icon { width: 11px; height: 11px; }
.cn-tl-item.completed .cn-tl-dot { background: var(--rose); color: #fff; }
.cn-tl-content strong { display: block; color: var(--deep); font: 800 11px Arial, sans-serif; }
.cn-tl-content span { display: block; margin-top: 3px; color: var(--muted); font: 9px Arial, sans-serif; }

/* SUMMARY ROWS (right panel) */
.cn-summary-row { display: flex; justify-content: space-between; margin-top: 13px; color: var(--muted); font: 11px Arial, sans-serif; }
.cn-summary-row.discount { color: var(--green); }
.cn-summary-row.total { margin-top: 16px; padding-top: 15px; border-top: 1px solid var(--border); color: var(--deep); font: 800 15px Arial, sans-serif; }

/* ADDRESS */
.cn-address { display: flex; gap: 12px; margin-top: 17px; padding: 14px; border-radius: 12px; background: var(--blush-light); }
.cn-address-icon { width: 36px; height: 36px; display: grid; place-items: center; flex-shrink: 0; border-radius: 10px; background: var(--blush); color: var(--rose); }
.cn-address-icon .icon { width: 17px; height: 17px; }
.cn-address strong { display: block; color: var(--deep); font: 800 11px Arial, sans-serif; }
.cn-address p { margin-top: 4px; color: var(--muted); font: 9px/1.6 Arial, sans-serif; }

/* PAYMENT STATUS */
.cn-payment-status { display: flex; align-items: center; gap: 10px; margin-top: 17px; padding: 13px; border-radius: 11px; background: #f2faf5; color: var(--green); }
.cn-payment-status .icon { width: 19px; height: 19px; }
.cn-payment-status strong { display: block; font: 800 10px Arial, sans-serif; }
.cn-payment-status span { display: block; margin-top: 3px; font: 9px Arial, sans-serif; }

/* HELP CARD */
.cn-help { margin-top: 20px; padding: 19px; border-radius: 20px; background: var(--deep); color: #fff; }
.cn-help h3 { font: 700 19px Georgia, serif; }
.cn-help p { margin-top: 7px; color: #d9c8cf; font: 10px/1.6 Arial, sans-serif; }
.cn-help-btn { display: inline-block; margin-top: 12px; padding: 9px 13px; border-radius: 9px; background: rgba(255,255,255,.12); color: #fff; font: 800 9px Arial, sans-serif; cursor: pointer; border: 0; }
.cn-help-btn:hover { background: rgba(255,255,255,.2); }

/* ACTIONS */
.cn-actions { display: flex; flex-direction: column; gap: 9px; margin-top: 18px; }
.cn-action-btn { display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; padding: 13px; border-radius: 11px; font: 800 11px Arial, sans-serif; transition: background .15s, transform .15s; cursor: pointer; border: 0; }
.cn-action-btn .icon { width: 16px; height: 16px; }
.cn-action-btn.primary { background: var(--deep); color: #fff; }
.cn-action-btn.primary:hover { background: var(--rose-dark); transform: translateY(-1px); }
.cn-action-btn.ghost { background: var(--blush-light); color: var(--deep); border: 1px solid var(--border); }
.cn-action-btn.ghost:hover { background: var(--blush); }

/* TRUST ROW */
.cn-trust { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 14px; }
.cn-trust-item { padding: 10px 6px; border-radius: 10px; background: var(--blush-light); text-align: center; }
.cn-trust-item .icon { width: 17px; height: 17px; margin: auto; color: var(--gold); }
.cn-trust-item span { display: block; margin-top: 6px; color: var(--muted); font: 700 9px Arial, sans-serif; }

/* NOTE */
.cn-note { color: var(--muted); font: 12px/1.7 Arial, sans-serif; background: var(--blush-light); padding: 12px 14px; border-radius: 10px; margin-top: 10px; }

/* RESPONSIVE */
@media (max-width: 850px) { .cn-grid { grid-template-columns: 1fr; } }
@media (max-width: 600px) { .confirmation-exact-page { padding: 16px 0 48px; } .cn-success { padding: 38px 18px 32px; border-radius: 22px; } .cn-success-icon { width: 70px; height: 70px; } .cn-success-icon .icon { width: 31px; height: 31px; } .cn-hero-buttons { flex-direction: column; align-items: center; } .cn-btn { width: 100%; } .cn-grid { gap: 14px; margin-top: 15px; } .cn-card { padding: 17px; border-radius: 17px; } }

/* My orders page — matches the cart page dimensions and type scale. */
.my-orders-page { width: min(1400px, calc(100% - 44px)); margin: 0 auto; padding: 30px 0 75px; }.my-orders-page .breadcrumb { max-width: none; margin: 0 0 20px; padding: 0; font-size: 14px; }.orders-page-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 24px; }.orders-eyebrow { color: var(--rose); font: 800 11px Arial, sans-serif; letter-spacing: 2px; text-transform: uppercase; }.orders-page-header h1 { margin-top: 7px; color: var(--deep); font: 700 clamp(32px, 5vw, 47px) Georgia, serif; }.orders-page-header p { margin-top: 8px; color: var(--muted); font: 12px Arial, sans-serif; }.orders-shop-button { padding: 11px 16px; color: #fff; background: var(--deep); border-radius: 10px; font: 800 12px Arial, sans-serif; white-space: nowrap; }.orders-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; padding: 14px; background: #fff; border: 1px solid var(--border); border-radius: 16px; }.orders-tabs { display: flex; align-items: center; gap: 4px; overflow-x: auto; scrollbar-width: none; }.orders-tabs::-webkit-scrollbar { display: none; }.orders-tab { padding: 8px 13px; color: var(--muted); background: transparent; border-radius: 8px; font: 700 11px Arial, sans-serif; white-space: nowrap; }.orders-tab:hover { color: var(--rose); background: var(--blush-light); }.orders-tab.active { color: var(--deep); background: var(--blush); }.orders-search { width: 230px; height: 36px; display: flex; align-items: center; gap: 6px; flex: 0 0 230px; padding: 0 10px; background: #fffafb; border: 1px solid var(--border); border-radius: 9px; }.orders-search .icon { width: 15px; height: 15px; color: var(--muted); }.orders-search input { width: 100%; border: 0; outline: 0; background: transparent; color: #2e282c; font: 10px Arial, sans-serif; }.orders-count { margin-bottom: 12px; color: var(--muted); font: 11px Arial, sans-serif; }.order-history-card { margin-bottom: 16px; overflow: hidden; background: #fff; border: 1px solid var(--border); border-radius: 19px; box-shadow: 0 4px 18px rgba(90,48,68,.025); transition: box-shadow .2s ease; }.order-history-card:hover { box-shadow: var(--shadow); }.order-history-header { display: flex; align-items: center; justify-content: space-between; gap: 15px; padding: 16px 19px; background: var(--blush-light); border-bottom: 1px solid var(--border); }.order-meta { display: flex; align-items: center; gap: 25px; }.order-meta div { display: flex; flex-direction: column; gap: 4px; }.order-meta span { color: var(--muted); font: 8px Arial, sans-serif; letter-spacing: .5px; text-transform: uppercase; }.order-meta strong { color: var(--deep); font: 800 10px Arial, sans-serif; }.order-status { display: inline-flex; align-items: center; gap: 6px; padding: 7px 10px; border-radius: 20px; font: 800 9px Arial, sans-serif; white-space: nowrap; }.order-status i { width: 6px; height: 6px; display: block; background: currentColor; border-radius: 50%; }.order-status.delivered { color: var(--green); background: #eef8f1; }.order-status.transit { color: #b87935; background: #fff4e8; }.order-status.processing { color: var(--rose-dark); background: var(--blush); }.order-status.cancelled { color: #b9505c; background: #fbedef; }.order-history-body { padding: 17px 19px; }.order-delivery-row { display: flex; align-items: center; justify-content: space-between; gap: 15px; margin-bottom: 15px; }.order-delivery-info { display: flex; align-items: center; gap: 8px; }.order-delivery-icon { width: 30px; height: 30px; display: grid; place-items: center; color: var(--rose); background: var(--blush); border-radius: 8px; }.order-delivery-icon .icon { width: 15px; height: 15px; }.order-delivery-info strong, .order-delivery-info span { display: block; }.order-delivery-info strong { color: var(--deep); font: 800 10px Arial, sans-serif; }.order-delivery-info span { margin-top: 3px; color: var(--muted); font: 8px Arial, sans-serif; }.order-total-text { color: var(--deep); font: 800 11px Arial, sans-serif; text-align: right; }.order-total-text span { display: block; margin-top: 3px; color: var(--muted); font: 8px Arial, sans-serif; font-weight: 400; }.order-products { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; padding: 14px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }.order-product { display: flex; align-items: center; gap: 10px; min-width: 0; }.order-product-image { width: 58px; height: 58px; display: grid; place-items: center; flex-shrink: 0; overflow: hidden; color: var(--gold); background: linear-gradient(145deg, #fff2f5, #f4ddd7); border-radius: 11px; }.order-product-image img { width: 100%; height: 100%; object-fit: cover; }.order-product-image .icon { width: 27px; height: 27px; }.order-product-info { min-width: 0; }.order-product-info strong { display: block; overflow: hidden; color: var(--deep); font: 800 10px/1.4 Arial, sans-serif; text-overflow: ellipsis; white-space: nowrap; }.order-product-info span { display: block; margin-top: 3px; color: var(--muted); font: 8px Arial, sans-serif; }.order-history-footer { display: flex; align-items: center; justify-content: space-between; gap: 15px; padding-top: 14px; }.order-history-footer p { color: var(--muted); font: 9px/1.5 Arial, sans-serif; }.order-actions { display: flex; align-items: center; gap: 7px; }.order-action { padding: 9px 12px; border-radius: 8px; font: 800 9px Arial, sans-serif; }.order-action.primary { color: #fff; background: var(--deep); }.order-action.secondary { color: var(--deep); background: var(--blush-light); }.order-action.danger { color: #b9505c; background: #fff0f2; }.order-action:hover { filter: brightness(.97); }.order-rating { display: flex; align-items: center; gap: 8px; margin-top: 12px; padding: 10px; background: #fffafb; border-radius: 9px; }.order-rating > span { color: var(--muted); font: 8px Arial, sans-serif; }.order-rating button { padding: 0 1px; color: #d4c5a9; background: transparent; font-size: 15px; line-height: 1; }.order-rating button.selected { color: var(--gold); }.orders-empty { display: none; padding: 65px 25px; text-align: center; background: #fff; border: 1px solid var(--border); border-radius: 20px; }.orders-empty:has(+ .orders-help), .orders-empty { display: block; }.orders-empty > div { width: 70px; height: 70px; display: grid; place-items: center; margin: 0 auto 18px; color: var(--rose); background: var(--blush); border-radius: 50%; }.orders-empty .icon { width: 30px; height: 30px; }.orders-empty h2 { color: var(--deep); font: 700 26px Georgia, serif; }.orders-empty p { max-width: 400px; margin: 8px auto 18px; color: var(--muted); font: 10px/1.6 Arial, sans-serif; }.orders-empty-button { display: inline-block; padding: 11px 17px; color: #fff; background: var(--deep); border-radius: 10px; font: 800 10px Arial, sans-serif; }.orders-help { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: 20px; padding: 20px; color: #fff; background: var(--deep); border-radius: 18px; }.orders-help h2 { font: 700 19px Georgia, serif; }.orders-help p { max-width: 500px; margin-top: 6px; color: #d9c8cf; font: 9px/1.6 Arial, sans-serif; }.orders-help a { padding: 10px 15px; color: #fff; background: rgba(255,255,255,.12); border-radius: 9px; font: 800 9px Arial, sans-serif; white-space: nowrap; }
@media (max-width: 800px) { .orders-page-header { align-items: flex-start; flex-direction: column; }.orders-toolbar { align-items: stretch; flex-direction: column; }.orders-search { width: 100%; flex-basis: auto; }.order-history-header { align-items: flex-start; flex-direction: column; gap: 10px; }.order-meta { width: 100%; justify-content: space-between; gap: 8px; }.orders-shop-button { width: 100%; text-align: center; }.orders-help { align-items: flex-start; flex-direction: column; }.orders-help a { width: 100%; text-align: center; } }
@media (max-width: 600px) { .my-orders-page { padding: 22px 0 100px; }.orders-page-header h1 { font-size: 34px; }.orders-tabs { width: 100%; }.order-history-body { padding: 15px; }.order-products { grid-template-columns: 1fr; }.order-history-footer { align-items: stretch; flex-direction: column; }.order-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }.order-action { text-align: center; }.order-rating { justify-content: space-between; }.orders-empty { padding: 55px 18px; } }

/* My account page — cart-aligned dashboard and responsive modal system. */
.my-account-page { width: min(1400px, calc(100% - 44px)); margin: 0 auto; padding: 30px 0 75px; }.my-account-page .breadcrumb { max-width: none; margin: 0 0 20px; padding: 0; font-size: 14px; }.account-hero { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 25px; min-height: 130px; margin-bottom: 20px; padding: 27px 30px; overflow: hidden; background: linear-gradient(135deg, #fff1f4, #f8dce4); border: 1px solid var(--border); border-radius: 22px; }.account-hero::after { content: ""; position: absolute; width: 220px; height: 220px; right: -70px; top: -135px; background: rgba(255,255,255,.35); border-radius: 50%; }.account-profile, .account-edit-button { position: relative; z-index: 1; }.account-profile { display: flex; align-items: center; gap: 15px; }.account-avatar { width: 68px; height: 68px; display: grid; place-items: center; flex-shrink: 0; color: var(--rose); background: #fff; border: 3px solid rgba(255,255,255,.85); border-radius: 50%; box-shadow: 0 6px 20px rgba(90,48,68,.08); }.account-avatar .icon { width: 31px; height: 31px; }.account-profile small { display: block; color: var(--rose-dark); font: 800 9px Arial, sans-serif; letter-spacing: 1.5px; text-transform: uppercase; }.account-profile h1 { margin-top: 4px; color: var(--deep); font: 700 27px Georgia, serif; }.account-profile p { margin-top: 4px; color: var(--muted); font: 9px Arial, sans-serif; }.account-edit-button { display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 10px 15px; color: var(--deep); background: #fff; border-radius: 9px; font: 800 9px Arial, sans-serif; }.account-edit-button .icon { width: 13px; height: 13px; }.account-grid { display: grid; grid-template-columns: 245px minmax(0, 1fr); gap: 20px; align-items: start; }.account-sidebar { position: sticky; top: 96px; padding: 9px; background: #fff; border: 1px solid var(--border); border-radius: 18px; }.account-side-item { width: 100%; display: flex; align-items: center; gap: 11px; margin-bottom: 3px; padding: 11px 12px; color: var(--muted); background: transparent; border-radius: 9px; font: 700 10px Arial, sans-serif; text-align: left; }.account-side-item .icon { width: 17px; height: 17px; flex-shrink: 0; }.account-side-item span { margin-left: auto; color: var(--rose); font-size: 9px; }.account-side-item:hover, .account-side-item.active { color: var(--deep); background: var(--blush); }.account-side-item.danger { color: #b9505c; }.account-side-divider { height: 1px; margin: 8px 4px; background: var(--border); }.account-content { min-width: 0; }.account-quick-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; margin-bottom: 20px; }.account-quick-card { padding: 16px; background: #fff; border: 1px solid var(--border); border-radius: 15px; }.account-quick-card:hover { transform: translateY(-2px); box-shadow: var(--shadow); }.account-quick-card > div { width: 35px; height: 35px; display: grid; place-items: center; color: var(--rose); background: var(--blush-light); border-radius: 10px; }.account-quick-card .icon { width: 17px; height: 17px; }.account-quick-card strong, .account-quick-card span { display: block; }.account-quick-card strong { margin-top: 10px; color: var(--deep); font: 700 16px Arial, sans-serif; }.account-quick-card span { margin-top: 3px; color: var(--muted); font: 8px Arial, sans-serif; }.account-card { margin-bottom: 20px; padding: 20px; background: #fff; border: 1px solid var(--border); border-radius: 18px; }.account-card-header { display: flex; align-items: center; justify-content: space-between; gap: 15px; padding-bottom: 14px; border-bottom: 1px solid var(--border); }.account-card-header h2 { color: var(--deep); font: 700 15px Arial, sans-serif; }.account-card-header button, .account-card-header a { color: var(--rose); background: transparent; font: 800 9px Arial, sans-serif; }.account-details-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; padding-top: 16px; }.account-details-grid span, .account-details-grid strong { display: block; }.account-details-grid span { margin-bottom: 5px; color: var(--muted); font: 700 8px Arial, sans-serif; letter-spacing: .5px; text-transform: uppercase; }.account-details-grid strong { color: var(--deep); font: 700 10px/1.5 Arial, sans-serif; overflow-wrap: anywhere; }.account-details-grid strong.light { color: var(--muted); font-weight: 400; }.account-details-grid strong.green { color: var(--green); }.saved-address { display: flex; align-items: flex-start; gap: 12px; margin-top: 16px; padding: 14px; background: var(--blush-light); border-radius: 12px; }.saved-address-icon { width: 38px; height: 38px; display: grid; place-items: center; flex-shrink: 0; color: var(--rose); background: var(--blush); border-radius: 10px; }.saved-address-icon .icon { width: 18px; height: 18px; }.saved-address-info { flex: 1; min-width: 0; }.saved-address-info strong { color: var(--deep); font: 800 10px Arial, sans-serif; }.saved-address-info strong small { margin-left: 7px; padding: 3px 6px; color: var(--green); background: #eef8f1; border-radius: 20px; font: 800 7px Arial, sans-serif; }.saved-address-info p { margin-top: 5px; color: var(--muted); font: 9px/1.6 Arial, sans-serif; }.saved-address-actions { display: flex; gap: 5px; flex-shrink: 0; }.saved-address-actions button { padding: 8px 10px; color: var(--deep); background: #fff; border-radius: 8px; font: 800 8px Arial, sans-serif; }.saved-address-actions button.danger { color: #b9505c; }.account-order-row { display: flex; align-items: center; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--border); }.account-order-row:last-child { border-bottom: 0; }.account-order-image { width: 52px; height: 52px; display: grid; place-items: center; flex-shrink: 0; color: var(--gold); background: linear-gradient(145deg, #fff2f5, #f4ddd7); border-radius: 10px; }.account-order-image .icon { width: 25px; height: 25px; }.account-order-info { flex: 1; min-width: 0; }.account-order-info strong, .account-order-info span { display: block; }.account-order-info strong { overflow: hidden; color: var(--deep); font: 800 10px Arial, sans-serif; text-overflow: ellipsis; white-space: nowrap; }.account-order-info span { margin-top: 4px; color: var(--muted); font: 8px Arial, sans-serif; }.account-order-status { padding: 6px 9px; color: var(--green); background: #eef8f1; border-radius: 20px; font: 800 8px Arial, sans-serif; white-space: nowrap; }.account-order-status.processing { color: #9a7134; background: #fff6e8; }.account-order-price { color: var(--deep); font: 800 10px Arial, sans-serif; white-space: nowrap; }.account-security-row, .account-preference { display: flex; align-items: center; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--border); }.account-security-row:last-child, .account-preference:last-child { border-bottom: 0; }.account-security-row > div { width: 36px; height: 36px; display: grid; place-items: center; flex-shrink: 0; color: var(--rose); background: var(--blush-light); border-radius: 9px; }.account-security-row > div .icon { width: 17px; height: 17px; }.account-security-row p, .account-preference p { flex: 1; }.account-security-row strong, .account-security-row span, .account-preference strong, .account-preference span { display: block; }.account-security-row strong, .account-preference strong { color: var(--deep); font: 800 10px Arial, sans-serif; }.account-security-row span, .account-preference span { margin-top: 3px; color: var(--muted); font: 8px Arial, sans-serif; }.account-security-row > button { padding: 8px 10px; color: var(--deep); background: var(--blush-light); border-radius: 8px; font: 800 8px Arial, sans-serif; }.account-security-row em { color: var(--green); font: 800 8px Arial, sans-serif; }.account-toggle { position: relative; width: 40px; height: 22px; flex-shrink: 0; background: #ded3d7; border-radius: 30px; }.account-toggle::after { content: ""; position: absolute; top: 3px; left: 3px; width: 16px; height: 16px; background: #fff; border-radius: 50%; box-shadow: 0 1px 3px rgba(0,0,0,.15); transition: .2s; }.account-toggle.active { background: var(--rose); }.account-toggle.active::after { left: 21px; }.account-support { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 20px; padding: 20px; color: #fff; background: var(--deep); border-radius: 18px; }.account-support h2 { font: 700 19px Georgia, serif; }.account-support p { max-width: 450px; margin-top: 6px; color: #d9c8cf; font: 9px/1.6 Arial, sans-serif; }.account-support a { padding: 10px 15px; color: #fff; background: rgba(255,255,255,.12); border-radius: 9px; font: 800 9px Arial, sans-serif; white-space: nowrap; }.account-danger { margin-top: 16px; padding: 16px; background: #fff7f8; border: 1px solid #f2d8dd; border-radius: 13px; }.account-danger h3 { color: #b9505c; font: 700 12px Arial, sans-serif; }.account-danger p { margin-top: 5px; color: var(--muted); font: 8px/1.6 Arial, sans-serif; }.account-danger button { display: inline-flex; align-items: center; gap: 4px; margin-top: 11px; padding: 9px 12px; color: #b9505c; background: #fff0f2; border-radius: 8px; font: 800 8px Arial, sans-serif; }.account-danger button .icon { width: 12px; height: 12px; }.account-modal-overlay { position: fixed; inset: 0; z-index: 10000; display: grid; place-items: center; padding: 20px; background: rgba(61,40,49,.48); backdrop-filter: blur(6px); }.account-modal { width: min(520px, 100%); max-height: 90vh; overflow-y: auto; padding: 24px; background: #fff; border-radius: 20px; box-shadow: 0 25px 80px rgba(50,20,35,.22); }.account-modal-header { display: flex; align-items: center; justify-content: space-between; gap: 15px; padding-bottom: 16px; border-bottom: 1px solid var(--border); }.account-modal-header h2 { color: var(--deep); font: 700 21px Georgia, serif; }.account-modal-header > button { width: 32px; height: 32px; color: var(--deep); background: var(--blush-light); border-radius: 9px; font-size: 19px; }.account-form { display: grid; gap: 13px; margin-top: 18px; }.account-form label { color: var(--deep); font: 800 9px Arial, sans-serif; }.account-form input, .account-form select, .account-delete-modal input { width: 100%; margin-top: 6px; padding: 11px 12px; color: #2e282c; background: #fffafb; border: 1px solid var(--border); border-radius: 9px; outline: 0; font: 10px Arial, sans-serif; }.account-modal-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 6px; padding-top: 16px; border-top: 1px solid var(--border); }.account-modal-actions button, .account-modal-primary { padding: 10px 15px; color: var(--deep); background: var(--blush-light); border-radius: 9px; font: 800 9px Arial, sans-serif; }.account-modal-actions button[type="submit"], .account-modal-primary { color: #fff; background: var(--deep); }.account-modal-settings > div { display: flex; align-items: center; justify-content: space-between; padding: 14px 0; border-bottom: 1px solid var(--border); color: var(--deep); font: 800 10px Arial, sans-serif; }.account-modal-settings { margin-top: 4px; }.account-modal-primary { width: 100%; margin-top: 16px; }.account-delete-modal { margin-top: 18px; }.account-delete-modal p { color: var(--muted); font: 10px/1.6 Arial, sans-serif; }.account-delete-modal .account-modal-actions button.danger { color: #fff; background: #b9505c; }
@media (max-width: 950px) { .account-grid { grid-template-columns: 1fr; }.account-sidebar { position: static; display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; }.account-side-item { justify-content: center; flex-direction: column; gap: 5px; margin: 0; padding: 9px 5px; text-align: center; }.account-side-item span { margin: 0; }.account-side-divider, .account-side-item.danger { display: none; } }
@media (max-width: 750px) { .account-quick-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 600px) { .my-account-page { padding: 22px 0 100px; }.account-hero { align-items: flex-start; flex-direction: column; padding: 22px 18px; }.account-profile h1 { font-size: 23px; }.account-edit-button { width: 100%; }.account-sidebar { grid-template-columns: repeat(2, 1fr); }.account-details-grid { grid-template-columns: 1fr; }.account-card { padding: 16px; }.saved-address { flex-wrap: wrap; }.saved-address-actions { width: 100%; }.saved-address-actions button { flex: 1; text-align: center; }.account-order-row { flex-wrap: wrap; }.account-order-info { min-width: calc(100% - 65px); }.account-order-status { margin-left: 64px; }.account-support { align-items: flex-start; flex-direction: column; }.account-support a { width: 100%; text-align: center; }.account-modal { padding: 18px; border-radius: 18px; }.account-modal-actions { display: grid; grid-template-columns: repeat(2, 1fr); }.account-modal-actions button { text-align: center; } }

/* Login page — auth shell using the storefront's global tokens. */
.login-page { min-height: 100vh; color: #292329; background: radial-gradient(circle at 8% 10%, #fce8ed 0, transparent 30%), radial-gradient(circle at 92% 90%, #f7e3e8 0, transparent 30%), #fffafb; }.login-topbar { min-height: 32px; display: flex; align-items: center; justify-content: center; padding: 8px 15px; color: #fff; background: var(--deep); text-align: center; font: 10px Arial, sans-serif; letter-spacing: .2px; }.login-navbar { min-height: 70px; display: flex; align-items: center; justify-content: space-between; padding: 12px clamp(18px, 5vw, 70px); background: rgba(255,255,255,.95); border-bottom: 1px solid var(--border); }.login-logo { color: var(--deep); font: 700 27px Georgia, serif; white-space: nowrap; }.login-logo span { color: var(--rose); }.login-back { display: flex; align-items: center; gap: 6px; color: var(--muted); font: 700 9px Arial, sans-serif; }.login-back:hover { color: var(--rose); }.login-back .icon { width: 13px; height: 13px; }.login-main { min-height: calc(100vh - 102px); display: flex; align-items: center; justify-content: center; padding: 45px 20px 65px; }.login-wrapper { width: 100%; max-width: 900px; display: grid; grid-template-columns: .82fr 1.18fr; overflow: hidden; background: #fff; border: 1px solid var(--border); border-radius: 25px; box-shadow: 0 20px 60px rgba(90,48,68,.1); }.login-brand-panel { position: relative; display: flex; align-items: center; overflow: hidden; padding: 45px 38px; color: var(--deep); background: linear-gradient(145deg, #f8dce4, #f3ccd7); }.login-brand-panel::before, .login-brand-panel::after { content: ""; position: absolute; border-radius: 50%; background: rgba(255,255,255,.3); }.login-brand-panel::before { width: 240px; height: 240px; top: -100px; right: -100px; }.login-brand-panel::after { width: 180px; height: 180px; bottom: -80px; left: -80px; }.login-brand-content { position: relative; z-index: 1; }.login-brand-symbol { width: 68px; height: 68px; display: grid; place-items: center; margin-bottom: 21px; color: var(--rose); background: rgba(255,255,255,.7); border-radius: 20px; box-shadow: 0 10px 30px rgba(125,61,84,.08); }.login-brand-symbol .icon { width: 34px; height: 34px; }.login-brand-panel h1 { max-width: 300px; color: var(--deep); font: 700 32px/1.16 Georgia, serif; }.login-brand-panel h1 span { color: var(--rose); }.login-brand-content > p { max-width: 320px; margin-top: 12px; color: #765564; font: 10px/1.7 Arial, sans-serif; }.login-benefits { display: flex; flex-direction: column; gap: 12px; margin-top: 27px; }.login-benefits > div { display: flex; align-items: center; gap: 10px; color: #765564; font: 700 8px Arial, sans-serif; }.login-benefits span { width: 31px; height: 31px; display: grid; place-items: center; flex-shrink: 0; background: rgba(255,255,255,.68); border-radius: 9px; }.login-benefits .icon { width: 14px; height: 14px; color: var(--rose); }.login-form-panel { padding: 42px clamp(25px, 4vw, 55px); background: #fff; }.login-form-header { margin-bottom: 23px; }.login-form-header h2 { color: var(--deep); font: 700 27px Georgia, serif; }.login-form-header p { margin-top: 6px; color: var(--muted); font: 9px Arial, sans-serif; }.login-field { margin-bottom: 14px; }.login-field label { display: block; margin-bottom: 6px; color: var(--deep); font: 900 8px Arial, sans-serif; }.login-input-wrapper { position: relative; }.login-input-wrapper > .icon { position: absolute; top: 50%; left: 12px; width: 15px; height: 15px; color: #a98791; transform: translateY(-50%); pointer-events: none; }.login-input-wrapper input { width: 100%; height: 45px; padding: 0 42px 0 37px; color: #292329; background: #fffafb; border: 1px solid var(--border); border-radius: 10px; outline: 0; font: 9px Arial, sans-serif; }.login-input-wrapper input:focus { background: #fff; border-color: var(--rose); box-shadow: 0 0 0 3px rgba(184,92,120,.08); }.login-input-wrapper input::placeholder { color: #b4a7ad; }.login-input-wrapper > button { position: absolute; top: 50%; right: 7px; width: 30px; height: 30px; display: grid; place-items: center; color: #9b8b92; background: transparent; border-radius: 7px; transform: translateY(-50%); }.login-input-wrapper > button:hover { color: var(--rose); background: var(--blush-light); }.login-input-wrapper > button .icon { width: 14px; height: 14px; }.login-field small { display: none; margin-top: 5px; color: #b9505c; font: 700 7px Arial, sans-serif; }.login-field.invalid .login-input-wrapper input { border-color: #b9505c; }.login-field.invalid small { display: block; }.login-options { display: flex; align-items: center; justify-content: space-between; gap: 15px; margin: 2px 0 17px; }.login-options label { display: flex; align-items: center; gap: 7px; color: var(--muted); font: 7.5px Arial, sans-serif; cursor: pointer; }.login-options input { width: 14px; height: 14px; accent-color: var(--rose); }.login-options a { color: var(--rose); font: 800 7.5px Arial, sans-serif; }.login-options a:hover, .login-signup a:hover { text-decoration: underline; }.login-submit { width: 100%; height: 46px; display: flex; align-items: center; justify-content: center; gap: 8px; color: #fff; background: linear-gradient(135deg, var(--deep), #633848); border-radius: 10px; box-shadow: 0 9px 22px rgba(77,41,56,.15); font: 900 9px Arial, sans-serif; }.login-submit:disabled { opacity: .65; cursor: not-allowed; }.login-submit .icon { width: 15px; height: 15px; }.login-spinner { width: 15px; height: 15px; border: 2px solid rgba(255,255,255,.35); border-top-color: #fff; border-radius: 50%; animation: login-spin .7s linear infinite; }.login-divider { display: flex; align-items: center; gap: 10px; margin: 20px 0; }.login-divider::before, .login-divider::after { content: ""; height: 1px; flex: 1; background: var(--border); }.login-divider span { color: #a4969d; font: 700 7px Arial, sans-serif; }.login-google { width: 100%; height: 43px; display: flex; align-items: center; justify-content: center; gap: 9px; color: var(--deep); background: #fff; border: 1px solid var(--border); border-radius: 10px; font: 800 8px Arial, sans-serif; }.login-google:hover { background: var(--blush-light); border-color: #efc3d0; }.login-google strong { color: #4285f4; font: 900 15px Arial, sans-serif; }.login-signup { margin-top: 19px; color: var(--muted); font: 8px Arial, sans-serif; text-align: center; }.login-signup a { color: var(--rose); font-weight: 900; }.login-security { display: flex; align-items: center; justify-content: center; gap: 6px; margin-top: 18px; color: #95858c; font: 7px Arial, sans-serif; text-align: center; }.login-security .icon { width: 12px; height: 12px; color: var(--green); }.login-footer { padding: 25px 20px; color: #cbbac1; background: #3d2831; font: 7px Arial, sans-serif; text-align: center; }.login-footer a { color: #e8a8ba; }
@keyframes login-spin { to { transform: rotate(360deg); } }
@media (max-width: 800px) { .login-wrapper { grid-template-columns: 1fr; max-width: 520px; }.login-brand-panel { padding: 30px; }.login-brand-panel h1 { max-width: none; font-size: 27px; }.login-brand-content > p { max-width: 500px; }.login-benefits { display: grid; grid-template-columns: repeat(2, 1fr); gap: 9px; } }
@media (max-width: 580px) { .login-topbar { font-size: 8px; }.login-navbar { min-height: 62px; padding: 10px 15px; }.login-logo { font-size: 23px; }.login-main { align-items: flex-start; padding: 25px 12px 45px; }.login-wrapper { border-radius: 19px; }.login-brand-panel { padding: 27px 22px; }.login-brand-symbol { width: 56px; height: 56px; margin-bottom: 15px; border-radius: 16px; }.login-brand-symbol .icon { width: 28px; height: 28px; }.login-brand-panel h1 { font-size: 25px; }.login-brand-content > p { font-size: 9px; }.login-benefits { display: flex; flex-direction: row; flex-wrap: wrap; margin-top: 20px; }.login-benefits > div { flex: 1 1 45%; }.login-form-panel { padding: 28px 20px; }.login-form-header h2 { font-size: 23px; } }
@media (max-width: 380px) { .login-form-panel { padding: 25px 16px; }.login-brand-panel { padding: 24px 18px; }.login-benefits > div { flex-basis: 100%; }.login-options { align-items: flex-start; flex-direction: column; gap: 9px; } }

/* Signup page — shares the login shell and cart type scale. */
.signup-page { min-height: 100vh; color: #292329; background: radial-gradient(circle at 10% 10%, #fce8ed 0, transparent 30%), radial-gradient(circle at 90% 90%, #f7e3e8 0, transparent 28%), #fffafb; }.signup-main { min-height: calc(100vh - 150px); display: flex; align-items: center; justify-content: center; padding: 45px 20px 65px; }.signup-wrapper { width: 100%; max-width: 940px; display: grid; grid-template-columns: .82fr 1.18fr; overflow: hidden; background: #fff; border: 1px solid var(--border); border-radius: 25px; box-shadow: 0 20px 60px rgba(90,48,68,.1); }.signup-brand-panel { position: relative; display: flex; align-items: center; overflow: hidden; padding: 45px 38px; color: var(--deep); background: linear-gradient(145deg, #f8dce4, #f3ccd7); }.signup-brand-panel::before, .signup-brand-panel::after { content: ""; position: absolute; border-radius: 50%; background: rgba(255,255,255,.3); }.signup-brand-panel::before { width: 230px; height: 230px; top: -90px; right: -90px; }.signup-brand-panel::after { width: 180px; height: 180px; bottom: -80px; left: -80px; }.signup-brand-content { position: relative; z-index: 1; }.signup-brand-symbol { width: 66px; height: 66px; display: grid; place-items: center; margin-bottom: 20px; color: var(--rose); background: rgba(255,255,255,.68); border-radius: 20px; box-shadow: 0 10px 30px rgba(125,61,84,.08); }.signup-brand-symbol .icon { width: 33px; height: 33px; }.signup-brand-panel h1 { max-width: 300px; color: var(--deep); font: 700 32px/1.15 Georgia, serif; }.signup-brand-panel h1 span { color: var(--rose); }.signup-brand-content > p { max-width: 320px; margin-top: 12px; color: #765564; font: 10px/1.7 Arial, sans-serif; }.signup-benefits { display: flex; flex-direction: column; gap: 12px; margin-top: 28px; }.signup-benefits > div { display: flex; align-items: center; gap: 10px; color: #765564; font: 700 8px Arial, sans-serif; }.signup-benefits > div > span { width: 30px; height: 30px; display: grid; place-items: center; flex-shrink: 0; background: rgba(255,255,255,.68); border-radius: 9px; }.signup-benefits .icon { width: 14px; height: 14px; color: var(--rose); }.signup-form-panel { padding: 38px clamp(25px,4vw,52px); background: #fff; }.signup-form-header { margin-bottom: 23px; }.signup-form-header h2 { color: var(--deep); font: 700 26px Georgia, serif; }.signup-form-header p { margin-top: 5px; color: var(--muted); font: 9px Arial, sans-serif; }.signup-field-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 11px; }.signup-field { margin-bottom: 13px; }.signup-field label { display: block; margin-bottom: 6px; color: var(--deep); font: 900 8px Arial, sans-serif; letter-spacing: .15px; }.signup-input-wrapper { position: relative; }.signup-input-wrapper > .icon { position: absolute; top: 50%; left: 12px; width: 15px; height: 15px; color: #a98791; transform: translateY(-50%); pointer-events: none; }.signup-input-wrapper input, .signup-input-wrapper select { width: 100%; height: 43px; padding: 0 40px 0 36px; color: #292329; background: #fffafb; border: 1px solid var(--border); border-radius: 10px; outline: 0; font: 9px Arial, sans-serif; }.signup-input-wrapper input:focus { background: #fff; border-color: var(--rose); box-shadow: 0 0 0 3px rgba(184,92,120,.08); }.signup-input-wrapper input::placeholder { color: #b4a7ad; }.signup-input-wrapper > button { position: absolute; top: 50%; right: 7px; width: 29px; height: 29px; display: grid; place-items: center; color: #9b8b92; background: transparent; border-radius: 7px; transform: translateY(-50%); }.signup-input-wrapper > button:hover { color: var(--rose); background: var(--blush-light); }.signup-input-wrapper > button .icon { width: 14px; height: 14px; }.signup-field small.signup-error, .signup-field > .signup-input-wrapper > small { display: none; margin-top: 5px; color: #b9505c; font: 700 7px Arial, sans-serif; }.signup-field.invalid .signup-input-wrapper input { border-color: #b9505c; }.signup-field.invalid .signup-error, .signup-field.invalid .signup-input-wrapper > small { display: block; }.signup-strength { margin-top: 7px; }.signup-strength > div { display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; }.signup-strength span { height: 3px; background: #eadfe3; border-radius: 5px; }.signup-strength span.level-1 { background: #b9505c; }.signup-strength span.level-2 { background: #c99a52; }.signup-strength span.level-3 { background: #6e9a67; }.signup-strength span.level-4 { background: var(--green); }.signup-strength small { display: block; margin-top: 5px; color: var(--muted); font: 7px Arial, sans-serif; }.signup-terms { display: flex; align-items: flex-start; gap: 8px; margin: 4px 0 16px; }.signup-terms input { width: 14px; height: 14px; margin-top: 1px; accent-color: var(--rose); }.signup-terms label { color: var(--muted); font: 7.5px/1.55 Arial, sans-serif; }.signup-terms a { color: var(--rose); font-weight: 800; }.signup-terms.invalid label { color: #b9505c; }.signup-submit { width: 100%; height: 46px; display: flex; align-items: center; justify-content: center; gap: 8px; color: #fff; background: linear-gradient(135deg, var(--deep), #633848); border-radius: 10px; box-shadow: 0 9px 22px rgba(77,41,56,.15); font: 900 9px Arial, sans-serif; }.signup-submit:disabled { opacity: .6; cursor: not-allowed; }.signup-submit .icon { width: 15px; height: 15px; }.signup-spinner { width: 14px; height: 14px; border: 2px solid rgba(255,255,255,.35); border-top-color: #fff; border-radius: 50%; animation: signup-spin .7s linear infinite; }.signup-divider { display: flex; align-items: center; gap: 10px; margin: 19px 0; }.signup-divider::before, .signup-divider::after { content: ""; height: 1px; flex: 1; background: var(--border); }.signup-divider span { color: #a4969d; font: 700 7px Arial, sans-serif; }.signup-google { width: 100%; height: 43px; display: flex; align-items: center; justify-content: center; gap: 9px; color: var(--deep); background: #fff; border: 1px solid var(--border); border-radius: 10px; font: 800 8px Arial, sans-serif; }.signup-google:hover { background: var(--blush-light); border-color: var(--blush); }.signup-google strong { color: #4285f4; font: 900 15px Arial, sans-serif; }.signup-login { margin-top: 18px; color: var(--muted); font: 8px Arial, sans-serif; text-align: center; }.signup-login a { color: var(--rose); font-weight: 900; }.signup-login a:hover { text-decoration: underline; }.signup-security { display: flex; align-items: center; justify-content: center; gap: 6px; margin-top: 17px; color: #95858c; font: 7px Arial, sans-serif; text-align: center; }.signup-security .icon { width: 12px; height: 12px; color: var(--green); }
@keyframes signup-spin { to { transform: rotate(360deg); } }
@media (max-width: 800px) { .signup-main { align-items: flex-start; }.signup-wrapper { grid-template-columns: 1fr; max-width: 540px; }.signup-brand-panel { padding: 30px; }.signup-brand-panel h1 { max-width: none; font-size: 27px; }.signup-brand-content > p { max-width: 500px; }.signup-benefits { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }.signup-benefits > div { align-items: flex-start; } }
@media (max-width: 580px) { .signup-main { padding: 25px 12px 45px; }.signup-wrapper { border-radius: 19px; }.signup-brand-panel { padding: 27px 23px; }.signup-brand-symbol { width: 55px; height: 55px; margin-bottom: 15px; border-radius: 16px; }.signup-brand-symbol .icon { width: 28px; height: 28px; }.signup-brand-panel h1 { font-size: 25px; }.signup-brand-content > p { font-size: 9px; }.signup-benefits { display: flex; flex-direction: row; flex-wrap: wrap; margin-top: 20px; }.signup-benefits > div { flex: 1 1 45%; }.signup-form-panel { padding: 28px 20px; }.signup-form-header h2 { font-size: 23px; }.signup-field-row { grid-template-columns: 1fr; gap: 0; } }
@media (max-width: 380px) { .signup-form-panel { padding: 25px 16px; }.signup-brand-panel { padding: 24px 18px; }.signup-benefits > div { flex-basis: 100%; } }

/* OTP verification page — compact card aligned to cart/auth sizing. */
.otp-page { min-height: 100vh; color: #292329; background: radial-gradient(circle at 8% 10%, #fce8ed 0, transparent 30%), radial-gradient(circle at 92% 90%, #f7e3e8 0, transparent 30%), #fffafb; }.otp-main { min-height: calc(100vh - 150px); display: flex; align-items: center; justify-content: center; padding: 45px 18px 65px; }.otp-card { width: 100%; max-width: 470px; padding: 42px clamp(25px, 5vw, 55px); text-align: center; background: #fff; border: 1px solid var(--border); border-radius: 25px; box-shadow: 0 20px 60px rgba(90,48,68,.1); }.otp-icon { width: 70px; height: 70px; display: grid; place-items: center; margin: 0 auto 20px; color: var(--rose); background: linear-gradient(145deg, var(--blush), #fdf0f3); border-radius: 22px; box-shadow: 0 10px 30px rgba(184,92,120,.1); }.otp-icon .icon { width: 32px; height: 32px; }.otp-card h1 { color: var(--deep); font: 700 28px Georgia, serif; }.otp-subtitle { max-width: 330px; margin: 8px auto 0; color: var(--muted); font: 9px/1.7 Arial, sans-serif; }.otp-contact { display: inline-flex; align-items: center; gap: 6px; margin-top: 14px; padding: 8px 12px; color: var(--rose-dark); background: var(--blush-light); border-radius: 8px; font: 800 8px Arial, sans-serif; }.otp-contact .icon { width: 13px; height: 13px; }.otp-change-contact { display: inline-block; margin-top: 8px; color: var(--rose); font: 800 7.5px Arial, sans-serif; }.otp-change-contact:hover { text-decoration: underline; }.otp-inputs { display: flex; justify-content: center; gap: 8px; margin: 27px 0 13px; }.otp-input { width: 47px; height: 53px; color: var(--deep); background: #fffafb; border: 1px solid var(--border); border-radius: 11px; outline: 0; text-align: center; font: 900 19px Arial, sans-serif; }.otp-input:focus { background: #fff; border-color: var(--rose); box-shadow: 0 0 0 3px rgba(184,92,120,.08); transform: translateY(-1px); }.otp-input.error { border-color: #b9505c; animation: otp-shake .25s; }.otp-error { min-height: 15px; color: #b9505c; font: 700 7.5px Arial, sans-serif; }.otp-verify { width: 100%; height: 46px; display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 9px; color: #fff; background: linear-gradient(135deg, var(--deep), #633848); border-radius: 10px; box-shadow: 0 9px 22px rgba(77,41,56,.15); font: 900 9px Arial, sans-serif; }.otp-verify:disabled { opacity: .65; cursor: not-allowed; }.otp-verify .icon { width: 14px; height: 14px; }.otp-spinner { width: 15px; height: 15px; border: 2px solid rgba(255,255,255,.35); border-top-color: #fff; border-radius: 50%; animation: otp-spin .7s linear infinite; }.otp-resend { margin-top: 20px; color: var(--muted); font: 8px Arial, sans-serif; }.otp-resend button { margin-left: 4px; color: var(--rose); background: transparent; font: 900 8px Arial, sans-serif; }.otp-resend button:disabled { color: #b8adb2; cursor: not-allowed; }.otp-resend button:hover:not(:disabled) { text-decoration: underline; }.otp-resend span { display: inline-block; min-width: 30px; color: var(--deep); }.otp-security { display: flex; align-items: center; justify-content: center; gap: 6px; margin-top: 23px; padding-top: 17px; color: #95858c; border-top: 1px solid var(--border); font: 7px/1.5 Arial, sans-serif; }.otp-security .icon { width: 13px; height: 13px; flex-shrink: 0; color: var(--green); }.otp-page .footer { padding: 25px 20px; color: #cbbac1; background: #3d2831; font: 7px Arial, sans-serif; text-align: center; }.otp-page .footer a { color: #e8a8ba; }
@keyframes otp-shake { 0%, 100% { transform: translateX(0); } 25% { transform: translateX(-4px); } 75% { transform: translateX(4px); } }
@keyframes otp-spin { to { transform: rotate(360deg); } }
@media (max-width: 520px) { .otp-main { align-items: flex-start; padding: 28px 12px 45px; }.otp-card { padding: 32px 18px; border-radius: 20px; }.otp-card h1 { font-size: 25px; }.otp-inputs { gap: 5px; margin-top: 23px; }.otp-input { width: 43px; height: 50px; font-size: 18px; } }
@media (max-width: 360px) { .otp-card { padding: 28px 12px; }.otp-inputs { gap: 4px; }.otp-input { width: 40px; height: 48px; } }

/* Two-factor authentication page. */
.two-factor-page { min-height: 100vh; background: radial-gradient(circle at 8% 10%, #fce8ed 0, transparent 30%), radial-gradient(circle at 92% 90%, #f7e3e8 0, transparent 30%), #fffafb; }.two-factor-main { min-height: calc(100vh - 150px); display: flex; align-items: center; justify-content: center; padding: 45px 18px 65px; }.two-factor-card { width: 100%; max-width: 500px; padding: 42px clamp(25px, 5vw, 55px); text-align: center; background: #fff; border: 1px solid var(--border); border-radius: 25px; box-shadow: 0 20px 60px rgba(90,48,68,.1); }.two-factor-icon { width: 72px; height: 72px; display: grid; place-items: center; margin: 0 auto 20px; color: var(--rose); background: linear-gradient(145deg, var(--blush), #fdf0f3); border-radius: 22px; }.two-factor-icon .icon { width: 34px; height: 34px; }.two-factor-card h1 { color: var(--deep); font: 700 28px Georgia, serif; }.two-factor-subtitle { max-width: 360px; margin: 8px auto 0; color: var(--muted); font: 9px/1.7 Arial, sans-serif; }.authenticator-box { display: flex; align-items: center; gap: 11px; margin-top: 21px; padding: 12px; text-align: left; background: var(--blush-light); border: 1px solid var(--border); border-radius: 12px; }.authenticator-box > div { width: 36px; height: 36px; display: grid; place-items: center; flex-shrink: 0; color: var(--rose); background: #fff; border-radius: 10px; }.authenticator-box .icon { width: 17px; height: 17px; }.authenticator-box p { min-width: 0; }.authenticator-box strong, .authenticator-box span { display: block; }.authenticator-box strong { color: var(--deep); font: 900 8px Arial, sans-serif; }.authenticator-box span { margin-top: 3px; color: var(--muted); font: 7px/1.5 Arial, sans-serif; }.two-factor-inputs { display: flex; justify-content: center; gap: 8px; margin: 25px 0 12px; }.two-factor-input { width: 47px; height: 53px; color: var(--deep); background: #fffafb; border: 1px solid var(--border); border-radius: 11px; outline: 0; text-align: center; font: 900 19px Arial, sans-serif; }.two-factor-input:focus { border-color: var(--rose); box-shadow: 0 0 0 3px rgba(184,92,120,.08); transform: translateY(-1px); }.two-factor-input.error { border-color: #b9505c; animation: two-factor-shake .25s; }.two-factor-error { min-height: 15px; color: #b9505c; font: 700 7.5px Arial, sans-serif; }.trust-device { display: flex; align-items: flex-start; gap: 8px; margin: 8px 0 17px; color: var(--muted); font: 7.5px/1.5 Arial, sans-serif; text-align: left; }.trust-device input { width: 14px; height: 14px; margin-top: 1px; flex-shrink: 0; accent-color: var(--rose); }.trust-device strong { display: block; color: var(--deep); font-weight: 800; }.two-factor-verify { width: 100%; height: 46px; display: flex; align-items: center; justify-content: center; gap: 8px; color: #fff; background: linear-gradient(135deg, var(--deep), #633848); border-radius: 10px; font: 900 9px Arial, sans-serif; }.two-factor-verify:disabled { opacity: .65; cursor: not-allowed; }.two-factor-verify .icon { width: 14px; height: 14px; }.two-factor-spinner { width: 15px; height: 15px; border: 2px solid rgba(255,255,255,.35); border-top-color: #fff; border-radius: 50%; animation: two-factor-spin .7s linear infinite; }.backup-section { margin-top: 20px; padding-top: 18px; border-top: 1px solid var(--border); }.backup-section > p { color: var(--muted); font: 7.5px Arial, sans-serif; }.backup-section > button { margin-top: 7px; color: var(--rose); background: transparent; font: 900 8px Arial, sans-serif; }.backup-form { margin-top: 14px; text-align: left; }.backup-form label { display: block; margin-bottom: 6px; color: var(--deep); font: 900 8px Arial, sans-serif; }.backup-form input { width: 100%; height: 43px; padding: 0 12px; color: var(--deep); background: #fffafb; border: 1px solid var(--border); border-radius: 10px; outline: 0; font: 9px Arial, sans-serif; }.backup-form > button { width: 100%; height: 42px; margin-top: 8px; color: var(--deep); background: var(--blush); border-radius: 9px; font: 900 8px Arial, sans-serif; }.backup-form > button:disabled { opacity: .65; cursor: not-allowed; }.two-factor-security { display: flex; align-items: center; justify-content: center; gap: 6px; margin-top: 22px; color: #95858c; font: 7px/1.5 Arial, sans-serif; }.two-factor-security .icon { width: 13px; height: 13px; color: var(--green); }.two-factor-page .footer { padding: 25px 20px; color: #cbbac1; background: #3d2831; font: 7px Arial, sans-serif; text-align: center; }.two-factor-page .footer a { color: #e8a8ba; }
@keyframes two-factor-shake { 0%, 100% { transform: translateX(0); } 25% { transform: translateX(-4px); } 75% { transform: translateX(4px); } }
@keyframes two-factor-spin { to { transform: rotate(360deg); } }
@media (max-width: 520px) { .two-factor-main { align-items: flex-start; padding: 28px 12px 45px; }.two-factor-card { padding: 32px 18px; border-radius: 20px; }.two-factor-card h1 { font-size: 25px; }.two-factor-inputs { gap: 5px; margin-top: 22px; }.two-factor-input { width: 43px; height: 50px; font-size: 18px; } }
@media (max-width: 360px) { .two-factor-card { padding: 28px 12px; }.two-factor-inputs { gap: 4px; }.two-factor-input { width: 40px; height: 48px; } }

/* Global support chat widget. */
.support-chat-launcher { position: fixed; right: 24px; bottom: 24px; z-index: 9999; width: 58px; height: 58px; display: grid; place-items: center; color: #fff; background: linear-gradient(145deg, var(--rose), var(--rose-dark)); border-radius: 50%; box-shadow: 0 12px 30px rgba(184,92,120,.32); }.support-chat-launcher:hover { transform: translateY(-3px) scale(1.03); box-shadow: 0 16px 35px rgba(184,92,120,.38); }.support-chat-launcher .icon { width: 25px; height: 25px; }.support-chat-notification { position: absolute; top: -1px; right: -1px; width: 17px; height: 17px; display: grid; place-items: center; color: #fff; background: #e94d67; border: 2px solid #fff; border-radius: 50%; font: 800 8px Arial, sans-serif; }.support-chat-window { position: fixed; right: 24px; bottom: 94px; z-index: 9998; width: 370px; height: 560px; display: flex; flex-direction: column; overflow: hidden; visibility: hidden; opacity: 0; background: #fff; border: 1px solid var(--border); border-radius: 22px; box-shadow: 0 18px 55px rgba(60,35,46,.16); transform: translateY(15px) scale(.96); transform-origin: bottom right; transition: opacity .22s ease, transform .22s ease, visibility .22s ease; }.support-chat-window.open { visibility: visible; opacity: 1; transform: translateY(0) scale(1); }.support-chat-header { height: 72px; display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; padding: 12px 14px; color: #fff; background: linear-gradient(135deg, var(--deep), #623748); }.support-chat-admin { display: flex; align-items: center; gap: 10px; }.support-chat-avatar { position: relative; width: 42px; height: 42px; display: grid; place-items: center; color: var(--deep); background: linear-gradient(145deg, var(--blush), #f2c6d3); border-radius: 13px; font: 800 14px Arial, sans-serif; }.support-chat-avatar span { position: absolute; right: -2px; bottom: -2px; width: 9px; height: 9px; background: #61a276; border: 2px solid var(--deep); border-radius: 50%; }.support-chat-admin strong, .support-chat-admin span { display: block; }.support-chat-admin strong { font: 800 13px Arial, sans-serif; }.support-chat-admin span { display: flex; align-items: center; gap: 5px; margin-top: 3px; color: #eadce1; font: 9px Arial, sans-serif; }.support-chat-admin i { width: 5px; height: 5px; background: #72c18b; border-radius: 50%; }.support-chat-close { width: 35px; height: 35px; display: grid; place-items: center; color: #fff; background: rgba(255,255,255,.08); border-radius: 10px; font-size: 22px; }.support-chat-close:hover { background: rgba(255,255,255,.16); }.support-chat-body { flex: 1; overflow-y: auto; padding: 18px 14px; background: linear-gradient(180deg, #fffafb, #fff7f9); }.support-chat-date { width: max-content; margin: 0 auto 15px; padding: 5px 9px; color: #9b8d93; background: #f7edf0; border-radius: 20px; font: 700 8px Arial, sans-serif; }.support-chat-message { display: flex; margin-bottom: 13px; }.support-chat-message.customer { justify-content: flex-end; }.support-chat-message-content { max-width: 78%; }.support-chat-bubble { padding: 10px 12px; color: #30272c; background: #fff; border: 1px solid var(--border); border-radius: 14px 14px 14px 4px; box-shadow: 0 3px 10px rgba(70,40,50,.04); font: 11px/1.55 Arial, sans-serif; }.support-chat-message.customer .support-chat-bubble { color: #fff; background: var(--deep); border: 0; border-radius: 14px 14px 4px 14px; }.support-chat-time { margin-top: 4px; color: #a69ba0; font: 7px Arial, sans-serif; }.support-chat-message.customer .support-chat-time { text-align: right; }.support-chat-typing { display: flex; gap: 4px; padding: 11px 13px; background: #fff; border: 1px solid var(--border); border-radius: 14px 14px 14px 4px; }.support-chat-typing span { width: 5px; height: 5px; background: var(--rose); border-radius: 50%; animation: support-chat-typing 1.2s infinite; }.support-chat-typing span:nth-child(2) { animation-delay: .15s; }.support-chat-typing span:nth-child(3) { animation-delay: .3s; }.support-chat-footer { flex-shrink: 0; padding: 10px; background: #fff; border-top: 1px solid var(--border); }.support-chat-input-box { min-height: 43px; display: flex; align-items: center; gap: 5px; padding: 5px 6px 5px 12px; background: var(--blush-light); border: 1px solid var(--border); border-radius: 14px; }.support-chat-input { min-width: 0; flex: 1; color: #30272c; background: transparent; border: 0; outline: 0; font: 11px Arial, sans-serif; }.support-chat-input::placeholder { color: #a99da2; }.support-chat-send { width: 34px; height: 34px; display: grid; place-items: center; flex-shrink: 0; color: #fff; background: var(--deep); border-radius: 10px; }.support-chat-send:hover { background: var(--rose-dark); transform: translateY(-1px); }.support-chat-send .icon { width: 15px; height: 15px; }.support-chat-note { margin-top: 6px; color: #aaa0a5; font: 7px Arial, sans-serif; text-align: center; }
@keyframes support-chat-typing { 0%, 60%, 100% { opacity: .3; transform: translateY(0); } 30% { opacity: 1; transform: translateY(-3px); } }
@media (max-width: 600px) { .support-chat-launcher { right: 16px; bottom: 17px; width: 54px; height: 54px; }.support-chat-window { right: 10px; left: 10px; bottom: 80px; width: auto; height: min(620px, calc(100vh - 100px)); border-radius: 20px; } }
@media (max-width: 600px) { .support-chat-launcher { display: none; } }
@media (max-width: 380px) { .support-chat-window { right: 6px; left: 6px; bottom: 72px; height: calc(100vh - 85px); } }

/* Keep the chat surface anchored above its launcher. */
.support-chat-window { top: auto; right: 24px; bottom: 94px; left: auto; width: 370px; height: min(560px, calc(100vh - 120px)); border-radius: 22px; }
.support-chat-input:focus { border: 0 !important; box-shadow: none !important; outline: none !important; }
@media (max-width: 600px) { .support-chat-window { top: 102px; right: 10px; bottom: 80px; left: 10px; height: auto; border-radius: 20px; } }
@media (max-width: 380px) { .support-chat-window { top: 96px; right: 6px; bottom: 72px; left: 6px; height: auto; } }

/* Order tracking page — uses the cart page scale and shared warm tokens. */
.track-order-page { width: min(1400px, calc(100% - 44px)); margin: 0 auto; padding: 28px 0 75px; }
.track-order-page .breadcrumb { max-width: none; margin: 0 0 20px; padding: 0; font-size: 14px; }
.track-page-header { margin-bottom: 24px; }.track-eyebrow { color: var(--rose); font: 800 11px Arial, sans-serif; letter-spacing: 2px; text-transform: uppercase; }.track-page-header h1 { margin-top: 8px; color: var(--deep); font: 700 clamp(32px, 5vw, 48px) Georgia, serif; }.track-page-header p { max-width: 600px; margin-top: 9px; color: var(--muted); font: 13px/1.7 Arial, sans-serif; }
.track-search-card, .tracking-card, .track-card { background: #fff; border: 1px solid var(--border); box-shadow: var(--shadow-soft); }.track-search-card { margin-bottom: 20px; padding: 20px; border-radius: 18px; }.track-search-card label { display: block; margin-bottom: 9px; color: var(--deep); font: 800 12px Arial, sans-serif; }.track-search-row { display: flex; gap: 8px; }.track-search-row input { min-width: 0; flex: 1; height: 46px; padding: 0 14px; color: #2e282c; background: #fffafb; border: 1px solid var(--border); border-radius: 10px; outline: 0; font: 13px Arial, sans-serif; }.track-search-row button { min-width: 120px; padding: 0 17px; color: #fff; background: var(--deep); border-radius: 10px; font: 800 12px Arial, sans-serif; }.track-search-card > p { margin-top: 8px; color: var(--muted); font: 10px Arial, sans-serif; }
.tracking-card { padding: 25px; border-radius: 22px; }.tracking-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; padding-bottom: 20px; border-bottom: 1px solid var(--border); }.order-info small { color: var(--rose); font: 800 10px Arial, sans-serif; letter-spacing: 1px; text-transform: uppercase; }.order-info h2 { margin-top: 5px; color: var(--deep); font: 700 27px Georgia, serif; }.order-info p { margin-top: 5px; color: var(--muted); font: 11px Arial, sans-serif; }.current-status { padding: 9px 13px; color: var(--green); background: #eff9f3; border-radius: 30px; font: 800 11px Arial, sans-serif; white-space: nowrap; }.delivery-estimate { display: flex; align-items: center; justify-content: space-between; gap: 15px; margin-top: 20px; padding: 17px; background: var(--blush-light); border-radius: 14px; }.estimate-left { display: flex; align-items: center; gap: 12px; }.estimate-icon { width: 43px; height: 43px; display: grid; place-items: center; flex-shrink: 0; color: var(--rose); background: var(--blush); border-radius: 12px; }.estimate-icon .icon { width: 21px; height: 21px; }.estimate-left strong, .estimate-left span { display: block; }.estimate-left strong { color: var(--deep); font: 800 12px Arial, sans-serif; }.estimate-left span { margin-top: 4px; color: var(--muted); font: 10px Arial, sans-serif; }.estimate-date { color: var(--rose-dark); font: 800 14px Arial, sans-serif; text-align: right; }
.tracking-timeline { position: relative; display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 32px; padding-bottom: 8px; }.timeline-line, .timeline-progress { position: absolute; left: 9%; top: 20px; height: 3px; z-index: 0; }.timeline-line { right: 9%; background: var(--border); }.timeline-progress { width: 62%; background: var(--rose); z-index: 1; }.track-step { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: center; text-align: center; }.step-circle { width: 42px; height: 42px; display: grid; place-items: center; color: var(--muted); background: #fff; border: 2px solid var(--border); border-radius: 50%; }.step-circle .icon { width: 17px; height: 17px; }.track-step.completed .step-circle { color: #fff; background: var(--rose); border-color: var(--rose); }.track-step.current .step-circle { color: var(--rose); background: var(--blush); border-color: var(--rose); }.step-title { margin-top: 10px; color: var(--deep); font: 800 11px Arial, sans-serif; }.step-date { margin-top: 4px; color: var(--muted); font: 9px/1.5 Arial, sans-serif; }
.track-content-grid { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 20px; margin-top: 20px; align-items: start; }.track-card { padding: 21px; border-radius: 18px; }.track-content-grid > div > .track-card + .track-card, .track-content-grid aside > .track-card + .track-card { margin-top: 20px; }.track-card-title { display: flex; align-items: center; justify-content: space-between; padding-bottom: 15px; border-bottom: 1px solid var(--border); }.track-card-title h3 { color: var(--deep); font: 700 16px Arial, sans-serif; }.track-card-title span { color: var(--muted); font: 10px Arial, sans-serif; }.track-product { display: flex; align-items: center; gap: 12px; padding: 15px 0; border-bottom: 1px solid var(--border); }.track-product:last-child { border-bottom: 0; padding-bottom: 0; }.track-product-image { width: 65px; height: 65px; flex-shrink: 0; overflow: hidden; background: linear-gradient(145deg, #fff2f5, #f4ddd7); border-radius: 12px; }.track-product-image img { width: 100%; height: 100%; object-fit: cover; }.track-product-info { min-width: 0; flex: 1; }.track-product-info strong, .track-product-info span { display: block; }.track-product-info strong { color: var(--deep); font: 800 12px/1.4 Arial, sans-serif; }.track-product-info span { margin-top: 4px; color: var(--muted); font: 10px Arial, sans-serif; }.track-product-price { color: var(--deep); font: 800 12px Arial, sans-serif; white-space: nowrap; }
.activity { margin-top: 20px; }.activity-item { position: relative; display: flex; gap: 12px; min-height: 68px; }.activity-item:not(:last-child)::before { content: ""; position: absolute; left: 10px; top: 21px; width: 1px; height: 55px; background: var(--border); }.activity-dot { position: relative; z-index: 2; width: 21px; height: 21px; display: grid; place-items: center; flex-shrink: 0; color: var(--rose); background: var(--blush); border-radius: 50%; }.activity-dot .icon { width: 11px; height: 11px; }.activity-item.latest .activity-dot { color: #fff; background: var(--rose); }.activity-info { flex: 1; }.activity-info strong, .activity-info span { display: block; }.activity-info strong { color: var(--deep); font: 800 11px Arial, sans-serif; }.activity-info span { margin-top: 3px; color: var(--muted); font: 10px/1.5 Arial, sans-serif; }.activity-time { color: var(--muted); font: 9px Arial, sans-serif; white-space: nowrap; }.track-address { display: flex; gap: 11px; margin-top: 16px; padding: 13px; background: var(--blush-light); border-radius: 11px; }.track-address-icon { width: 36px; height: 36px; display: grid; place-items: center; flex-shrink: 0; color: var(--rose); background: var(--blush); border-radius: 10px; }.track-address-icon .icon { width: 17px; height: 17px; }.track-address strong { color: var(--deep); font: 800 11px Arial, sans-serif; }.track-address p { margin-top: 4px; color: var(--muted); font: 10px/1.6 Arial, sans-serif; }
.track-summary-row { display: flex; justify-content: space-between; gap: 10px; margin-top: 12px; color: var(--muted); font: 11px Arial, sans-serif; }.track-summary-row.total { margin-top: 15px; padding-top: 14px; color: var(--deep); border-top: 1px solid var(--border); font: 800 16px Arial, sans-serif; }.track-payment { display: flex; align-items: center; gap: 10px; margin-top: 16px; padding: 12px; color: var(--green); background: #f2faf5; border-radius: 11px; }.track-payment .icon { width: 18px; height: 18px; }.track-payment strong, .track-payment span { display: block; }.track-payment strong { font: 800 10px Arial, sans-serif; }.track-payment span { margin-top: 3px; font: 9px Arial, sans-serif; }.track-support { margin-top: 20px; padding: 19px; color: #fff; background: var(--deep); border-radius: 18px; }.track-support h3 { font: 700 20px Georgia, serif; }.track-support p { margin-top: 7px; color: #d9c8cf; font: 10px/1.6 Arial, sans-serif; }.track-support-buttons { display: flex; gap: 7px; margin-top: 12px; }.track-support-buttons a { flex: 1; padding: 9px 7px; color: #fff; background: rgba(255,255,255,.1); border-radius: 8px; font: 700 10px Arial, sans-serif; text-align: center; }
@media (max-width: 850px) { .track-content-grid { grid-template-columns: 1fr; } }
@media (max-width: 650px) { .track-order-page { padding: 22px 0 100px; }.track-search-row, .tracking-top, .delivery-estimate { align-items: flex-start; flex-direction: column; }.track-search-row button { width: 100%; min-height: 44px; }.current-status, .estimate-date { align-self: flex-start; text-align: left; }.tracking-card { padding: 17px; border-radius: 18px; }.tracking-timeline { grid-template-columns: 1fr; gap: 17px; padding: 0 0 0 8px; }.timeline-line, .timeline-progress { left: 28px; top: 20px; width: 3px; height: auto; right: auto; }.timeline-line { bottom: 20px; }.timeline-progress { height: 52%; }.track-step { flex-direction: row; gap: 12px; text-align: left; }.step-title { margin-top: 0; }.step-date { margin-top: 3px; }.track-card { padding: 17px; border-radius: 17px; }.activity-time { display: none; }.track-support-buttons { flex-direction: column; }.track-product { align-items: flex-start; }.track-product-price { font-size: 10px; } }

.gateway-page { min-height: 650px; display: flex; align-items: center; justify-content: center; padding: 55px 20px 75px; }
.gateway-container { position: relative; width: min(900px, 100%); text-align: center; }
.gateway-container .blob-one { top: 5px; left: -30px; width: 190px; height: 190px; background: rgba(248,220,228,.55); }
.gateway-container .blob-two { right: -10px; bottom: 15px; width: 150px; height: 150px; background: rgba(239,195,208,.38); }
.gateway-art { position: relative; z-index: 1; width: 165px; height: 165px; display: grid; place-items: center; margin: 0 auto 27px; background: linear-gradient(145deg, #fff2f5, #f5dbe3); border: 1px solid rgba(184,92,120,.12); border-radius: 50%; box-shadow: 0 20px 60px rgba(90,48,68,.11); animation: pp-float 4s ease-in-out infinite; }
.gateway-art::before { content: ""; position: absolute; inset: 12px; border: 1px dashed rgba(184,92,120,.25); border-radius: 50%; }
.gateway { position: relative; width: 92px; height: 70px; display: flex; align-items: center; justify-content: space-between; }
.node { width: 35px; height: 48px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; background: #fff; border: 2px solid var(--deep); border-radius: 8px; box-shadow: 0 8px 20px rgba(77,41,56,.08); }
.node-line { width: 15px; height: 2px; background: var(--border); border-radius: 5px; }.node-dot { width: 6px; height: 6px; background: var(--rose); border-radius: 50%; }
.connection { position: relative; width: 27px; height: 2px; background: var(--gold); }.connection::before, .connection::after { content: ""; position: absolute; top: 50%; width: 6px; height: 6px; background: #fff; border: 1.5px solid var(--gold); border-radius: 50%; transform: translateY(-50%); }.connection::before { left: -3px; }.connection::after { right: -3px; }
.status-pill { position: relative; z-index: 1; width: max-content; display: flex; align-items: center; gap: 7px; margin: 0 auto 14px; padding: 7px 13px; color: var(--muted); background: #fff; border: 1px solid var(--border); border-radius: 30px; box-shadow: 0 5px 18px rgba(90,48,68,.05); font: 800 10px Arial, sans-serif; }.status-dot { width: 7px; height: 7px; background: #c08a3d; border-radius: 50%; box-shadow: 0 0 0 4px rgba(192,138,61,.12); }
.error-code { position: relative; z-index: 1; color: var(--deep); font: 800 clamp(76px, 13vw, 130px)/.9 Georgia, serif; letter-spacing: -5px; }.error-code span { color: var(--rose); }
.gateway-container .content { position: relative; z-index: 1; margin-top: 24px; }.gateway-container .eyebrow { color: var(--rose); font: 800 11px Arial, sans-serif; letter-spacing: 2.5px; text-transform: uppercase; }.gateway-container h1 { margin-top: 8px; color: var(--deep); font: 700 clamp(30px, 4.5vw, 48px) Georgia, serif; }.description { max-width: 580px; margin: 13px auto 0; color: var(--muted); font: 14px/1.8 Arial, sans-serif; }
.info-card { width: min(600px, 100%); display: flex; align-items: center; gap: 13px; margin: 28px auto 0; padding: 17px 18px; text-align: left; background: #fff; border: 1px solid var(--border); border-radius: 17px; box-shadow: 0 10px 30px rgba(90,48,68,.06); }.info-icon { width: 39px; height: 39px; flex-shrink: 0; display: grid; place-items: center; color: var(--rose); background: var(--blush-light); border-radius: 11px; }.info-icon .icon { width: 19px; height: 19px; }.info-text strong, .info-text span { display: block; }.info-text strong { color: var(--deep); font: 700 12px Arial, sans-serif; }.info-text span { margin-top: 4px; color: var(--muted); font: 10px/1.5 Arial, sans-serif; }
.gateway-container .actions { display: flex; justify-content: center; align-items: center; flex-wrap: wrap; gap: 10px; margin-top: 19px; }.gateway-container .primary-btn, .gateway-container .secondary-btn { min-width: 160px; min-height: 45px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 0 18px; border-radius: 12px; font: 800 11px Arial, sans-serif; }.gateway-container .primary-btn { color: #fff; background: var(--deep); box-shadow: 0 8px 20px rgba(77,41,56,.14); }.gateway-container .primary-btn:hover { background: var(--rose-dark); transform: translateY(-2px); }.gateway-container .primary-btn:disabled { cursor: wait; opacity: .75; }.gateway-container .secondary-btn { color: var(--deep); background: #fff; border: 1px solid var(--border); }.gateway-container .secondary-btn:hover { color: var(--deep); background: var(--blush-light); border-color: #efc3d0; transform: translateY(-2px); }.gateway-container .primary-btn .icon, .gateway-container .secondary-btn .icon { width: 16px; height: 16px; }.help { margin-top: 28px; color: #988a91; font: 10px Arial, sans-serif; }.help a { color: var(--rose); font-weight: 800; }.help a:hover { color: var(--rose-dark); }
@media (max-width: 600px) { .gateway-page { min-height: 590px; padding: 40px 15px 55px; }.gateway-art { width: 135px; height: 135px; }.error-code { font-size: 90px; letter-spacing: -4px; }.gateway-container h1 { font-size: 29px; }.description { font-size: 13px; }.info-card { align-items: flex-start; }.gateway-container .actions { flex-direction: column; align-items: center; }.gateway-container .primary-btn, .gateway-container .secondary-btn { width: min(300px, 100%); }.gateway-container .blob-one { left: -45px; width: 110px; height: 110px; }.gateway-container .blob-two { right: -25px; width: 90px; height: 90px; } }

/* Product sort control: keep the closed select consistent with the storefront. */
.products-page .sort-select {
	-webkit-appearance: none;
	appearance: none;
	min-width: 190px;
	padding-right: 34px;
	color: var(--deep);
	background-color: #fff;
	background-image: linear-gradient(45deg, transparent 50%, var(--rose) 50%), linear-gradient(135deg, var(--rose) 50%, transparent 50%);
	background-position: calc(100% - 16px) 16px, calc(100% - 11px) 16px;
	background-repeat: no-repeat;
	background-size: 5px 5px, 5px 5px;
	font: 700 11px Arial, sans-serif;
}
.products-page .sort-select:focus {
	border-color: var(--rose);
	box-shadow: 0 0 0 3px rgba(213, 83, 125, .1);
}
.products-page .sort-select option {
	color: var(--deep);
	background: #fff;
	font: 11px Arial, sans-serif;
}
.sort-menu { position: relative; }
.sort-menu .sort-select { position: relative; display: flex; align-items: center; justify-content: flex-start; width: 190px; padding-right: 34px; text-align: left; cursor: pointer; background-image: none; }
.sort-arrow { position: absolute; top: 50%; right: 13px; width: 7px; height: 7px; border-right: 1.5px solid var(--rose); border-bottom: 1.5px solid var(--rose); transform: translateY(-65%) rotate(45deg); transition: transform .18s ease; }
.sort-menu.open .sort-arrow { transform: translateY(-35%) rotate(225deg); }
.sort-options { position: absolute; top: calc(100% + 5px); right: 0; z-index: 20; width: 190px; padding: 5px; background: #fff; border: 1px solid var(--border); border-radius: 11px; box-shadow: 0 12px 28px rgba(74, 39, 52, .16); }
.sort-option { width: 100%; padding: 9px 10px; color: var(--deep); background: #fff; border-radius: 7px; text-align: left; font: 600 11px Arial, sans-serif; }
.sort-option:hover, .sort-option.active { color: var(--rose-dark); background: #fff0f4; }
@media (max-width: 600px) { .sort-menu, .sort-menu .sort-select, .sort-options { width: 100%; } }

/* Keep quick-view media contained so product details remain below the image. */
.product-quick-modal { width: min(520px, calc(100vw - 36px)); max-height: min(760px, calc(100vh - 36px)); overflow-y: auto; }
.product-quick-modal .modal-buy { width: 100%; min-height: 46px; display: flex; align-items: center; justify-content: center; margin-top: 18px; padding: 12px 18px; color: #fff; background: linear-gradient(135deg, var(--deep), #62394b); border-radius: 12px; box-shadow: 0 8px 20px rgba(74, 39, 52, .14); font: 800 13px Arial, sans-serif; }
.product-quick-modal .modal-buy:hover { background: linear-gradient(135deg, var(--rose-dark), var(--deep)); transform: translateY(-1px); }
.product-quick-modal .modal-icon {
    width: 100%;
    height: 280px; /* Fill full width */
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.product-quick-modal .modal-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain !important;
    object-position: center;
}
/* Keep product-card actions aligned despite the shared full-width cart rule. */
.products-page .card-actions { align-items: stretch; }
.products-page .card-actions .add-cart,
.products-page .card-actions .quick-view { height: 38px; min-height: 38px; margin: 0; padding: 0 10px; display: inline-flex; align-items: center; justify-content: center; }
.products-page .card-actions .add-cart { width: auto; }
.products-page .card-actions .quick-view { width: 40px; padding: 0; }

/* Final large-screen cascade: keep landing and product sections compact. */
@media (min-width: 1400px) {
	.hero, .section, .subscription, .product-page, .cart-page, .products-page, .cart-exact-page, .wishlist-exact-page, .checkout-exact-page, .confirmation-exact-page, .my-orders-page, .my-account-page, .track-order-page, .breadcrumb { width: min(1600px, calc(100% - 56px)); max-width: 1600px; }
	.hero-card { min-height: 360px; }
	.hero-content { padding: 44px 54px; }
	.hero-art { min-height: 360px; }
	.hero-product-photo { height: 300px; }
	.category-grid, .product-grid, .trust-grid { gap: 12px; }
	.product-grid { grid-template-columns: repeat(5, minmax(0, 1fr)); }
	.product-image { height: 205px; }
	.subscription { margin-block: 52px; padding-block: 46px 52px; }
	.offer-banner { padding: 22px 26px; }
	.trust-card { padding: 17px; }
	.product-main { gap: 36px; }
	.main-image { min-height: 430px; }
	.details-section, .reviews-section, .related { margin-top: 40px; padding-top: 25px; }
	.details-grid { gap: 36px; }
	.review-list { gap: 11px; }
	.related-product-grid { gap: 12px; }
	.related-product-grid .product-image { height: 180px; }
	.footer-grid, .copyright { max-width: 1600px; }
	.login-wrapper, .signup-wrapper { max-width: 1080px; }
}

@media (min-width: 3000px) {
	.hero, .section, .subscription, .product-page, .cart-page, .products-page, .cart-exact-page, .wishlist-exact-page, .checkout-exact-page, .confirmation-exact-page, .my-orders-page, .my-account-page, .track-order-page, .breadcrumb { width: min(2200px, calc(100% - 80px)); max-width: 2200px; }
	.hero-card { min-height: 320px; }
	.hero-content { padding: 36px 44px; }
	.hero-art { min-height: 320px; }
	.hero-product-photo { height: 260px; }
	.product-image { height: 180px; }
	.subscription { margin-block: 44px; padding-block: 38px 44px; }
	.product-main { gap: 28px; }
	.main-image { min-height: 360px; }
	.details-section, .reviews-section, .related { margin-top: 32px; padding-top: 20px; }
	.related-product-grid .product-image { height: 155px; }
	.footer-grid, .copyright { max-width: 2200px; }
	.login-wrapper, .signup-wrapper { max-width: 1400px; }
}

/* Reference-style video hero: one rounded media panel with readable overlay copy. */
.hero-fashion-card { position: relative; display: block; min-height: 480px; overflow: hidden; background: transparent; }
.hero-fashion-card .hero-video { position: absolute; inset: 0; width: 100%; height: 100%; display: block; object-fit: cover; }
.hero-fashion-card .hero-overlay { display: none; }
.hero-fashion-card .hero-content { position: absolute; inset: 0 auto 0 0; z-index: 1; width: min(58%, 700px); display: flex; flex-direction: column; align-items: flex-start; justify-content: center; padding: 60px clamp(30px, 5vw, 72px); transform: none; }
.hero-fashion-card .hero-badge { display: inline-flex; align-items: center; gap: 9px; padding: 9px 16px; color: #fff; background: rgba(0, 0, 0, .5); border: 1px solid rgba(255, 255, 255, .25); border-radius: 999px; font: 700 11px Arial, sans-serif; letter-spacing: 1px; }
.hero-fashion-card .hero-badge i { width: 10px; height: 10px; display: block; background: #fff; border-radius: 50%; }
.hero-fashion-card h1 { max-width: 650px; margin: 22px 0 0; color: var(--deep); font-size: clamp(40px, 5vw, 72px); line-height: 1.02; text-shadow: 0 3px 18px rgba(255, 255, 255, .2); }
.hero-fashion-card p { margin: 20px 0 0; color: var(--deep); font: 17px/1.5 Arial, sans-serif; }
.hero-fashion-card .primary-button { margin-top: 25px; padding: 15px 25px; color: #fff; background: var(--deep); border-radius: 999px; box-shadow: 0 10px 26px rgba(74, 39, 52, .28); font: 800 15px Arial, sans-serif; text-transform: capitalize; }
.hero-fashion-card .primary-button:hover { color: #fff; background: var(--rose-dark); }
.hero-fashion-card:hover .hero-video { transform: scale(1.025); transition: transform .55s cubic-bezier(.25,.46,.45,.94); }
@media (max-width: 950px) { .hero-fashion-card { min-height: 470px; }.hero-fashion-card .hero-content { width: 72%; padding: 44px 30px; } }
@media (max-width: 700px) { .hero-fashion-card { min-height: 450px; border-radius: 22px; }.hero-fashion-card .hero-content { width: 100%; padding: 32px 20px; }.hero-fashion-card h1 { font-size: clamp(34px, 10vw, 48px); }.hero-fashion-card p { font-size: 14px; } }

/* Shared primary actions use the root brown token. */
.primary-button, .add-cart, .checkout, .plan-button, .cart-button, .buy-button, .checkout-button, .shop-button, .continue-shopping, .coupon-button, .check-btn, .apply-price, .modal-buy, .place-order, .retry-btn, .cn-btn-primary, .account-modal-primary, .login-submit, .signup-submit, .otp-verify, .two-factor-verify { color: #fff; background: var(--deep) !important; }

.hero-slider { position: absolute; inset: 0; overflow: hidden; background: transparent; }
.hero-slide { position: absolute; inset: 0; width: 100%; height: 100%; display: block; object-fit: cover; opacity: 0; transform: scale(1.02); transition: opacity .9s ease, transform 4s ease; }
.hero-slide.active { opacity: 1; transform: scale(1); }
@media (prefers-reduced-motion: reduce) { .hero-slide { transition: opacity .2s ease; transform: none; } }
